# Production image for the public site's `web` service (taha-web-prod).
# Single-repo build context (unlike Infra/staging/Dockerfile.public, which
# builds from a combined multi-repo checkout) — this repo is built and
# deployed on its own, recreating only the `web` container in the shared
# taha-cms-prod compose stack. cms/admin/db/mailpit are never touched by
# this image or by the workflow that builds it.
FROM node:22-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG PUBLIC_SITE_URL
ARG PUBLIC_API_BASE_URL
ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL PUBLIC_API_BASE_URL=$PUBLIC_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-public.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/
