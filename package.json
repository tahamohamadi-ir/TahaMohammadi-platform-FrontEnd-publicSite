{
  "name": "tahamohammadi-public-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "validate:design": "node scripts/validate-design-authority.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "test:foundation": "playwright test --grep @foundation",
    "test:visual": "playwright test --grep @visual",
    "test:a11y": "playwright test --grep @a11y",
    "test:performance": "playwright test --grep @performance",
    "test:nojs": "playwright test --grep @nojs",
    "test:smoke": "playwright test --config playwright.staging.config.ts --grep @smoke",
    "build:atlas": "set \"DESIGN_ATLAS=1\"&& astro build"
  },
  "dependencies": {
    "astro": "^7.2.9",
    "lucide-astro": "^0.556.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.18",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
}
