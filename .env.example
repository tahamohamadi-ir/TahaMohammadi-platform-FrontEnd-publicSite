# Public browser-safe configuration only.
# Values are examples for local development; never commit secrets.

# Backend API origin for typed client generation and direct reads in dev.
# Production uses same-origin reverse-proxy delivery (see Docs/02-architecture/DEPLOYMENT-TOPOLOGY.md).
PUBLIC_API_BASE_URL=http://127.0.0.1:18000

# Public site origin for canonical URLs and metadata during local dev.
PUBLIC_SITE_URL=http://127.0.0.1:4321

# Dev proxy note (Wave 0):
# When the reverse proxy is wired, browser requests should target the public site origin
# and the proxy will forward /api/* to the backend. Until PUBLIC-120 lands, direct
# PUBLIC_API_BASE_URL may be used for server-side fetches only.
