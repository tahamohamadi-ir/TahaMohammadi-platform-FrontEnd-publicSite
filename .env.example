# Public browser-safe configuration only.
# Values are examples for local development; never commit secrets.

# API origin for typed client reads.
# Leave empty for same-origin delivery: Astro dev proxy forwards /api/* to the backend.
PUBLIC_API_BASE_URL=

# Optional override for the dev proxy upstream (defaults to http://127.0.0.1:8000).
# PUBLIC_API_PROXY_TARGET=http://127.0.0.1:8000

# Public site origin for canonical URLs and metadata during local dev.
PUBLIC_SITE_URL=http://127.0.0.1:4321

# Local-only Design Atlas build gate. WP-20 owns routes and specimens.
# DESIGN_ATLAS=1

# OpenAPI types (PUBLIC-090):
# Regenerate with `npm run generate:api-types` after OPENAPI-ACCEPTANCE.md hash pins match
# the backend snapshot at ../../Back-End/docs/contracts/openapi/current/public-openapi.json.

# Integrated staging smoke (PUBLIC-320) — optional; never commit real staging hosts.
# Leave unset locally; CI and default dev runs skip live smoke honestly.
# PUBLIC_STAGING_SITE_URL=https://staging.example.com
# PUBLIC_STAGING_API_BASE_URL=
