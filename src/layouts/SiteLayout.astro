---
import '../styles/shell.css'
import BaseLayout from './BaseLayout.astro'
import SkipLink from '../components/SkipLink.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { buildLanguageToggleHref, type Locale } from '../lib/navigation'
import { stripLocalePrefix } from '../lib/routes'
import { buildPageSeo, getDir } from '../lib/seo'

interface Props {
  title: string
  locale: Locale
  description?: string
  socialImage?: string
  /** Route tail without locale prefix; derived from pathname when omitted. */
  pathSegment?: string
  /** Whether the alternate locale has a published equivalent record. */
  alternateAvailable?: boolean
  /** Hide footer promo band when the page already shows an equivalent CTA (default: compact footer). */
  hideFooterPromo?: boolean
}

const {
  title,
  locale,
  description,
  socialImage,
  pathSegment,
  alternateAvailable = false,
  hideFooterPromo = true,
} = Astro.props
const currentPath = Astro.url.pathname
const dir = getDir(locale)
const segment = pathSegment ?? stripLocalePrefix(currentPath)
const siteOrigin = Astro.site?.href ?? Astro.url.origin
const { canonical, alternates } = buildPageSeo(
  siteOrigin,
  locale,
  segment,
  alternateAvailable,
)
const alternateHref = buildLanguageToggleHref(
  locale,
  segment,
  alternateAvailable,
)
---

<BaseLayout
  title={title}
  lang={locale}
  dir={dir}
  canonical={canonical}
  alternates={alternates}
  description={description}
  socialImage={socialImage}
>
  <SkipLink locale={locale} />
  <Header
    locale={locale}
    currentPath={currentPath}
    alternateHref={alternateHref}
    alternateAvailable={alternateAvailable}
  />
  <main id="main-content" class="site-main" tabindex="-1" data-pagefind-body>
    <slot />
  </main>
  <Footer locale={locale} hidePromo={hideFooterPromo} />
  <script is:inline define:vars={{ pagePath: currentPath, locale }}>
    if (typeof window !== 'undefined' && typeof navigator !== 'undefined') {
      try {
        const clean = (pagePath.split('#')[0].split('?')[0] || '/').trim()
        const formatted = clean.startsWith('/') ? clean : '/' + clean
        const body = JSON.stringify({
          event: 'page_view',
          pagePath: formatted,
          locale: locale,
        })
        if (typeof navigator.sendBeacon === 'function') {
          navigator.sendBeacon(
            '/api/v1/analytics/events',
            new Blob([body], { type: 'application/json' }),
          )
        } else if (typeof fetch === 'function') {
          fetch('/api/v1/analytics/events', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: body,
            keepalive: true,
          }).catch(() => {
            // Silently swallow network/offline telemetry errors
          })
        }
      } catch {
        // Silently swallow client errors
      }
    }
  </script>
</BaseLayout>
