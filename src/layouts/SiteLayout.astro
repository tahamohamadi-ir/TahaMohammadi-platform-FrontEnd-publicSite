---
import '../styles/shell.css';
import BaseLayout from './BaseLayout.astro';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildLanguageToggleHref, type Locale } from '../lib/navigation';
import { stripLocalePrefix } from '../lib/routes';
import { buildPageSeo, getDir } from '../lib/seo';

interface Props {
  title: string;
  locale: Locale;
  /** Route tail without locale prefix; derived from pathname when omitted. */
  pathSegment?: string;
  /** Whether the alternate locale has a published equivalent record. */
  alternateAvailable?: boolean;
  /** Hide footer promo band when the page already shows an equivalent CTA (e.g. home collab). */
  hideFooterPromo?: boolean;
}

const { title, locale, pathSegment, alternateAvailable = false, hideFooterPromo = false } =
  Astro.props;
const currentPath = Astro.url.pathname;
const dir = getDir(locale);
const segment = pathSegment ?? stripLocalePrefix(currentPath);
const siteOrigin = Astro.site?.href ?? Astro.url.origin;
const { canonical, alternates } = buildPageSeo(siteOrigin, locale, segment, alternateAvailable);
const alternateHref = buildLanguageToggleHref(locale, segment, alternateAvailable);
---

<BaseLayout title={title} lang={locale} dir={dir} canonical={canonical} alternates={alternates}>
  <SkipLink locale={locale} />
  <Header
    locale={locale}
    currentPath={currentPath}
    alternateHref={alternateHref}
    alternateAvailable={alternateAvailable}
  />
  <main id="main-content" class="site-main" tabindex="-1">
    <slot />
  </main>
  <Footer locale={locale} hidePromo={hideFooterPromo} />
</BaseLayout>
