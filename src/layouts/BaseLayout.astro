---
import '../styles/global.css';

interface AlternateLink {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  lang: string;
  dir: 'rtl' | 'ltr';
  gateway?: boolean;
  canonical?: string;
  alternates?: AlternateLink[];
}

const { title, lang, dir, gateway = false, canonical, alternates } = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternates?.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <link rel="icon" href="/favicon.png" type="image/png" />
    {
      lang === 'en' ? (
        <>
          <link
            rel="preload"
            href="/fonts/inter/InterVariable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href="/fonts/newsreader/Newsreader-Variable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
        </>
      ) : (
        <>
          <link
            rel="preload"
            href="/fonts/vazirmatn/Vazirmatn-Variable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href="/fonts/estedad/Estedad-Variable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
        </>
      )
    }
    <script is:inline>
      (function () {
        const storageKey = 'tm-theme';
        const root = document.documentElement;
        const modes = ['system', 'light', 'dark'];

        /**
         * Stable theme interface: `tm-themechange` is dispatched once after
         * each resolution with `{ requested: 'system'|'light'|'dark',
         * resolved: 'light'|'dark' }` in `event.detail`.
         */
        function systemTheme() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function updateControls(requested) {
          document.querySelectorAll('[data-theme-toggle]').forEach((control) => {
            control.setAttribute('data-theme-mode', requested);
            control.setAttribute('aria-pressed', requested === 'system' ? 'false' : 'true');
          });
        }

        function applyTheme(mode) {
          const requested = modes.includes(mode) ? mode : 'system';
          const resolved = requested === 'system' ? systemTheme() : requested;
          root.dataset.themeRequested = requested;
          root.dataset.theme = resolved;
          root.style.colorScheme = resolved;
          updateControls(requested);
          window.dispatchEvent(
            new CustomEvent('tm-themechange', { detail: { requested, resolved } }),
          );
          return { requested, resolved };
        }

        let storedTheme = 'system';
        try {
          storedTheme = localStorage.getItem(storageKey) || 'system';
        } catch {}
        applyTheme(storedTheme);

        window.__tmApplyTheme = applyTheme;
        window.__tmThemeStorageKey = storageKey;
        document.addEventListener('DOMContentLoaded', () => updateControls(root.dataset.themeRequested || 'system'), { once: true });
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          if (root.dataset.themeRequested === 'system') applyTheme('system');
        });
        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          if (!event.target.closest('[data-theme-toggle]')) return;
          const current = root.dataset.themeRequested || 'system';
          const next = modes[(modes.indexOf(current) + 1) % modes.length];
          try {
            localStorage.setItem(storageKey, next);
          } catch {}
          applyTheme(next);
        });
      })();
    </script>
  </head>
  <body
    class:list={[
      'min-h-screen bg-canvas text-ink antialiased',
      gateway && 'gateway-body',
      !gateway && 'site-body',
    ]}
  >
    <slot />
  </body>
</html>
