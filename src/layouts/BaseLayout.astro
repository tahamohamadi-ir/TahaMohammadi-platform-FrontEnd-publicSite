---
import '../styles/global.css';

interface AlternateLink {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  lang: string;
  dir: 'rtl' | 'ltr';
  gateway?: boolean;
  canonical?: string;
  alternates?: AlternateLink[];
}

const { title, lang, dir, gateway = false, canonical, alternates } = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternates?.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <link rel="icon" href="/favicon.png" type="image/png" />
    {
      lang === 'en' ? (
        <>
          <link
            rel="preload"
            href="/fonts/inter/InterVariable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href="/fonts/newsreader/Newsreader-Variable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
        </>
      ) : (
        <>
          <link
            rel="preload"
            href="/fonts/vazirmatn/Vazirmatn-Variable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href="/fonts/estedad/Estedad-Variable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
        </>
      )
    }
    <script is:inline>
      (function () {
        const storageKey = 'tm-theme';
        const root = document.documentElement;

        function systemTheme() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function applyTheme(mode) {
          if (mode === 'system') {
            root.removeAttribute('data-theme');
            root.style.colorScheme = systemTheme();
            return;
          }
          root.dataset.theme = mode;
          root.style.colorScheme = mode;
        }

        applyTheme(localStorage.getItem(storageKey) || 'system');

        window.__tmApplyTheme = applyTheme;
        window.__tmThemeStorageKey = storageKey;
      })();
    </script>
  </head>
  <body
    class:list={[
      'min-h-screen bg-canvas text-ink antialiased',
      gateway && 'gateway-body',
      !gateway && 'site-body',
    ]}
  >
    <slot />
  </body>
</html>
