---
import { listCreativeSlugs } from '../../../lib/creative-content'

export async function getStaticPaths() {
  const slugs = await listCreativeSlugs('en')
  return slugs.map((slug) => ({ params: { slug } }))
}

const slug = Astro.params.slug ?? ''
return Astro.redirect(`/en/gallery/${slug}/`, 301)
---
