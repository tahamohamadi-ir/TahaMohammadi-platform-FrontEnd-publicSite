---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import ContentState from '../../../components/state/ContentState.astro'
import type { components } from '../../../generated/public-api'
import { filterPublishedOnly, parseJsonResponse } from '../../../lib/api/client'
import {
  buildPublicApiUrl,
  canFetchPublicApi,
} from '../../../lib/api/resolve-url'

const locale = 'en' as const
const resources = canFetchPublicApi()
  ? await fetch(
      buildPublicApiUrl(`/api/downloads/${locale}?page=1&page_size=100`),
    )
      .then(parseJsonResponse<components['schemas']['PagedDownloadListOut']>)
      .then((payload) => filterPublishedOnly(payload.items ?? []))
      .catch(() => [])
  : []
---

<SiteLayout
  title="Resources — Taha Mohammadi"
  locale={locale}
  pathSegment="resources"
  alternateAvailable={false}
>
  <main class="product-index" id="main-content">
    <header class="product-index__lead">
      <p>Research materials</p><h1>Resources</h1>
    </header>
    {
      resources.length ? (
        <ul class="product-index__list">
          {resources.map((resource) => (
            <li>
              <article>
                <h2>{resource.title}</h2>
                <p>
                  {[resource.download_type, resource.language, resource.license]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title="No resources yet"
          message="Published resources will appear here when they are available."
        />
      )
    }
  </main>
</SiteLayout>
