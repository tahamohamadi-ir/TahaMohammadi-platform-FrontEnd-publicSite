---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import CreativeDetailContent from '../../../components/creative/CreativeDetailContent.astro'
import {
  fetchCreativeDetail,
  getCreativeRouteTitle,
  isCreativeDetailEmptyShellSlug,
  listCreativeSlugs,
  resolveCreativeAlternateAvailability,
} from '../../../lib/creative-content'
import { getCmsPlaceholderCopy } from '../../../lib/page-family-empty-chrome'
import '../../../styles/page-families.css'

export async function getStaticPaths() {
  const slugs = await listCreativeSlugs('en')
  return slugs.map((slug) => ({ params: { slug } }))
}

const locale = 'en' as const
const slug = Astro.params.slug ?? ''
const model = await fetchCreativeDetail(locale, slug)

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const alternateAvailable = await resolveCreativeAlternateAvailability(
  locale,
  slug,
)
const pageTitle = isCreativeDetailEmptyShellSlug(slug)
  ? `${getCreativeRouteTitle(locale)} — ${getCmsPlaceholderCopy(locale)}`
  : `${model.status === 'ready' ? model.work.title : getCreativeRouteTitle(locale)} — Taha Mohammadi`
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`gallery/${slug}`}
  alternateAvailable={alternateAvailable}
>
  <CreativeDetailContent locale={locale} model={model} />
</SiteLayout>
