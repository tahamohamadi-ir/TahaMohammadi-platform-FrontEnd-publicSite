---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import CollectionPage from '../../../components/talks/CollectionPage.astro'
import { fetchTalksIndex, getTalksRouteTitle } from '../../../lib/talks-content'
import '../../../styles/page-families.css'
import '../../../styles/product-talks.css'

const locale = 'en' as const
const model = await fetchTalksIndex(locale)
const pageTitle = `${getTalksRouteTitle(locale)} — Taha Mohammadi`
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment="talks"
  alternateAvailable={true}
>
  <CollectionPage locale={locale} model={model} />
</SiteLayout>
