---
import { listTeachingDetailSlugs } from '../../../lib/teaching-content'

export async function getStaticPaths() {
  const slugs = await listTeachingDetailSlugs('en')
  return slugs.map((slug) => ({ params: { slug } }))
}

const slug = Astro.params.slug ?? ''
return Astro.redirect(`/en/education/${slug}/`, 301)
---
