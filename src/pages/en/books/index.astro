---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import CollectionPage from '../../../components/books/CollectionPage.astro'
import {
  fetchBooksIndex,
  getBooksRouteTitle,
} from '../../../lib/books-content'
import '../../../styles/page-families.css'
import '../../../styles/product-books.css'

const locale = 'en' as const
const model = await fetchBooksIndex(locale)
const pageTitle = `${getBooksRouteTitle(locale)} — Taha Mohammadi`
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment="books"
  alternateAvailable={true}
>
  <CollectionPage locale={locale} model={model} />
</SiteLayout>
