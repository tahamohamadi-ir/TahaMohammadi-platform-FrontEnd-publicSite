---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import WritingDetailContent from '../../../components/writing/WritingDetailContent.astro'
import {
  fetchArticleDetail,
  listArticleSlugs,
  resolveWritingAlternateAvailability,
} from '../../../lib/writing-content'
import '../../../styles/page-families.css'

export async function getStaticPaths() {
  const slugs = await listArticleSlugs('fa')
  return slugs.map((slug) => ({ params: { slug } }))
}

const locale = 'fa' as const
const slug = Astro.params.slug ?? ''
const model = await fetchArticleDetail(locale, slug)

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const alternateAvailable = await resolveWritingAlternateAvailability(locale)
const pageTitle = `${model.article.title} — طه محمدی`
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`blog/${slug}`}
  alternateAvailable={alternateAvailable}
>
  <WritingDetailContent locale={locale} model={model} />
</SiteLayout>
