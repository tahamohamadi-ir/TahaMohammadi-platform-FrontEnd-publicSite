---
import { listTeachingDetailSlugs } from '../../../lib/teaching-content'

export async function getStaticPaths() {
  const slugs = await listTeachingDetailSlugs('fa')
  return slugs.map((slug) => ({ params: { slug } }))
}

const slug = Astro.params.slug ?? ''
return Astro.redirect(`/fa/education/${slug}/`, 301)
---
