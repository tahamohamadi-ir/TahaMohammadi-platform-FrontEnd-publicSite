---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import ContentState from '../../../components/state/ContentState.astro'
import { listBooks } from '../../../lib/writing-content'

const locale = 'fa' as const
const books = await listBooks(locale)
---

<SiteLayout
  title="کتاب‌ها — طاها محمدی"
  locale={locale}
  pathSegment="books"
  alternateAvailable={false}
>
  <main class="product-index" id="main-content">
    <header class="product-index__lead">
      <p>کتابخانهٔ پژوهش</p><h1>کتاب‌ها</h1>
    </header>
    {
      books.length ? (
        <ul class="product-index__list">
          {books.map((book) => (
            <li>
              <article>
                <h2>{book.title}</h2>
                <p>
                  {[book.authors, book.publisher, book.publication_date]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title="هنوز کتابی منتشر نشده است"
          message="کتاب‌های منتشرشده پس از آماده‌شدن در اینجا نمایش داده می‌شوند."
        />
      )
    }
  </main>
</SiteLayout>
