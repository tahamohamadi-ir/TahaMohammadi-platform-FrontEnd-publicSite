---
import SiteLayout from '../../layouts/SiteLayout.astro'
import HomeContent from '../../components/home/HomeContent.astro'
import { fetchHomeComposition, fetchHomeLanding } from '../../lib/home-content'
import { loadHeroGraph } from '../../lib/hero-graph-content'
import { shellCopy } from '../../lib/navigation'
import '../../styles/home.css'

const locale = 'fa' as const
const [composition, landing, alternateLanding] = await Promise.all([
  fetchHomeComposition(locale),
  fetchHomeLanding(locale),
  fetchHomeLanding(locale === 'en' ? 'fa' : 'en'),
])
const graph = composition?.modules?.some((item) => item.key === 'graph')
  ? await loadHeroGraph(locale)
  : { status: 'unavailable' as const, locale }
---

<SiteLayout
  title={landing?.seo_title ||
    landing?.title ||
    shellCopy.homeUnavailableTitle.fa}
  description={landing?.seo_description || ''}
  locale={locale}
  alternateAvailable={Boolean(alternateLanding)}
  hideFooterPromo
>
  <HomeContent locale={locale} composition={composition} graph={graph} />
</SiteLayout>
