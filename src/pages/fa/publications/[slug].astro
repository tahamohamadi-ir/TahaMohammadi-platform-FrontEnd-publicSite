---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import { pickDetailSeo } from '../../../lib/seo'
import PublicationDetailContent from '../../../components/publications/PublicationDetailContent.astro'
import {
  fetchPublicationDetail,
  listPublicationSlugs,
  resolvePublicationsAlternateAvailability,
} from '../../../lib/publications-content'
import '../../../styles/page-families.css'

export async function getStaticPaths() {
  const slugs = await listPublicationSlugs('fa')
  return slugs.map((slug) => ({ params: { slug } }))
}

const locale = 'fa' as const
const slug = Astro.params.slug ?? ''
const model = await fetchPublicationDetail(locale, slug)

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const alternateAvailable =
  await resolvePublicationsAlternateAvailability(locale)
const pageTitle = `${model.publication.title} — Taha Mohammadi`
const detailSeo = pickDetailSeo(model.publication.seo)
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`publications/${slug}`}
  alternateAvailable={alternateAvailable}
  description={detailSeo.description}
  socialImage={detailSeo.socialImage}
>
  <PublicationDetailContent locale={locale} model={model} />
</SiteLayout>
