---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import CreativeDetailContent from '../../../components/creative/CreativeDetailContent.astro';
import {
  fetchCreativeDetail,
  listCreativeSlugs,
  resolveCreativeAlternateAvailability,
} from '../../../lib/creative-content';
import '../../../styles/page-families.css';

export async function getStaticPaths() {
  const slugs = await listCreativeSlugs('fa');
  return slugs.map((slug) => ({ params: { slug } }));
}

const locale = 'fa' as const;
const slug = Astro.params.slug ?? '';
const model = await fetchCreativeDetail(locale, slug);

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const alternateAvailable = await resolveCreativeAlternateAvailability(locale);
const pageTitle = `${model.work.title} — Taha Mohammadi`;
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`creative/${slug}`}
  alternateAvailable={alternateAvailable}
>
  <CreativeDetailContent locale={locale} model={model} />
</SiteLayout>
