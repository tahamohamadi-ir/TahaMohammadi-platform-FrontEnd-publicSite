---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ProjectsPageContent from '../../../components/projects/ProjectsPageContent.astro';
import {
  fetchProjectsIndex,
  getProjectsRouteTitle,
  resolveProjectsAlternateAvailability,
} from '../../../lib/projects-content';
import '../../../styles/page-families.css';

const locale = 'fa' as const;
const model = await fetchProjectsIndex(locale);
const alternateAvailable = await resolveProjectsAlternateAvailability(locale);
const pageTitle = `${getProjectsRouteTitle(locale)} — Taha Mohammadi`;
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment="projects"
  alternateAvailable={alternateAvailable}
>
  <ProjectsPageContent locale={locale} model={model} />
</SiteLayout>
