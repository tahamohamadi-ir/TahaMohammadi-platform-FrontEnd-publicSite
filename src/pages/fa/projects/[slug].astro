---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import StubProjectDetail from '../../../components/stub/StubProjectDetail.astro';
import { getStubProject, stubProjectSlugs } from '../../../lib/stub-detail-content';

export function getStaticPaths() {
  return stubProjectSlugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug ?? '';
const project = getStubProject('fa', slug);

if (!project) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<SiteLayout
  title={`${project.title} — طه محمدی`}
  locale="fa"
  pathSegment={`projects/${slug}`}
>
  <StubProjectDetail locale="fa" project={project} />
</SiteLayout>
