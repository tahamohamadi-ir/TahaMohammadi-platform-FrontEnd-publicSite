---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import ContentState from '../../../components/state/ContentState.astro'
import type { components } from '../../../generated/public-api'
import { parseJsonResponse } from '../../../lib/api/client'
import {
  buildPublicApiUrl,
  canFetchPublicApi,
} from '../../../lib/api/resolve-url'

const locale = 'fa' as const
const collections = canFetchPublicApi()
  ? await fetch(
      buildPublicApiUrl(`/api/v1/collections/${locale}?page=1&pageSize=50`),
    )
      .then(parseJsonResponse<components['schemas']['CollectionListOut']>)
      .then((payload) => payload.items ?? [])
      .catch(() => [])
  : []
---

<SiteLayout
  title="مجموعه‌ها — طاها محمدی"
  locale={locale}
  pathSegment="collections"
  alternateAvailable={false}
>
  <main class="product-index" id="main-content">
    <header class="product-index__lead">
      <p>پژوهش گزیده</p><h1>مجموعه‌ها</h1>
    </header>
    {
      collections.length ? (
        <ul class="product-index__list">
          {collections.map((collection) => (
            <li>
              <article>
                <h2>{collection.title}</h2>
                {collection.description ? (
                  <p>{collection.description}</p>
                ) : null}
                <p>
                  {[collection.curatorName, collection.curatedDate]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title="هنوز مجموعه‌ای منتشر نشده است"
          message="مجموعه‌های منتشرشده پس از آماده‌شدن در اینجا نمایش داده می‌شوند."
        />
      )
    }
  </main>
</SiteLayout>
