---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import CollectionPage from '../../../components/collections/CollectionPage.astro'
import {
  fetchCollectionsIndex,
  getCollectionsRouteTitle,
} from '../../../lib/collections-content'
import '../../../styles/page-families.css'
import '../../../styles/product-collections.css'

const locale = 'fa' as const
const model = await fetchCollectionsIndex(locale)
const pageTitle = `${getCollectionsRouteTitle(locale)} — طه محمدی`
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment="collections"
  alternateAvailable={true}
>
  <CollectionPage locale={locale} model={model} />
</SiteLayout>
