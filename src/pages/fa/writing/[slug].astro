---
import { listArticleSlugs } from '../../../lib/writing-content'

export async function getStaticPaths() {
  const slugs = await listArticleSlugs('fa')
  return slugs.map((slug) => ({ params: { slug } }))
}

const slug = Astro.params.slug ?? ''
return Astro.redirect(`/fa/blog/${slug}/`, 301)
---
