---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import StubWritingDetail from '../../../components/stub/StubWritingDetail.astro';
import { getStubPublication, stubPublicationSlugs } from '../../../lib/stub-detail-content';

export function getStaticPaths() {
  return stubPublicationSlugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug ?? '';
const publication = getStubPublication('fa', slug);

if (!publication) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<SiteLayout
  title={`${publication.title} — طه محمدی`}
  locale="fa"
  pathSegment={`writing/${slug}`}
>
  <StubWritingDetail locale="fa" publication={publication} />
</SiteLayout>
