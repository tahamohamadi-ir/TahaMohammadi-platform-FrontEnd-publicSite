---
// Generic, locale-less catch-all: the host's error page for any unmatched
// path with no /en/ or /fa/ prefix (src/pages/en/404.astro and
// src/pages/fa/404.astro serve the normal, single-locale case).
// ContentState is single-locale by design (it sets lang on its own root),
// so this page marks each language run with its own lang/dir directly
// instead of forcing one wrong document lang over mixed-language text.
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/shell.css'

const pageTitle = 'Page Not Found / صفحه یافت نشد — Taha Mohammadi'
---

<BaseLayout
  title={pageTitle}
  lang="en"
  dir="ltr"
  canonical="/404"
  description="The requested page could not be found."
  robots="noindex, nofollow"
>
  <main id="main-content" class="site-main site-main--utility" tabindex="-1">
    <div class="utility-container">
      <section
        class="ui-content-state ui-content-state--unavailable"
        role="status"
        aria-labelledby="content-state-title-404"
      >
        <div class="ui-content-state__body">
          <span class="ui-content-state__icon" aria-hidden="true"></span>
          <h1 id="content-state-title-404" class="ui-content-state__title">
            <span lang="en">Page not found</span>
            <span class="utility-sep" aria-hidden="true">/</span>
            <span lang="fa" dir="rtl">صفحه یافت نشد</span>
          </h1>
          <p class="ui-content-state__message" lang="en">
            The page you requested does not exist or has been moved.
          </p>
          <p class="ui-content-state__message" lang="fa" dir="rtl">
            صفحه درخواست‌شده وجود ندارد یا منتقل شده است.
          </p>
        </div>
        <div class="ui-content-state__actions">
          <a href="/en/" lang="en">Return to Home</a>
          <a href="/fa/" lang="fa" dir="rtl">بازگشت به خانه</a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .utility-container {
    max-width: var(--max-width-narrow, 42rem);
    margin-inline: auto;
    margin-block: var(--space-24, 6rem);
    padding-inline: var(--space-6, 1.5rem);
  }

  .ui-content-state {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .ui-content-state__body {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .ui-content-state__icon {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background: var(--color-border-strong, var(--color-border-subtle));
  }

  .ui-content-state__title {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: 600;
    line-height: 1.3;
  }

  .utility-sep {
    color: var(--color-ink-tertiary);
    padding-inline: var(--space-1);
  }

  .ui-content-state__message {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-ink-secondary);
    max-width: 42rem;
  }

  .ui-content-state__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .ui-content-state__actions a {
    color: var(--color-brand);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
