---
import SiteLayout from '../../../../layouts/SiteLayout.astro'
import { localeStaticPaths, type Locale } from '../../../../lib/locale-paths'
import { brandedTitle } from '../../../../lib/navigation'
import { pickDetailSeo } from '../../../../lib/seo'
import ResearchStatementDetailContent from '../../../../components/research/ResearchStatementDetailContent.astro'
import {
  fetchResearchStatementDetail,
  listResearchStatementSlugs,
  resolveResearchStatementAlternateAvailability,
} from '../../../../lib/research-content'
import '../../../../styles/page-families.css'
import '../../../../styles/pf05-alignment.css'
import '../../../../styles/product-research.css'

export async function getStaticPaths() {
  return localeStaticPaths(async (locale) =>
    (await listResearchStatementSlugs(locale)).map((slug) => ({ slug })),
  )
}

const locale = Astro.params.locale as Locale
const slug = Astro.params.slug ?? ''
const model = await fetchResearchStatementDetail(locale, slug)

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const alternateAvailable = await resolveResearchStatementAlternateAvailability(
  locale,
  slug,
)
const pageTitle = brandedTitle(locale, model.statement.title, 'legacy')
const detailSeo = pickDetailSeo(model.statement.seo)
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`research/statements/${slug}`}
  alternateAvailable={alternateAvailable}
  description={detailSeo.description}
  socialImage={detailSeo.socialImage}
>
  <ResearchStatementDetailContent locale={locale} model={model} />
</SiteLayout>
