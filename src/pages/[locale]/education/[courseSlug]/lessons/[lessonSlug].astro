---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'
import { localeStaticPaths, type Locale } from '../../../../../lib/locale-paths'
import { brandedTitle } from '../../../../../lib/navigation'
import { pickDetailSeo } from '../../../../../lib/seo'
import LessonDetailContent from '../../../../../components/teaching/LessonDetailContent.astro'
import {
  fetchLessonDetail,
  listCourseLessonParams,
  resolveLessonAlternateAvailability,
} from '../../../../../lib/lessons-content'
import '../../../../../styles/page-families.css'
import '../../../../../styles/pf06-alignment.css'
import '../../../../../styles/product-teaching.css'

export async function getStaticPaths() {
  return localeStaticPaths(async (locale) =>
    (await listCourseLessonParams(locale)).map(
      ({ courseSlug, lessonSlug }) => ({ courseSlug, lessonSlug }),
    ),
  )
}

const locale = Astro.params.locale as Locale
const courseSlug = Astro.params.courseSlug ?? ''
const lessonSlug = Astro.params.lessonSlug ?? ''
const model = await fetchLessonDetail(locale, courseSlug, lessonSlug)

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const alternateAvailable = await resolveLessonAlternateAvailability(
  locale,
  courseSlug,
  lessonSlug,
)
const pageTitle = brandedTitle(locale, model.lesson.title, 'legacy')
const detailSeo = pickDetailSeo(model.lesson.seo)
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`education/${courseSlug}/lessons/${lessonSlug}`}
  alternateAvailable={alternateAvailable}
  description={detailSeo.description}
  socialImage={detailSeo.socialImage}
>
  <LessonDetailContent locale={locale} model={model} />
</SiteLayout>
