---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import { localeStaticPaths, type Locale } from '../../../lib/locale-paths'
import { brandedTitle } from '../../../lib/navigation'
import { pickDetailSeo } from '../../../lib/seo'
import TeachingDetailContent from '../../../components/teaching/TeachingDetailContent.astro'
import {
  fetchTeachingDetail,
  listTeachingDetailSlugs,
  resolveTeachingAlternateAvailability,
} from '../../../lib/teaching-content'
import '../../../styles/page-families.css'

export async function getStaticPaths() {
  return localeStaticPaths(async (locale) =>
    (await listTeachingDetailSlugs(locale)).map((slug) => ({ slug })),
  )
}

const locale = Astro.params.locale as Locale
const slug = Astro.params.slug ?? ''
const model = await fetchTeachingDetail(locale, slug)

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const alternateAvailable = await resolveTeachingAlternateAvailability(
  locale,
  slug,
)
const pageTitle = brandedTitle(locale, model.record.title)
const detailSeo = pickDetailSeo(model.record.seo)
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`education/${slug}`}
  alternateAvailable={alternateAvailable}
  description={detailSeo.description}
  socialImage={detailSeo.socialImage}
>
  <TeachingDetailContent locale={locale} model={model} />
</SiteLayout>
