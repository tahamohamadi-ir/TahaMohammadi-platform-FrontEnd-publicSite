---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import { localeStaticPaths, type Locale } from '../../../lib/locale-paths'
import { brandedTitle } from '../../../lib/navigation'
import { pickDetailSeo } from '../../../lib/seo'
import CreativeDetailContent from '../../../components/creative/CreativeDetailContent.astro'
import {
  fetchCreativeDetail,
  getCreativeRouteTitle,
  listCreativeSlugs,
  resolveCreativeAlternateAvailability,
} from '../../../lib/creative-content'
import '../../../styles/page-families.css'

export async function getStaticPaths() {
  return localeStaticPaths(async (locale) =>
    (await listCreativeSlugs(locale)).map((slug) => ({ slug })),
  )
}

const locale = Astro.params.locale as Locale
const slug = Astro.params.slug ?? ''
const model = await fetchCreativeDetail(locale, slug)

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const alternateAvailable = await resolveCreativeAlternateAvailability(
  locale,
  slug,
)
const pageTitle = brandedTitle(
  locale,
  model.status === 'ready' ? model.work.title : getCreativeRouteTitle(locale),
)
const detailSeo = pickDetailSeo(
  model.status === 'ready' ? model.work.seo : null,
)
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`gallery/${slug}`}
  alternateAvailable={alternateAvailable}
  description={detailSeo.description}
  socialImage={detailSeo.socialImage}
>
  <CreativeDetailContent locale={locale} model={model} />
</SiteLayout>
