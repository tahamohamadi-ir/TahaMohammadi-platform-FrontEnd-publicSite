---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import { localeStaticPaths, type Locale } from '../../../lib/locale-paths'
import { brandedTitle } from '../../../lib/navigation'
import CollectionPage from '../../../components/collections/CollectionPage.astro'
import {
  fetchCollectionsIndex,
  getCollectionsRouteTitle,
} from '../../../lib/collections-content'
import '../../../styles/page-families.css'
import '../../../styles/generic-collection.css'

export function getStaticPaths() {
  return localeStaticPaths()
}

const locale = Astro.params.locale as Locale
const model = await fetchCollectionsIndex(locale)
const pageTitle = brandedTitle(locale, getCollectionsRouteTitle(locale))
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment="collections"
  alternateAvailable={true}
>
  <CollectionPage locale={locale} model={model} />
</SiteLayout>
