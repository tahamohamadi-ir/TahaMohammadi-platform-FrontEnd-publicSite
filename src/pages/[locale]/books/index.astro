---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import { localeStaticPaths, type Locale } from '../../../lib/locale-paths'
import { brandedTitle } from '../../../lib/navigation'
import CollectionPage from '../../../components/books/CollectionPage.astro'
import { fetchBooksIndex, getBooksRouteTitle } from '../../../lib/books-content'
import '../../../styles/page-families.css'
import '../../../styles/generic-collection.css'

export function getStaticPaths() {
  return localeStaticPaths()
}

const locale = Astro.params.locale as Locale
const model = await fetchBooksIndex(locale)
const pageTitle = brandedTitle(locale, getBooksRouteTitle(locale), 'legacy')
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment="books"
  alternateAvailable={true}
>
  <CollectionPage locale={locale} model={model} />
</SiteLayout>
