---
import SiteLayout from '../../../../layouts/SiteLayout.astro'
import { localeStaticPaths, type Locale } from '../../../../lib/locale-paths'
import { brandedTitle } from '../../../../lib/navigation'
import { pickDetailSeo } from '../../../../lib/seo'
import DetailPage from '../../../../components/series/DetailPage.astro'
import {
  fetchSeriesDetail,
  listSeriesSlugs,
  resolveSeriesAlternateAvailability,
} from '../../../../lib/series-content'
import '../../../../styles/page-families.css'
import '../../../../styles/generic-collection.css'

export async function getStaticPaths() {
  return localeStaticPaths(async (locale) =>
    (await listSeriesSlugs(locale)).map((slug) => ({ slug })),
  )
}

const locale = Astro.params.locale as Locale
const slug = Astro.params.slug ?? ''
const model = await fetchSeriesDetail(locale, slug)

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const alternateAvailable = await resolveSeriesAlternateAvailability(
  locale,
  slug,
)
const pageTitle = brandedTitle(locale, model.series.title)
const detailSeo = pickDetailSeo(model.series.seo)
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`blog/series/${slug}`}
  alternateAvailable={alternateAvailable}
  description={detailSeo.description}
  socialImage={detailSeo.socialImage}
>
  <DetailPage locale={locale} model={model} />
</SiteLayout>
