---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import { localeStaticPaths, type Locale } from '../../../lib/locale-paths'
import { brandedTitle } from '../../../lib/navigation'
import { pickDetailSeo } from '../../../lib/seo'
import WritingDetailContent from '../../../components/writing/WritingDetailContent.astro'
import {
  articleNeighbors,
  fetchArticleDetail,
  listArticles,
  listArticleSlugs,
  resolveWritingAlternateAvailability,
} from '../../../lib/writing-content'
import '../../../styles/page-families.css'

export async function getStaticPaths() {
  return localeStaticPaths(async (locale) =>
    (await listArticleSlugs(locale)).map((slug) => ({ slug })),
  )
}

const locale = Astro.params.locale as Locale
const slug = Astro.params.slug ?? ''
const model = await fetchArticleDetail(locale, slug)

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const alternateAvailable = await resolveWritingAlternateAvailability(
  locale,
  slug,
)
const neighbors = articleNeighbors(await listArticles(locale), slug)
const pageTitle = brandedTitle(locale, model.article.title)
const detailSeo = pickDetailSeo(model.article.seo)
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`blog/${slug}`}
  alternateAvailable={alternateAvailable}
  description={detailSeo.description}
  socialImage={detailSeo.socialImage}
>
  <WritingDetailContent
    locale={locale}
    model={model}
    previous={neighbors.previous}
    next={neighbors.next}
  />
</SiteLayout>
