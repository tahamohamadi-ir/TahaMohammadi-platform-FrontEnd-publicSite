---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import { localeStaticPaths, type Locale } from '../../../lib/locale-paths'
import { brandedTitle } from '../../../lib/navigation'
import WritingPageContent from '../../../components/writing/WritingPageContent.astro'
import {
  fetchWritingIndex,
  getWritingRouteTitle,
  resolveWritingAlternateAvailability,
} from '../../../lib/writing-content'
import '../../../styles/page-families.css'

export function getStaticPaths() {
  return localeStaticPaths()
}

const locale = Astro.params.locale as Locale
const model = await fetchWritingIndex(locale)
const alternateAvailable = await resolveWritingAlternateAvailability(locale)
const pageTitle = brandedTitle(locale, getWritingRouteTitle(locale))
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment="blog"
  alternateAvailable={alternateAvailable}
>
  <WritingPageContent locale={locale} model={model} />
</SiteLayout>
