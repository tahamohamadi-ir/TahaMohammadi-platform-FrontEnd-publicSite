---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import { localeStaticPaths, type Locale } from '../../../lib/locale-paths'
import { brandedTitle } from '../../../lib/navigation'
import { pickDetailSeo } from '../../../lib/seo'
import DetailPage from '../../../components/resources/DetailPage.astro'
import {
  fetchResourceDetail,
  listResourceSlugs,
  resolveResourceAlternateAvailability,
} from '../../../lib/resources-content'
import '../../../styles/page-families.css'
import '../../../styles/generic-collection.css'

export async function getStaticPaths() {
  return localeStaticPaths(async (locale) =>
    (await listResourceSlugs(locale)).map((slug) => ({ slug })),
  )
}

const locale = Astro.params.locale as Locale
const slug = Astro.params.slug ?? ''
const model = await fetchResourceDetail(locale, slug)

if (model.status === 'unavailable') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const alternateAvailable = await resolveResourceAlternateAvailability(
  locale,
  slug,
)
const pageTitle = brandedTitle(locale, model.resource.title, 'legacy')
const detailSeo = pickDetailSeo(model.resource.seo)
---

<SiteLayout
  title={pageTitle}
  locale={locale}
  pathSegment={`resources/${slug}`}
  alternateAvailable={alternateAvailable}
  description={detailSeo.description}
  socialImage={detailSeo.socialImage}
>
  <DetailPage locale={locale} model={model} />
</SiteLayout>
