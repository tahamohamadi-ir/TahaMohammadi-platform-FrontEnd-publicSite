---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ThemePicture from '../components/media/ThemePicture.astro';
import PromotedPicture from '../components/media/PromotedPicture.astro';
import { GATEWAY_ROLE_LINE } from '../lib/navigation';
import { BRAND_MARK_ASSET_ID, GATEWAY_ATMOSPHERE_ASSETS } from '../lib/media/promoted-media';
import '../styles/gateway.css';
---

<BaseLayout title="Taha Mohammadi — Language gateway" lang="en" dir="ltr" gateway>
  <div class="gw">
    <div class="gw__atmosphere" aria-hidden="true">
      <ThemePicture
        lightAssetId={GATEWAY_ATMOSPHERE_ASSETS.light}
        darkAssetId={GATEWAY_ATMOSPHERE_ASSETS.dark}
        mediaSlot="gateway.atmosphere"
        fill
        imgClass="gw__atmosphere-img"
      />
    </div>
    <div class="gw__scrim" aria-hidden="true"></div>

    <header class="gw__toolbar">
      <ThemeToggle />
    </header>

    <section class="gw__hero" aria-labelledby="gateway-name">
      <div class="gw__brand" aria-hidden="true">
        <PromotedPicture
          assetId={BRAND_MARK_ASSET_ID}
          mediaSlot="brand.mark"
          locale="en"
          imgClass="gw__mark"
        />
      </div>

      <h1 id="gateway-name" class="gw__title">
        <span class="gw__title-primary">Taha</span><span class="gw__title-accent"> Mohammadi</span>
      </h1>

      <p class="gw__roles">{GATEWAY_ROLE_LINE}</p>
    </section>

    <footer class="gw__footer">
      <p class="gw__prompt">Choose your language</p>
      <nav aria-label="Language selection" class="gw__nav">
        <a href="/en/" class="gw__locale" lang="en">English</a>
        <a href="/fa/" class="gw__locale" lang="fa">فارسی</a>
      </nav>
    </footer>
  </div>
</BaseLayout>
