---
import BaseLayout from '../layouts/BaseLayout.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import GatewayPortal from '../components/gateway/GatewayPortal.astro'
import { fetchLocalizedSiteSettings } from '../lib/site-settings-content'
const settings = await fetchLocalizedSiteSettings('en')
const copy = settings?.contentCopy ?? {}
const name = settings?.brandName ?? ''
import '../styles/gateway.css'
---

<BaseLayout
  title={settings?.seo?.title || copy['gateway.title'] || name}
  lang="en"
  dir="ltr"
  gateway
>
  <div class="gw">
    <div class="gw__scrim" aria-hidden="true"></div>

    <header class="gw__toolbar">
      <ThemeToggle />
    </header>

    <section class="gw__hero" aria-labelledby="gateway-name">
      <h1 id="gateway-name" class="gw__title">{name}</h1>
      {settings?.tagline && <p class="gw__roles">{settings.tagline}</p>}

      <GatewayPortal />
    </section>

    <footer class="gw__footer">
      <p class="gw__prompt">{copy['gateway.prompt']}</p>
      <nav aria-label={copy['gateway.selection']} class="gw__nav">
        <a href="/en/" class="gw__locale" lang="en"
          >{copy['gateway.en'] || 'EN'}</a
        >
        <a href="/fa/" class="gw__locale" lang="fa"
          >{copy['gateway.fa'] || 'FA'}</a
        >
      </nav>
    </footer>
  </div>
</BaseLayout>
