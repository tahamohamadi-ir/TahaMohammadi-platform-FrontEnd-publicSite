---
import SectionLead from '../../components/ui/SectionLead.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import tokens from '../../../contracts/design-authority/tokens.json';

const { semanticLight, semanticDark } = tokens;
---

<section class="atlas-section" id="atlas-locale-theme" data-visual-id="AtlasLocaleThemeSection">
  <h2 class="atlas-section__title">Locale and theme parity</h2>
  <p class="atlas-section__summary">
    English LTR and Persian RTL specimens with shared token surfaces. Theme resolution uses the existing bootstrap and toggle controls.
  </p>

  <div class="atlas-locale-panel" lang="en" dir="ltr" data-visual-id="AtlasLocaleSpecimen-en">
    <SectionLead eyebrow="English" title="English specimen" summary="Left-to-right layout sample." />
  </div>

  <div class="atlas-locale-panel" lang="fa" dir="rtl" data-visual-id="AtlasLocaleSpecimen-fa">
    <SectionLead eyebrow="فارسی" title="نمونهٔ فارسی" summary="نمونهٔ چیدمان راست‌به‌چپ." />
  </div>

  <div class="atlas-theme-grid">
    <div class="atlas-specimen atlas-theme-specimen" data-visual-id="AtlasThemeSpecimen-light">
      <p class="atlas-specimen__label">Light reference</p>
      <div
        class="atlas-theme-specimen__swatch"
        style={`background: ${semanticLight.canvas}; border-color: ${semanticLight.brand}; color: ${semanticLight.ink};`}
      >
        <span class="atlas-theme-specimen__value">{semanticLight.canvas}</span>
      </div>
    </div>

    <div class="atlas-specimen atlas-theme-specimen" data-visual-id="AtlasThemeSpecimen-dark">
      <p class="atlas-specimen__label">Dark reference</p>
      <div
        class="atlas-theme-specimen__swatch"
        style={`background: ${semanticDark.canvas}; border-color: ${semanticDark.brand}; color: ${semanticDark.ink};`}
      >
        <span class="atlas-theme-specimen__value">{semanticDark.canvas}</span>
      </div>
    </div>

    <div class="atlas-specimen atlas-theme-specimen atlas-theme-specimen--live" data-visual-id="AtlasThemeSpecimen-live">
      <p class="atlas-specimen__label">Live theme resolution</p>
      <div class="atlas-state-row">
        <ThemeToggle locale="en" />
        <ThemeToggle locale="fa" />
      </div>
      <div class="atlas-theme-specimen__probe" data-visual-id="AtlasThemeSpecimen-probe">
        Resolved canvas, brand, and ink tokens follow the active theme.
      </div>
    </div>
  </div>
</section>

<style>
  .atlas-theme-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .atlas-theme-specimen__swatch {
    display: grid;
    place-items: center;
    min-block-size: 5rem;
    padding: var(--space-4);
    border: 2px solid;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .atlas-theme-specimen__value {
    font-family: ui-monospace, monospace;
  }

  .atlas-theme-specimen__probe {
    padding: var(--space-4);
    border: 2px solid var(--color-brand);
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    color: var(--color-ink);
    line-height: 1.5;
  }
</style>
