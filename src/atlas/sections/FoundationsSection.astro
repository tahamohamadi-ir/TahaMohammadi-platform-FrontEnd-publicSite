---
import { SCENE_CONTRACT_VERSION } from '../../lib/visual/scene-contract'

const tokens = [
  { name: 'canvas', variable: '--color-canvas' },
  { name: 'surface', variable: '--color-surface' },
  { name: 'ink', variable: '--color-ink' },
  { name: 'brand', variable: '--color-brand' },
  { name: 'signature', variable: '--color-signature' },
  { name: 'research', variable: '--color-research' },
  { name: 'focus', variable: '--color-focus' },
]
---

<section
  class="atlas-section"
  id="atlas-foundations"
  data-visual-id="AtlasFoundationsSection"
>
  <h2 class="atlas-section__title">Foundations</h2>
  <p class="atlas-section__summary">
    Token-backed canvas, semantic colors, typography, spacing rhythm, and motion
    aliases used by the public design system.
  </p>

  <div class="atlas-grid atlas-grid--tokens">
    {
      tokens.map((token) => (
        <div class="atlas-token" data-visual-id={`AtlasToken-${token.name}`}>
          <div
            class="atlas-token__swatch"
            style={`background: var(${token.variable});`}
          />
          <p class="atlas-token__name">{token.variable}</p>
        </div>
      ))
    }
  </div>

  <div class="atlas-specimen" data-visual-id="AtlasTypographySpecimen">
    <p class="atlas-specimen__label">Typography</p>
    <p
      style="font-family: var(--font-display); font-size: var(--font-size-2xl); margin: 0;"
    >
      Display sample
    </p>
    <p
      style="font-family: var(--font-body); font-size: var(--font-size-base); margin: 0; color: var(--color-ink-secondary);"
    >
      Body sample with line-height rhythm.
    </p>
  </div>

  <div class="atlas-specimen" data-visual-id="AtlasHeroSceneContract">
    <p class="atlas-specimen__label">
      Hero scene contract ({SCENE_CONTRACT_VERSION})
    </p>
    <p class="atlas-section__summary">
      Locked CA-03 renderer/controller signatures for the Home hero
      constellation. The renderer reads only these palette roles from the
      authored tokens and never invents a second palette.
    </p>
    <div class="atlas-grid atlas-grid--tokens">
      {
        [
          'canvas',
          'surface',
          'ink',
          'brand',
          'signature',
          'research',
          'context',
        ].map((role) => (
          <div class="atlas-token" data-visual-id={`AtlasToken-hero-${role}`}>
            <div
              class="atlas-token__swatch"
              style={`background: var(--color-${role});`}
            />
            <p class="atlas-token__name">--color-{role}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
