---
import AboutContactUtilityTemplate from '../../components/templates/AboutContactUtilityTemplate.astro';
import CollectionIndexTemplate from '../../components/templates/CollectionIndexTemplate.astro';
import EditorialIndexTemplate from '../../components/templates/EditorialIndexTemplate.astro';
import EvidenceVisualDetailTemplate from '../../components/templates/EvidenceVisualDetailTemplate.astro';
import HomeTemplate from '../../components/templates/HomeTemplate.astro';
import LongFormDetailTemplate from '../../components/templates/LongFormDetailTemplate.astro';
import SectionLead from '../../components/ui/SectionLead.astro';
---

<section class="atlas-section" id="atlas-templates" data-visual-id="AtlasTemplatesSection">
  <h2 class="atlas-section__title">Templates</h2>
  <p class="atlas-section__summary">Six slot-based templates with delegated H1 lead regions and optional section collapse.</p>

  <div class="atlas-specimen" data-visual-id="AtlasTemplateSpecimen-Home">
    <p class="atlas-specimen__label">HomeTemplate</p>
    <HomeTemplate>
      <div slot="header">Header slot</div>
      <SectionLead slot="identity-lead" title="Home lead" summary="Identity lead region." />
      <ul slot="relationship-graph"><li>Graph slot</li></ul>
      <div slot="footer">Footer slot</div>
    </HomeTemplate>
  </div>

  <div class="atlas-specimen" data-visual-id="AtlasTemplateSpecimen-CollectionIndex">
    <p class="atlas-specimen__label">CollectionIndexTemplate</p>
    <CollectionIndexTemplate>
      <div slot="header">Header slot</div>
      <nav slot="breadcrumbs">Breadcrumbs slot</nav>
      <SectionLead slot="lead" title="Collection index" />
      <form slot="filters">Filter slot</form>
      <ul slot="records"><li>Record slot</li></ul>
      <nav slot="pagination">Pagination slot</nav>
      <div slot="footer">Footer slot</div>
    </CollectionIndexTemplate>
  </div>

  <div class="atlas-specimen" data-visual-id="AtlasTemplateSpecimen-EditorialIndex">
    <p class="atlas-specimen__label">EditorialIndexTemplate</p>
    <EditorialIndexTemplate>
      <div slot="header">Header slot</div>
      <nav slot="breadcrumbs">Breadcrumbs slot</nav>
      <SectionLead slot="lead" title="Editorial index" />
      <form slot="filters">Filter slot</form>
      <ul slot="records"><li>Record slot</li></ul>
      <nav slot="pagination">Pagination slot</nav>
      <div slot="footer">Footer slot</div>
    </EditorialIndexTemplate>
  </div>

  <div class="atlas-specimen" data-visual-id="AtlasTemplateSpecimen-LongFormDetail">
    <p class="atlas-specimen__label">LongFormDetailTemplate</p>
    <LongFormDetailTemplate>
      <div slot="header">Header slot</div>
      <nav slot="breadcrumbs">Breadcrumbs slot</nav>
      <SectionLead slot="lead" title="Long-form detail" />
      <nav slot="toc">TOC slot</nav>
      <div slot="body"><p>Portable body slot.</p></div>
      <ul slot="related"><li>Related slot</li></ul>
      <div slot="footer">Footer slot</div>
    </LongFormDetailTemplate>
  </div>

  <div class="atlas-specimen" data-visual-id="AtlasTemplateSpecimen-EvidenceVisualDetail">
    <p class="atlas-specimen__label">EvidenceVisualDetailTemplate</p>
    <EvidenceVisualDetailTemplate>
      <div slot="header">Header slot</div>
      <nav slot="breadcrumbs">Breadcrumbs slot</nav>
      <SectionLead slot="lead" title="Evidence detail" />
      <dl slot="metadata"><dt>Label</dt><dd>Value</dd></dl>
      <figure slot="media-body">Media/body slot</figure>
      <p slot="limitations">Limitations slot</p>
      <ul slot="related"><li>Related slot</li></ul>
      <div slot="footer">Footer slot</div>
    </EvidenceVisualDetailTemplate>
  </div>

  <div class="atlas-specimen" data-visual-id="AtlasTemplateSpecimen-AboutContactUtility">
    <p class="atlas-specimen__label">AboutContactUtilityTemplate</p>
    <AboutContactUtilityTemplate>
      <div slot="header">Header slot</div>
      <nav slot="breadcrumbs">Breadcrumbs slot</nav>
      <SectionLead slot="lead" title="Utility page" />
      <form slot="records">Records slot</form>
      <div slot="footer">Footer slot</div>
    </AboutContactUtilityTemplate>
  </div>
</section>
