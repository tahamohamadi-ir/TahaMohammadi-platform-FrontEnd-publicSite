---
import GenericCollectionIndex, {
  type GenericCollectionItem,
} from '../generic-collection/GenericCollectionIndex.astro'
import {
  getBooksRouteTitle,
  getBooksUnavailableCopy,
  type BooksIndexModel,
} from '../../lib/books-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: BooksIndexModel
}

const { locale, model } = Astro.props
const items: GenericCollectionItem[] =
  model.status === 'ready'
    ? model.books.map((book) => ({
        slug: book.slug,
        title: book.title,
        meta: book.authors || undefined,
      }))
    : []
---

<GenericCollectionIndex
  locale={locale}
  status={model.status}
  routeTitle={getBooksRouteTitle(locale)}
  summary={locale === 'en'
    ? 'Monographs, edited volumes, and publications in print and digital editions.'
    : 'کتاب‌ها، تک‌نگاری‌ها و مجلدات منتشرشده چاپی و دیجیتال.'}
  unavailableTitle={getBooksUnavailableCopy(locale).title}
  unavailableMessage={getBooksUnavailableCopy(locale).message}
  hrefBase={localePath(locale, 'books')}
  items={items}
/>
