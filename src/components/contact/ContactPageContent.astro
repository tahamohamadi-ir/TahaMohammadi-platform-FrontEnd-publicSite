---
import AboutContactUtilityTemplate from '../templates/AboutContactUtilityTemplate.astro'
import PageFamilyIndexHero from '../page-family/PageFamilyIndexHero.astro'
import ContentState from '../state/ContentState.astro'
import Input from '../ui/Input.astro'
import Textarea from '../ui/Textarea.astro'
import Button from '../ui/Button.astro'
import {
  contactFormCopy,
  formatExternalLinkLabel,
  getContactFormActionUrl,
  getContactRouteTitle,
  getContactUnavailableCopy,
  parseContactFormState,
  type ContactPageModel,
} from '../../lib/contact-content'
import { type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: ContactPageModel
}

const { locale, model } = Astro.props
const emptyCopy = getContactUnavailableCopy(locale)
const formState = parseContactFormState(Astro.url.searchParams)
const topicLabels =
  locale === 'en'
    ? {
        region: 'Discussion topics',
        phd: 'PhD / Research',
        technical: 'Technical work',
        creative: 'Creative work',
        other: 'Other',
        details: 'Contact details',
        email: 'Academic email',
        linkedin: 'LinkedIn',
        orcid: 'ORCID',
      }
    : {
        region: 'موضوعات گفتگو',
        phd: 'دکتری / پژوهش',
        technical: 'کار فنی',
        creative: 'کار خلاقه',
        other: 'سایر',
        details: 'اطلاعات تماس',
        email: 'ایمیل آکادمیک',
        linkedin: 'لینکدین',
        orcid: 'ORCID',
      }
---

{
  model.status === 'unavailable' ? (
    <AboutContactUtilityTemplate class="contact-page contact-page--empty">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="contact"
        portal
        eyebrow={locale === 'en' ? 'Connect' : 'ارتباط'}
        title={getContactRouteTitle(locale)}
      />

      <div slot="records" class="contact-page__sections pf-index-empty__shell">
        <div
          class="contact-page__topics"
          role="group"
          aria-label={topicLabels.region}
          aria-disabled="true"
        >
          <button type="button" class="pf-index-empty__topic-chip" disabled>
            {topicLabels.phd}
          </button>
          <button type="button" class="pf-index-empty__topic-chip" disabled>
            {topicLabels.technical}
          </button>
          <button type="button" class="pf-index-empty__topic-chip" disabled>
            {topicLabels.creative}
          </button>
          <button type="button" class="pf-index-empty__topic-chip" disabled>
            {topicLabels.other}
          </button>
        </div>

        <section
          class="contact-page__section"
          aria-labelledby="contact-details-empty-title"
        >
          <h2
            id="contact-details-empty-title"
            class="contact-page__section-title"
          >
            {topicLabels.details}
          </h2>
          <dl class="contact-page__details pf-index-empty__details-placeholder">
            <div class="contact-page__detail-row">
              <dt>{topicLabels.email}</dt>
              <dd>
                <span class="pf-index-empty__line pf-index-empty__line--medium" />
              </dd>
            </div>
            <div class="contact-page__detail-row">
              <dt>{topicLabels.linkedin}</dt>
              <dd>
                <span class="pf-index-empty__line pf-index-empty__line--medium" />
              </dd>
            </div>
            <div class="contact-page__detail-row">
              <dt>{topicLabels.orcid}</dt>
              <dd>
                <span class="pf-index-empty__line pf-index-empty__line--medium" />
              </dd>
            </div>
          </dl>
        </section>

        <section
          class="contact-page__section"
          aria-labelledby="contact-form-empty-title"
        >
          <h2 id="contact-form-empty-title" class="contact-page__section-title">
            {contactFormCopy.formIntro[locale]}
          </h2>

          <form class="contact-page__form" aria-disabled="true">
            <Input
              id="contact-name-empty"
              name="name"
              label={contactFormCopy.nameLabel[locale]}
              disabled
            />
            <Input
              id="contact-email-empty"
              name="email"
              type="email"
              label={contactFormCopy.emailLabel[locale]}
              disabled
            />
            <Textarea
              id="contact-message-empty"
              name="message"
              label={contactFormCopy.messageLabel[locale]}
              rows={6}
              disabled
            />
            <div class="contact-page__form-actions">
              <Button
                type="button"
                label={contactFormCopy.sendLabel[locale]}
                disabled
              />
            </div>
          </form>
        </section>

        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title={emptyCopy.title}
          message={emptyCopy.message}
        />
      </div>
    </AboutContactUtilityTemplate>
  ) : (
    <AboutContactUtilityTemplate class="contact-page">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="contact"
        eyebrow={locale === 'en' ? 'Connect' : 'ارتباط'}
        title={getContactRouteTitle(locale)}
      />

      <div slot="records" class="contact-page__sections">
        {formState.sent ? (
          <div
            class="contact-page__status contact-page__status--success"
            role="status"
          >
            <h2 class="contact-page__status-title">
              {contactFormCopy.sentHeading[locale]}
            </h2>
          </div>
        ) : null}

        {formState.failed ? (
          <div
            class="contact-page__status contact-page__status--error"
            role="alert"
          >
            <h2 class="contact-page__status-title">
              {contactFormCopy.errorHeading[locale]}
            </h2>
          </div>
        ) : null}

        {model.contact.email ||
        model.contact.linkedin ||
        model.contact.orcid ||
        model.contact.employer ||
        model.contact.location ? (
          <section
            class="contact-page__section"
            aria-labelledby="contact-details-title"
          >
            <h2 id="contact-details-title" class="contact-page__section-title">
              {locale === 'en' ? 'Contact details' : 'اطلاعات تماس'}
            </h2>
            <dl class="contact-page__details">
              {model.contact.email ? (
                <div class="contact-page__detail-row">
                  <dt>{contactFormCopy.detailLabels.email[locale]}</dt>
                  <dd>
                    <a href={`mailto:${model.contact.email}`} dir="ltr">
                      {model.contact.email}
                    </a>
                  </dd>
                </div>
              ) : null}
              {model.contact.linkedin ? (
                <div class="contact-page__detail-row">
                  <dt>{contactFormCopy.detailLabels.linkedin[locale]}</dt>
                  <dd>
                    <a
                      href={model.contact.linkedin}
                      rel="noopener noreferrer"
                      dir="ltr"
                    >
                      {formatExternalLinkLabel(model.contact.linkedin)}
                    </a>
                  </dd>
                </div>
              ) : null}
              {model.contact.orcid ? (
                <div class="contact-page__detail-row">
                  <dt>{contactFormCopy.detailLabels.orcid[locale]}</dt>
                  <dd>
                    <a
                      href={model.contact.orcid}
                      rel="noopener noreferrer"
                      dir="ltr"
                    >
                      {formatExternalLinkLabel(model.contact.orcid)}
                    </a>
                  </dd>
                </div>
              ) : null}
              {model.contact.employer ? (
                <div class="contact-page__detail-row">
                  <dt>{contactFormCopy.detailLabels.employer[locale]}</dt>
                  <dd>
                    {model.contact.employerUrl ? (
                      <a
                        href={model.contact.employerUrl}
                        rel="noopener noreferrer"
                      >
                        {model.contact.employer}
                      </a>
                    ) : (
                      model.contact.employer
                    )}
                  </dd>
                </div>
              ) : null}
              {model.contact.location ? (
                <div class="contact-page__detail-row">
                  <dt>{contactFormCopy.detailLabels.location[locale]}</dt>
                  <dd>{model.contact.location}</dd>
                </div>
              ) : null}
            </dl>
          </section>
        ) : null}

        {model.formEnabled ? (
          <section
            class="contact-page__section"
            aria-labelledby="contact-form-title"
          >
            <h2 id="contact-form-title" class="contact-page__section-title">
              {contactFormCopy.formIntro[locale]}
            </h2>

            <form
              class="contact-page__form"
              method="post"
              action={getContactFormActionUrl()}
              data-contact-form
              novalidate
            >
              <input type="hidden" name="locale" value={locale} />
              <div class="contact-page__honeypot" aria-hidden="true">
                <label for="contact-website">Website</label>
                <input
                  id="contact-website"
                  name="website"
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>

              <Input
                id="contact-name"
                name="name"
                label={contactFormCopy.nameLabel[locale]}
                value={formState.values.name}
                autocomplete="name"
              />
              <Input
                id="contact-email"
                name="email"
                type="email"
                label={contactFormCopy.emailLabel[locale]}
                value={formState.values.email}
                autocomplete="email"
              />
              <Textarea
                id="contact-message"
                name="message"
                label={contactFormCopy.messageLabel[locale]}
                value={formState.values.message}
                rows={6}
                maxlength={4000}
              />

              <div class="contact-page__form-actions">
                <Button
                  type="submit"
                  label={contactFormCopy.sendLabel[locale]}
                />
              </div>

              <p
                class="contact-page__form-note"
                id="contact-form-status"
                hidden
              />
            </form>
          </section>
        ) : null}
      </div>
    </AboutContactUtilityTemplate>
  )
}

<script>
  import { mapContactSubmitResponse } from '../../lib/contact-form-adapter'

  const form = document.querySelector<HTMLFormElement>(
    'form[data-contact-form]',
  )
  if (!form) {
    // No form on this page.
  } else {
    const statusEl = document.getElementById('contact-form-status')
    const locale = (form.querySelector<HTMLInputElement>('input[name="locale"]')
      ?.value ?? 'en') as 'en' | 'fa'

    form.addEventListener('submit', async (event) => {
      if (!window.fetch) return

      event.preventDefault()

      const submitButton = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      )
      submitButton?.setAttribute('disabled', 'true')
      submitButton?.setAttribute('aria-busy', 'true')

      const formData = new FormData(form)
      const fields = {
        name: String(formData.get('name') ?? ''),
        email: String(formData.get('email') ?? ''),
        message: String(formData.get('message') ?? ''),
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            name: fields.name,
            email: fields.email,
            message: fields.message,
            locale,
            website: String(formData.get('website') ?? ''),
          }),
        })

        const bodyText = await response.text()
        const outcome = mapContactSubmitResponse(
          response.status,
          response.headers.get('content-type'),
          bodyText,
          fields,
        )

        if (outcome.kind === 'success') {
          form.reset()
          if (statusEl) {
            statusEl.hidden = false
            statusEl.setAttribute('role', 'status')
            statusEl.textContent =
              locale === 'en' ? 'Your message was sent.' : 'پیام شما ارسال شد.'
          }
        } else if (statusEl) {
          statusEl.hidden = false
          statusEl.setAttribute('role', 'alert')
          statusEl.textContent =
            locale === 'en'
              ? 'Your message could not be sent. Review the fields and try again.'
              : 'پیام ارسال نشد. فیلدها را بررسی کنید و دوباره تلاش کنید.'
        }
      } catch {
        if (statusEl) {
          statusEl.hidden = false
          statusEl.setAttribute('role', 'alert')
          statusEl.textContent =
            locale === 'en'
              ? 'Your message could not be sent. Review the fields and try again.'
              : 'پیام ارسال نشد. فیلدها را بررسی کنید و دوباره تلاش کنید.'
        }
      } finally {
        submitButton?.removeAttribute('disabled')
        submitButton?.removeAttribute('aria-busy')
      }
    })
  }
</script>
