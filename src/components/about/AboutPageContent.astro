---
import AboutContactUtilityTemplate from '../templates/AboutContactUtilityTemplate.astro'
import PageFamilyProfileHeroShell from '../page-family/PageFamilyProfileHeroShell.astro'
import PageFamilySubNavShell from '../page-family/PageFamilySubNavShell.astro'
import PageFamilyHowIWorkShell from '../page-family/PageFamilyHowIWorkShell.astro'
import PageFamilyJourneyFlowShell from '../page-family/PageFamilyJourneyFlowShell.astro'
import PageFamilySplitTimelineShell from '../page-family/PageFamilySplitTimelineShell.astro'
import PageFamilySkillsGridShell from '../page-family/PageFamilySkillsGridShell.astro'
import PageFamilySelectedOutputsShell from '../page-family/PageFamilySelectedOutputsShell.astro'
import PageFamilyDownloadListShell from '../page-family/PageFamilyDownloadListShell.astro'
import PageFamilyCollaborateBandShell from '../page-family/PageFamilyCollaborateBandShell.astro'
import ContentState from '../state/ContentState.astro'
import {
  getAboutUnavailableCopy,
  splitBodyParagraphs,
  type AboutPageModel,
} from '../../lib/about-profile'
import { getAboutSubNavLabels } from '../../lib/page-family-empty-chrome'
import { type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: AboutPageModel
}

const { locale, model } = Astro.props
const emptyCopy = getAboutUnavailableCopy(locale)
const subNavLabels = getAboutSubNavLabels(locale)
const tabRegion = locale === 'en' ? 'About profile sections' : 'بخش‌های پروفایل'
const sectionLabels =
  locale === 'en'
    ? {
        intro: 'Introduction',
        engineering: 'Engineering',
        education: 'Education',
        experience: 'Experience',
      }
    : {
        intro: 'معرفی',
        engineering: 'مهندسی',
        education: 'تحصیلات',
        experience: 'تجربه',
      }
---

{
  model.status === 'unavailable' ? (
    <AboutContactUtilityTemplate class="about-page about-page--empty">
      <PageFamilyProfileHeroShell slot="lead" locale={locale} family="about" />

      <div slot="records" class="about-page__sections pf-index-empty__shell">
        <PageFamilySubNavShell
          locale={locale}
          labels={subNavLabels}
          regionLabel={tabRegion}
        />

        <PageFamilyHowIWorkShell locale={locale} />
        <PageFamilyJourneyFlowShell locale={locale} />
        <PageFamilySplitTimelineShell locale={locale} />
        <PageFamilySkillsGridShell locale={locale} />
        <PageFamilySelectedOutputsShell locale={locale} />
        <PageFamilyDownloadListShell locale={locale} />
        <PageFamilyCollaborateBandShell
          locale={locale}
          variant="dual"
          context="about"
        />

        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title={emptyCopy.title}
          message={emptyCopy.message}
        />
      </div>
    </AboutContactUtilityTemplate>
  ) : (
    <AboutContactUtilityTemplate class="about-page">
      <PageFamilyProfileHeroShell
        slot="lead"
        locale={locale}
        family="about"
        eyebrow={locale === 'en' ? 'Profile' : 'پروفایل'}
        title={model.profile.title}
        summary={model.profile.excerpt ?? undefined}
      />

      <div slot="records" class="about-page__sections">
        {model.profile.body ? (
          <section
            id="about-intro"
            class="about-page__section"
            aria-labelledby="about-intro-title"
          >
            <h2 id="about-intro-title" class="about-page__section-title">
              {sectionLabels.intro}
            </h2>
            <div class="about-page__prose">
              {splitBodyParagraphs(model.profile.body).map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        ) : null}

        {model.profile.engineering_body ? (
          <section
            id="about-engineering"
            class="about-page__section"
            aria-labelledby="about-engineering-title"
          >
            <h2 id="about-engineering-title" class="about-page__section-title">
              {model.profile.engineering_title ?? sectionLabels.engineering}
            </h2>
            <div class="about-page__prose">
              {splitBodyParagraphs(model.profile.engineering_body).map(
                (paragraph) => (
                  <p>{paragraph}</p>
                ),
              )}
            </div>
          </section>
        ) : null}

        {model.profile.education?.length ? (
          <section
            id="about-education"
            class="about-page__section"
            aria-labelledby="about-education-title"
          >
            <h2 id="about-education-title" class="about-page__section-title">
              {sectionLabels.education}
            </h2>
            <ol class="about-page__timeline">
              {model.profile.education.map((entry) => (
                <li>
                  <article class="about-page__entry">
                    <h3 class="about-page__entry-title">{entry.title}</h3>
                    {entry.institution ? (
                      <p class="about-page__entry-meta">{entry.institution}</p>
                    ) : null}
                    {entry.period ? (
                      <p class="about-page__entry-meta">{entry.period}</p>
                    ) : null}
                    {entry.summary ? (
                      <p class="about-page__entry-summary">{entry.summary}</p>
                    ) : null}
                  </article>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        {model.profile.experience?.length ? (
          <section
            id="about-experience"
            class="about-page__section"
            aria-labelledby="about-experience-title"
          >
            <h2 id="about-experience-title" class="about-page__section-title">
              {sectionLabels.experience}
            </h2>
            <ol class="about-page__timeline">
              {model.profile.experience.map((entry) => (
                <li>
                  <article class="about-page__entry">
                    <h3 class="about-page__entry-title">{entry.title}</h3>
                    {entry.organization ? (
                      <p class="about-page__entry-meta">{entry.organization}</p>
                    ) : null}
                    {entry.period ? (
                      <p class="about-page__entry-meta">{entry.period}</p>
                    ) : null}
                    {entry.summary ? (
                      <p class="about-page__entry-summary">{entry.summary}</p>
                    ) : null}
                  </article>
                </li>
              ))}
            </ol>
          </section>
        ) : null}
      </div>
    </AboutContactUtilityTemplate>
  )
}
