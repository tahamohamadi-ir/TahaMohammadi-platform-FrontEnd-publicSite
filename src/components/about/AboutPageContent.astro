---
import AboutContactUtilityTemplate from '../templates/AboutContactUtilityTemplate.astro'
import PageFamilyProfileHeroShell from '../page-family/PageFamilyProfileHeroShell.astro'
import AboutAtlasPreview from './AboutAtlasPreview.astro'
import ContentState from '../state/ContentState.astro'
import {
  getAboutUnavailableCopy,
  splitBodyParagraphs,
  type AboutPageModel,
} from '../../lib/about-profile'
import type { AtlasSnapshot } from '../../lib/atlas/snapshot'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: AboutPageModel
  /**
   * Optional Atlas snapshot for tests / callers that already loaded one.
   * When omitted, AboutAtlasPreview fetches via the Plan C snapshot path.
   */
  atlasSnapshot?: AtlasSnapshot
}

const { locale, model, atlasSnapshot } = Astro.props
const emptyCopy = getAboutUnavailableCopy(locale)
const sectionLabels =
  locale === 'en'
    ? {
        intro: 'Introduction',
        engineering: 'Engineering',
        education: 'Education',
        experience: 'Experience',
      }
    : {
        intro: 'معرفی',
        engineering: 'مهندسی',
        education: 'تحصیلات',
        experience: 'تجربه',
      }
---

{
  model.status === 'unavailable' ? (
    <div class="about-page about-page--unavailable">
      <ContentState
        variant="unavailable"
        locale={locale}
        headingLevel="h1"
        title={emptyCopy.title}
        message={emptyCopy.message}
        actionLabel={locale === 'en' ? 'Back to home' : 'بازگشت به خانه'}
        actionHref={localePath(locale, 'home')}
      />
      {/* The Atlas preview is real, independently-loaded content with its
        own honest states (ready/unavailable) — not fake profile chrome —
        so it stays visible even when the profile text itself is not. */}
      <AboutAtlasPreview locale={locale} snapshot={atlasSnapshot} />
    </div>
  ) : (
    <AboutContactUtilityTemplate class="about-page">
      <PageFamilyProfileHeroShell
        slot="lead"
        locale={locale}
        family="about"
        eyebrow={locale === 'en' ? 'Profile' : 'پروفایل'}
        title={model.profile.title}
        summary={model.profile.excerpt ?? undefined}
      />

      <div slot="records" class="about-page__sections">
        <AboutAtlasPreview locale={locale} snapshot={atlasSnapshot} />

        {model.profile.body ? (
          <section
            id="about-intro"
            class="about-page__section"
            aria-labelledby="about-intro-title"
          >
            <h2 id="about-intro-title" class="about-page__section-title">
              {sectionLabels.intro}
            </h2>
            <div class="about-page__prose">
              {splitBodyParagraphs(model.profile.body).map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        ) : null}

        {model.profile.engineering_body ? (
          <section
            id="about-engineering"
            class="about-page__section"
            aria-labelledby="about-engineering-title"
          >
            <h2 id="about-engineering-title" class="about-page__section-title">
              {model.profile.engineering_title ?? sectionLabels.engineering}
            </h2>
            <div class="about-page__prose">
              {splitBodyParagraphs(model.profile.engineering_body).map(
                (paragraph) => (
                  <p>{paragraph}</p>
                ),
              )}
            </div>
          </section>
        ) : null}

        {model.profile.education?.length ? (
          <section
            id="about-education"
            class="about-page__section"
            aria-labelledby="about-education-title"
          >
            <h2 id="about-education-title" class="about-page__section-title">
              {sectionLabels.education}
            </h2>
            <ol class="about-page__timeline">
              {model.profile.education.map((entry) => (
                <li>
                  <article class="about-page__entry">
                    <h3 class="about-page__entry-title">{entry.title}</h3>
                    {entry.institution ? (
                      <p class="about-page__entry-meta">{entry.institution}</p>
                    ) : null}
                    {entry.period ? (
                      <p class="about-page__entry-meta">{entry.period}</p>
                    ) : null}
                    {entry.summary ? (
                      <p class="about-page__entry-summary">{entry.summary}</p>
                    ) : null}
                  </article>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        {model.profile.experience?.length ? (
          <section
            id="about-experience"
            class="about-page__section"
            aria-labelledby="about-experience-title"
          >
            <h2 id="about-experience-title" class="about-page__section-title">
              {sectionLabels.experience}
            </h2>
            <ol class="about-page__timeline">
              {model.profile.experience.map((entry) => (
                <li>
                  <article class="about-page__entry">
                    <h3 class="about-page__entry-title">{entry.title}</h3>
                    {entry.organization ? (
                      <p class="about-page__entry-meta">{entry.organization}</p>
                    ) : null}
                    {entry.period ? (
                      <p class="about-page__entry-meta">{entry.period}</p>
                    ) : null}
                    {entry.summary ? (
                      <p class="about-page__entry-summary">{entry.summary}</p>
                    ) : null}
                  </article>
                </li>
              ))}
            </ol>
          </section>
        ) : null}
      </div>
    </AboutContactUtilityTemplate>
  )
}
