---
import AboutContactUtilityTemplate from '../templates/AboutContactUtilityTemplate.astro'
import PageFamilyProfileHeroShell from '../page-family/PageFamilyProfileHeroShell.astro'
import PageFamilySubNavShell from '../page-family/PageFamilySubNavShell.astro'
import PageFamilySkillsGridShell from '../page-family/PageFamilySkillsGridShell.astro'
import PageFamilySelectedOutputsShell from '../page-family/PageFamilySelectedOutputsShell.astro'
import PageFamilyDownloadListShell from '../page-family/PageFamilyDownloadListShell.astro'
import PageFamilyCollaborateBandShell from '../page-family/PageFamilyCollaborateBandShell.astro'
import ContentState from '../state/ContentState.astro'
import Link from '../ui/Link.astro'
import {
  formatDownloadMeta,
  getCvUnavailableCopy,
  type CvPageModel,
} from '../../lib/cv-content'
import { getAboutSubNavLabels } from '../../lib/page-family-empty-chrome'
import { type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: CvPageModel
}

const { locale, model } = Astro.props
const emptyCopy = getCvUnavailableCopy(locale)
const subNavLabels = getAboutSubNavLabels(locale)
const tabRegion = locale === 'en' ? 'CV sections' : 'بخش‌های رزومه'
---

{
  model.status === 'unavailable' ? (
    <AboutContactUtilityTemplate class="cv-page cv-page--empty">
      <PageFamilyProfileHeroShell
        slot="lead"
        locale={locale}
        family="cv"
        eyebrow={locale === 'en' ? 'Documents' : 'اسناد'}
      />

      <div slot="records" class="cv-page__sections pf-index-empty__shell">
        <PageFamilySubNavShell
          locale={locale}
          labels={subNavLabels}
          regionLabel={tabRegion}
          activeIndex={5}
        />
        <PageFamilySkillsGridShell locale={locale} />
        <PageFamilySelectedOutputsShell locale={locale} />
        <PageFamilyDownloadListShell locale={locale} count={3} />
        <PageFamilyCollaborateBandShell
          locale={locale}
          variant="dual"
          context="about"
        />

        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title={emptyCopy.title}
          message={emptyCopy.message}
        />
      </div>
    </AboutContactUtilityTemplate>
  ) : (
    <AboutContactUtilityTemplate class="cv-page">
      <PageFamilyProfileHeroShell
        slot="lead"
        locale={locale}
        family="cv"
        eyebrow={locale === 'en' ? 'Documents' : 'اسناد'}
      />

      <div slot="records" class="cv-page__sections">
        <section class="cv-page__section" aria-labelledby="cv-downloads-title">
          <h2 id="cv-downloads-title" class="cv-page__section-title">
            {locale === 'en' ? 'Downloads' : 'دانلودها'}
          </h2>
          <ul class="cv-page__list">
            {model.downloads.map((download) => (
              <li>
                <article class="cv-page__card">
                  <h3 class="cv-page__card-title">{download.title}</h3>
                  {download.note ? (
                    <p class="cv-page__card-note">{download.note}</p>
                  ) : null}
                  <p class="cv-page__card-meta">
                    {formatDownloadMeta(download)}
                  </p>
                  <p class="cv-page__card-action">
                    <Link
                      href={download.href}
                      label={locale === 'en' ? 'Download file' : 'دانلود فایل'}
                      variant="standalone"
                      showIcon
                    />
                  </p>
                </article>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </AboutContactUtilityTemplate>
  )
}
