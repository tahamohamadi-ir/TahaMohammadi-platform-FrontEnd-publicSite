---
import AboutContactUtilityTemplate from '../templates/AboutContactUtilityTemplate.astro';
import SectionLead from '../ui/SectionLead.astro';
import ContentState from '../state/ContentState.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
import {
  buildSearchPageHref,
  getSearchBundlePath,
  getSearchRouteTitle,
  parseSearchQuery,
  searchCopy,
  searchQueryParam,
} from '../../lib/search-content';
import { localePath, type Locale } from '../../lib/navigation';

interface Props {
  locale: Locale;
  /** Test hook — defaults to the current request query string. */
  initialQuery?: string;
}

const { locale, initialQuery: initialQueryProp } = Astro.props;
const homeHref = localePath(locale);
const searchHref = localePath(locale, 'search');
const initialQuery = initialQueryProp ?? parseSearchQuery(Astro.url.searchParams);
const routeTitle = getSearchRouteTitle(locale);
const bundlePath = getSearchBundlePath(locale);
---

<div class="search-page" data-pagefind-ignore>
  <AboutContactUtilityTemplate class="search-page__template">
    <SectionLead
      slot="lead"
      eyebrow={locale === 'en' ? 'Utility' : 'ابزار'}
      title={routeTitle}
      summary={searchCopy.summary[locale]}
    />

    <div slot="records" class="search-page__panel">
      <form
        class="search-page__form"
        method="get"
        action={searchHref}
        role="search"
        data-search-form
      >
        <Input
          id="search-query"
          name={searchQueryParam}
          type="search"
          label={searchCopy.queryLabel[locale]}
          value={initialQuery}
          autocomplete="off"
        />
        <Button type="submit" label={searchCopy.submitLabel[locale]} />
      </form>

      <noscript>
        {
          initialQuery ? (
            <ContentState
              variant="unavailable"
              locale={locale}
              headingLevel="h2"
              title={searchCopy.noscript.title[locale]}
              message={searchCopy.noscript.message[locale]}
              actionLabel={locale === 'en' ? 'Back to home' : 'بازگشت به صفحهٔ اصلی'}
              actionHref={homeHref}
            />
          ) : null
        }
      </noscript>

      <div class="search-page__results" data-search-results hidden={initialQuery ? undefined : true}>
        {
          initialQuery ? (
            <div data-search-loading hidden={false}>
              <ContentState
                variant="loading"
                locale={locale}
                headingLevel="h2"
                title={searchCopy.loading.title[locale]}
                message={searchCopy.loading.message[locale]}
                class="search-page__loading"
              />
            </div>
          ) : null
        }

        <section
          class="search-page__results-body"
          data-search-results-body
          hidden
          aria-live="polite"
          aria-labelledby="search-results-title"
        >
          <h2 id="search-results-title" class="search-page__results-title">
            {searchCopy.resultsHeading[locale]}
          </h2>
          <ol class="search-page__results-list" data-search-results-list></ol>
        </section>

        <div data-search-no-results hidden>
          <ContentState
            variant="no-results"
            locale={locale}
            headingLevel="h2"
            title={searchCopy.noResults.title[locale]}
            message={searchCopy.noResults.message[locale]}
            actionLabel={locale === 'en' ? 'Back to home' : 'بازگشت به صفحهٔ اصلی'}
            actionHref={homeHref}
            class="search-page__no-results"
          />
        </div>

        <div data-search-index-unavailable hidden>
          <ContentState
            variant="unavailable"
            locale={locale}
            headingLevel="h2"
            title={searchCopy.indexUnavailable.title[locale]}
            message={searchCopy.indexUnavailable.message[locale]}
            actionLabel={locale === 'en' ? 'Back to home' : 'بازگشت به صفحهٔ اصلی'}
            actionHref={homeHref}
            class="search-page__index-unavailable"
          />
        </div>
      </div>
    </div>
  </AboutContactUtilityTemplate>
</div>

<script define:vars={{ initialQuery, locale, searchHref, searchQueryParam, bundlePath }}>
  const form = document.querySelector('[data-search-form]');
  const resultsRoot = document.querySelector('[data-search-results]');
  const loadingState = document.querySelector('[data-search-loading]');
  const resultsBody = document.querySelector('[data-search-results-body]');
  const resultsList = document.querySelector('[data-search-results-list]');
  const noResultsState = document.querySelector('[data-search-no-results]');
  const indexUnavailableState = document.querySelector('[data-search-index-unavailable]');

  function setHidden(element, hidden) {
    if (!element) return;
    element.hidden = hidden;
  }

  function showState(state) {
    setHidden(loadingState, state !== 'loading');
    setHidden(resultsBody, state !== 'ready');
    setHidden(noResultsState, state !== 'no-results');
    setHidden(indexUnavailableState, state !== 'unavailable');
    if (resultsRoot) resultsRoot.hidden = state === 'idle';
  }

  function syncQueryToUrl(query) {
    const url = new URL(window.location.href);
    const trimmed = query.trim();
    if (trimmed) {
      url.searchParams.set(searchQueryParam, trimmed);
    } else {
      url.searchParams.delete(searchQueryParam);
    }
    window.history.replaceState({}, '', url);
  }

  function renderResults(items) {
    if (!resultsList) return;
    resultsList.replaceChildren();
    for (const item of items) {
      const li = document.createElement('li');
      li.className = 'search-page__result';
      const link = document.createElement('a');
      link.className = 'search-page__result-link';
      link.href = item.url;
      link.textContent = item.title;
      const excerpt = document.createElement('p');
      excerpt.className = 'search-page__result-excerpt';
      excerpt.textContent = item.excerpt;
      li.append(link, excerpt);
      resultsList.append(li);
    }
  }

  async function runSearch(query) {
    const trimmed = query.trim();
    if (!trimmed) {
      showState('idle');
      return;
    }

    showState('loading');

    try {
      const pagefind = await import(`${bundlePath}/pagefind.js`);
      await pagefind.init();
      const response = await pagefind.search(trimmed);
      const data = await response.results.slice(0, 12).reduce(async (accPromise, result) => {
        const acc = await accPromise;
        const record = await result.data();
        acc.push({
          url: record.url,
          title: record.meta.title || record.url,
          excerpt: record.excerpt || '',
        });
        return acc;
      }, Promise.resolve([]));

      if (!data.length) {
        showState('no-results');
        return;
      }

      renderResults(data);
      showState('ready');
    } catch {
      showState('unavailable');
    }
  }

  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const field = form.elements.namedItem(searchQueryParam);
      const query = field instanceof HTMLInputElement ? field.value : '';
      syncQueryToUrl(query);
      void runSearch(query);
    });
  }

  if (initialQuery) {
    showState('loading');
    void runSearch(initialQuery);
  } else {
    showState('idle');
  }
</script>
