---
import CollectionIndexTemplate from '../templates/CollectionIndexTemplate.astro'
import PageFamilyIndexHero from '../page-family/PageFamilyIndexHero.astro'
import ContentState from '../state/ContentState.astro'
import {
  formatProjectAvailability,
  formatProjectType,
  getProjectsRouteTitle,
  getProjectsUnavailableCopy,
  type ProjectsIndexModel,
} from '../../lib/projects-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: ProjectsIndexModel
}

const { locale, model } = Astro.props
const emptyCopy = getProjectsUnavailableCopy(locale)
---

{
  model.status === 'unavailable' ? (
    <div class="projects-page projects-page--unavailable">
      <ContentState
        variant="unavailable"
        locale={locale}
        headingLevel="h1"
        title={emptyCopy.title}
        message={emptyCopy.message}
        actionLabel={locale === 'en' ? 'Back to home' : 'بازگشت به خانه'}
        actionHref={localePath(locale, 'home')}
      />
    </div>
  ) : (
    <CollectionIndexTemplate class="projects-page">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="projects"
        eyebrow={locale === 'en' ? 'Selected evidence' : 'شواهد منتخب'}
        title={getProjectsRouteTitle(locale)}
      />

      <ul slot="records" class="projects-page__list">
        {model.projects.map((project) => (
          <li>
            <article class="projects-page__card" data-glow-card>
              <h2 class="projects-page__card-title">
                <a
                  href={localePath(locale, `projects/${project.slug}`)}
                  class="projects-page__card-link card-stretch-link"
                >
                  {project.title}
                </a>
              </h2>
              {project.objective ? (
                <p class="projects-page__card-summary">{project.objective}</p>
              ) : null}
              {(() => {
                const meta = [
                  formatProjectType(project.project_type, locale),
                  formatProjectAvailability(project, locale),
                ]
                  .filter(Boolean)
                  .join(' · ')
                return meta ? (
                  <p class="projects-page__card-meta">{meta}</p>
                ) : null
              })()}
            </article>
          </li>
        ))}
      </ul>
    </CollectionIndexTemplate>
  )
}
