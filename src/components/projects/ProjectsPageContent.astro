---
import CollectionIndexTemplate from '../templates/CollectionIndexTemplate.astro'
import PageFamilyIndexHero from '../page-family/PageFamilyIndexHero.astro'
import PageFamilyFeaturedShell from '../page-family/PageFamilyFeaturedShell.astro'
import PageFamilyContentRowPlaceholder from '../page-family/PageFamilyContentRowPlaceholder.astro'
import PageFamilySortShell from '../page-family/PageFamilySortShell.astro'
import PageFamilyPaginationShell from '../page-family/PageFamilyPaginationShell.astro'
import ContentState from '../state/ContentState.astro'
import {
  formatProjectAvailability,
  getProjectsRouteTitle,
  getProjectsUnavailableCopy,
  type ProjectsIndexModel,
} from '../../lib/projects-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: ProjectsIndexModel
}

const { locale, model } = Astro.props
const emptyCopy = getProjectsUnavailableCopy(locale)
const filterLabels =
  locale === 'en'
    ? {
        region: 'Project filters',
        allProjects: 'All projects',
        research: 'Research',
        ai: 'AI',
        dataSystems: 'Data systems',
        software: 'Software',
        design: 'Design',
        search: 'Search projects…',
      }
    : {
        region: 'پالایش پروژه‌ها',
        allProjects: 'همه پروژه‌ها',
        research: 'پژوهش',
        ai: 'هوش مصنوعی',
        dataSystems: 'سامانه‌های داده',
        software: 'نرم‌افزار',
        design: 'طراحی',
        search: 'جستجوی پروژه‌ها…',
      }
---

{
  model.status === 'unavailable' ? (
    <CollectionIndexTemplate class="projects-page projects-page--empty">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="projects"
        eyebrow={locale === 'en' ? 'Selected evidence' : 'شواهد منتخب'}
        title={getProjectsRouteTitle(locale)}
      />

      <PageFamilyFeaturedShell
        slot="featured"
        locale={locale}
        family="projects"
      />

      <div
        slot="filters"
        class="projects-page__filters pf-index-empty__filters"
        role="group"
        aria-label={filterLabels.region}
        aria-disabled="true"
      >
        <p class="projects-page__filters-active">{filterLabels.allProjects}</p>
        <div class="projects-page__filters-controls">
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.research}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.ai}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.dataSystems}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.software}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.design}
          </button>
        </div>
        <input
          type="search"
          class="projects-page__search pf-index-empty__search"
          placeholder={filterLabels.search}
          disabled
          aria-hidden="true"
          tabindex="-1"
        />
        <PageFamilySortShell locale={locale} />
      </div>

      <div
        slot="records"
        class="projects-page__grid-shell pf-index-empty__shell"
      >
        <PageFamilyContentRowPlaceholder
          locale={locale}
          family="projects"
          count={4}
          variant="project"
        />
        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title={emptyCopy.title}
          message={emptyCopy.message}
        />
      </div>

      <PageFamilyPaginationShell slot="pagination" locale={locale} />
    </CollectionIndexTemplate>
  ) : (
    <CollectionIndexTemplate class="projects-page">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="projects"
        eyebrow={locale === 'en' ? 'Selected evidence' : 'شواهد منتخب'}
        title={getProjectsRouteTitle(locale)}
      />

      <ul slot="records" class="projects-page__list">
        {model.projects.map((project) => (
          <li>
            <article class="projects-page__card">
              <h2 class="projects-page__card-title">
                <a
                  href={localePath(locale, `projects/${project.slug}`)}
                  class="projects-page__card-link"
                >
                  {project.title}
                </a>
              </h2>
              {project.objective ? (
                <p class="projects-page__card-summary">{project.objective}</p>
              ) : null}
              <p class="projects-page__card-meta">
                {[project.project_type, formatProjectAvailability(project)]
                  .filter(Boolean)
                  .join(' · ')}
              </p>
            </article>
          </li>
        ))}
      </ul>
    </CollectionIndexTemplate>
  )
}
