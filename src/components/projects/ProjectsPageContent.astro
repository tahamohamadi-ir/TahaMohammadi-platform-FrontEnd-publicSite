---
import CollectionIndexTemplate from '../templates/CollectionIndexTemplate.astro';
import SectionLead from '../ui/SectionLead.astro';
import ContentState from '../state/ContentState.astro';
import {
  formatProjectAvailability,
  getProjectsRouteTitle,
  getProjectsUnavailableCopy,
  type ProjectsIndexModel,
} from '../../lib/projects-content';
import { localePath, type Locale } from '../../lib/navigation';

interface Props {
  locale: Locale;
  model: ProjectsIndexModel;
}

const { locale, model } = Astro.props;
const homeHref = localePath(locale);
---

{
  model.status === 'unavailable' ? (
    <div class="projects-page projects-page--unavailable">
      <ContentState
        variant="unavailable"
        locale={locale}
        headingLevel="h1"
        title={getProjectsUnavailableCopy(locale).title}
        message={getProjectsUnavailableCopy(locale).message}
        actionLabel={locale === 'en' ? 'Back to home' : 'بازگشت به صفحهٔ اصلی'}
        actionHref={homeHref}
      />
    </div>
  ) : (
    <CollectionIndexTemplate class="projects-page">
      <SectionLead
        slot="lead"
        eyebrow={locale === 'en' ? 'Systems & case studies' : 'سامانه‌ها و مطالعات موردی'}
        title={getProjectsRouteTitle(locale)}
      />

      <ul slot="records" class="projects-page__list">
        {model.projects.map((project) => (
          <li>
            <article class="projects-page__card">
              <h2 class="projects-page__card-title">
                <a href={localePath(locale, `projects/${project.slug}`)} class="projects-page__card-link">
                  {project.title}
                </a>
              </h2>
              {project.objective ? <p class="projects-page__card-summary">{project.objective}</p> : null}
              <p class="projects-page__card-meta">
                {[project.project_type, formatProjectAvailability(project)].filter(Boolean).join(' · ')}
              </p>
            </article>
          </li>
        ))}
      </ul>
    </CollectionIndexTemplate>
  )
}
