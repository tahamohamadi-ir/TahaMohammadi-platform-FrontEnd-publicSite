---
/**
 * Atlas page composition (Plan C Task 6 + Task 8 preview flag).
 * Body markup comes from `buildSharedAtlasBodyHtml` so public and preview
 * shells share one presentation path. Authorization is never performed here.
 */
import { buildSharedAtlasBodyHtml } from '../../lib/atlas/presentation'
import type { AtlasSnapshot } from '../../lib/atlas/snapshot'
import type { Locale } from '../../lib/navigation'
import AtlasControls from './AtlasControls.astro'
import AtlasInspector from './AtlasInspector.astro'
import AtlasProjection2d from './AtlasProjection2d.astro'

interface Props {
  locale: Locale
  snapshot: AtlasSnapshot
  /** True only when a validated draft preview payload is being shown. */
  preview?: boolean
  /** Optional owner-facing label; never names a draft or capability. */
  previewLabel?: string
}

const { locale, snapshot, preview = false, previewLabel } = Astro.props
const copy =
  locale === 'en'
    ? {
        eyebrow: 'Knowledge graph',
        title: 'Knowledge Atlas',
        lead: 'Every domain, project and publication — one navigable map.',
      }
    : {
        eyebrow: 'نقشه دانش',
        title: 'اطلس دانش',
        lead: 'همه حوزه‌ها، پروژه‌ها و انتشارها — یک نقشه قابل پیمایش.',
      }

const status = snapshot.status
const revision =
  status === 'ready' ? snapshot.payload.version.revision : undefined
const etag = status === 'ready' ? snapshot.etag : undefined
const bodyHtml = buildSharedAtlasBodyHtml(locale, snapshot)
---

<section
  class="atlas"
  data-atlas-region
  data-atlas-status={status}
  data-atlas-presentation="list"
  data-atlas-revision={revision}
  data-atlas-etag={etag}
  data-atlas-preview={preview ? 'true' : 'false'}
>
  <header class="atlas__header">
    <p class="atlas__eyebrow">{copy.eyebrow}</p>
    <h1 class="atlas__title">{copy.title}</h1>
    <p class="atlas__lead">{copy.lead}</p>
    {previewLabel ? <p class="atlas__preview-label">{previewLabel}</p> : null}
  </header>
  {
    snapshot.status === 'ready' ? (
      <AtlasControls payload={snapshot.payload} locale={locale} />
    ) : null
  }
  {
    snapshot.status === 'ready' ? (
      <div class="atlas__stage" data-atlas-stage>
        <div class="atlas__projection" data-atlas-projection-container>
          <AtlasProjection2d
            payload={snapshot.payload}
            mode="mobile-overview"
            viewport={{ width: 390, height: 520 }}
          />
        </div>
        <div class="atlas__labels" data-atlas-labels aria-hidden="true" />
        <div class="atlas__body" data-atlas-body set:html={bodyHtml} />
        <AtlasInspector payload={snapshot.payload} locale={locale} />
      </div>
    ) : (
      <div data-atlas-body set:html={bodyHtml} />
    )
  }
</section>

<script>
  import { enhanceAtlasRegion } from '../../lib/visual/atlas/enhancement'

  const region = document.querySelector<HTMLElement>('[data-atlas-region]')
  if (region?.getAttribute('data-atlas-status') === 'ready') {
    void enhanceAtlasRegion(region)
  }
</script>

<style>
  .atlas__stage {
    --atlas-effective-viewport-width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
    min-block-size: 38rem;
    position: relative;
  }

  .atlas__body {
    min-inline-size: 0;
  }

  .atlas__projection {
    display: none;
    min-inline-size: 0;
  }

  :global(.atlas[data-atlas-presentation='2d']) .atlas__projection {
    display: block;
    grid-column: 1;
    grid-row: 1;
  }

  :global(.atlas[data-atlas-presentation='2d']) .atlas__body {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  :global(.atlas[data-atlas-presentation='2d'] .atlas-inspector) {
    grid-column: 2;
    grid-row: 1;
  }

  :global(.atlas__canvas),
  .atlas__labels {
    block-size: 100%;
    inline-size: var(--atlas-effective-viewport-width);
    inset-block-start: 0;
    inset-inline-start: 0;
    pointer-events: none;
    position: absolute;
  }

  .atlas__labels {
    z-index: 2;
  }

  :global(.atlas-label) {
    position: absolute;
    transform: translate(-50%, calc(-100% - var(--ru-node-radius, 0px)));
  }

  :global(.atlas[data-atlas-presentation='3d'] .atlas-index) {
    visibility: hidden;
  }

  @media (max-width: 1023px) {
    .atlas__stage {
      display: flex;
      flex-direction: column;
      min-block-size: 0;
    }

    .atlas__projection {
      display: block;
      order: 1;
    }

    :global(.atlas-inspector) {
      order: 2;
    }

    .atlas__body {
      order: 3;
    }
  }
</style>
