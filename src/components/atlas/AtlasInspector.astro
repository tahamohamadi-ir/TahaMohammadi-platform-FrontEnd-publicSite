---
/**
 * Deferred Atlas inspector shell (Plan D Phase 2).
 * Panels are mounted client-side on selection so SSR stays under §19.2 DOM.
 */
import { nodeInspectorModel } from '../../lib/atlas/inspector'
import type { AtlasLocale, AtlasPayload } from '../../lib/atlas/model'

interface Props {
  payload: AtlasPayload
  locale?: AtlasLocale
}

const { payload, locale = payload.locale } = Astro.props
const localizedPayload =
  payload.locale === locale ? payload : { ...payload, locale }
const prompt = nodeInspectorModel(localizedPayload, '').prompt
const copy =
  locale === 'en'
    ? {
        heading: 'Inspector',
      }
    : {
        heading: 'بازرس',
      }
---

<aside
  class="atlas-inspector"
  aria-labelledby="atlas-inspector-heading"
  data-atlas-inspector
>
  <h2 id="atlas-inspector-heading">{copy.heading}</h2>
  <p class="atlas-inspector__prompt" data-atlas-inspector-prompt>
    {prompt}
  </p>
  <p
    class="atlas-inspector__announcement"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    data-atlas-announcement
  >
  </p>
  <div data-atlas-inspector-mount></div>
</aside>

<style>
  .atlas-inspector {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    overflow: auto;
  }

  .atlas-inspector__prompt {
    margin: 0;
  }

  .atlas-inspector__announcement {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .atlas-inspector :global(.atlas-inspector__panel) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .atlas-inspector :global(.atlas-inspector__section h4) {
    margin: 0 0 0.35rem;
    font-size: 0.875rem;
  }

  .atlas-inspector :global(.atlas-inspector__section ul) {
    margin: 0;
    padding-inline-start: 1.1rem;
  }
</style>
