---
/** Presentation-only SVG for the deterministic Atlas 2D projection. */
import type { AtlasPayload } from '../../lib/atlas/model'
import {
  project2d,
  type Projection2dMode,
  type Projection2dViewMode,
  type Projection2dViewport,
} from '../../lib/atlas/projection-2d'

interface Props {
  payload: AtlasPayload
  mode: Projection2dMode
  viewport?: Projection2dViewport
  focusKey?: string | null
  viewMode?: Projection2dViewMode
}

const {
  payload,
  mode,
  viewport = { width: 960, height: 640 },
  focusKey = null,
  viewMode = 'overview',
} = Astro.props
const projection = project2d(payload, { mode, viewport, focusKey, viewMode })
const nodes = new Map(payload.nodes.map((node) => [node.key, node]))

function escapeSvgText(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;')
}

function accessibleSvgLabel(value: string): string {
  return value.replace(/[<>]/g, ' ')
}
---

<svg
  class="atlas-projection"
  viewBox={projection.viewBox}
  role="group"
  data-atlas-projection={mode}
  data-atlas-view={viewMode}
  data-atlas-viewport-width={viewport.width}
  data-atlas-viewport-height={viewport.height}
>
  <g class="atlas-projection__edges">
    {
      projection.edges.map((edge) => (
        <path
          class="atlas-projection__edge"
          data-atlas-edge={edge.key}
          d={edge.path}
        />
      ))
    }
  </g>
  <g class="atlas-projection__nodes">
    {
      projection.nodes.map((node) => (
        <g
          class="atlas-projection__node"
          data-atlas-node={node.key}
          data-atlas-tier={node.tier}
          transform={`translate(${node.cx} ${node.cy})`}
          role="button"
          tabindex="0"
          aria-label={accessibleSvgLabel(
            nodes.get(node.key)?.accessibleLabel ??
              nodes.get(node.key)?.label ??
              node.key,
          )}
        >
          <circle
            class="atlas-projection__hit-target"
            cx="0"
            cy="0"
            r={Math.max(22, node.r)}
          />
          <circle cx="0" cy="0" r={node.r} />
          <text
            x={node.labelOffset.dx}
            y={node.labelOffset.dy}
            set:html={escapeSvgText(nodes.get(node.key)?.label ?? node.key)}
          />
        </g>
      ))
    }
  </g>
</svg>

<style is:global>
  .atlas-projection {
    display: block;
    inline-size: 100%;
  }

  .atlas-projection__node {
    cursor: pointer;
  }

  .atlas-projection__hit-target {
    fill: transparent;
    pointer-events: all;
  }
</style>
