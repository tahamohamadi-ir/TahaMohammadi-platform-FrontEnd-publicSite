---
/**
 * 2D SVG presentation (Plan C Task 13): mobile overview, WebGL fallback and
 * about-preview. Thin wrapper over the shared renderer (`projectionSvgHtml`)
 * so the Astro component and the string shared-builder (`presentation.ts`)
 * emit identical markup. Pure presentation — no interactive attributes; the
 * HTML controls own interaction (spec §14.1). Always aria-hidden, never
 * tabbable.
 */
import { project2d, type Projection2dMode } from '../../lib/atlas/projection-2d'
import { projectionSvgHtml } from '../../lib/atlas/projection-svg'
import type { AtlasPayload } from '../../lib/atlas/model'

interface Props {
  payload: AtlasPayload
  mode: Projection2dMode
  viewport?: { width: number; height: number }
  focusKey?: string | null
}

const {
  payload,
  mode,
  viewport = { width: 390, height: 520 },
  focusKey = null,
} = Astro.props
const svg = projectionSvgHtml(
  project2d(payload, { mode, viewport, focusKey }),
  mode,
)
---

<div class="atlas__projection" data-atlas-2d set:html={svg} />
