---
import type { StoryBlock, StoryRelatedRecord } from '../../lib/story-content'
import {
  formatFileSize,
  normalizeStoryMedia,
  firstStoryMedia,
  parseHeadingLevel,
} from '../../lib/story-content'

interface Props {
  block: StoryBlock
  locale?: string
  resolvedRecords?: ReadonlyMap<string, StoryRelatedRecord>
}

const { block, locale = 'en', resolvedRecords = new Map() } = Astro.props
const { blockType, settings = {} } = block

const isFa = locale === 'fa'
const labels = {
  download: isFa ? 'دریافت فایل' : 'Download file',
  unavailable: isFa ? 'فایل در دسترس نیست' : 'File unavailable',
  references: isFa ? 'منابع و مراجع' : 'References',
  related: isFa ? 'مطالب مرتبط' : 'Related Records',
  copyCode: isFa ? 'کپی کد' : 'Copy code',
  videoNotSupported: isFa
    ? 'مرورگر شما از پخش ویدیو پشتیبانی نمی‌کند.'
    : 'Your browser does not support the video tag.',
  audioNotSupported: isFa
    ? 'مرورگر شما از پخش صوت پشتیبانی نمی‌کند.'
    : 'Your browser does not support the audio element.',
  before: isFa ? 'قبل' : 'Before',
  after: isFa ? 'بعد' : 'After',
}

const headingLevel = parseHeadingLevel(settings.level)
const headingId = typeof settings.id === 'string' ? settings.id : ''
const headingText = typeof settings.text === 'string' ? settings.text : ''

const textBody = typeof settings.body === 'string' ? settings.body : ''
const textContent = typeof settings.text === 'string' ? settings.text : ''

const codeContent = typeof settings.code === 'string' ? settings.code : ''
const codeLanguage =
  typeof settings.language === 'string' ? settings.language : ''
const codeCaption = typeof settings.caption === 'string' ? settings.caption : ''

interface TableColumn {
  key: string
  label: string
}
const tableColumns: TableColumn[] = Array.isArray(settings.columns)
  ? (settings.columns as TableColumn[])
  : []
const tableRows: Array<Record<string, unknown>> = Array.isArray(settings.rows)
  ? (settings.rows as Array<Record<string, unknown>>)
  : []
const tableCaption =
  typeof settings.caption === 'string' ? settings.caption : ''

const mathHtml = typeof settings.html === 'string' ? settings.html : ''
const mathFormula = typeof settings.formula === 'string' ? settings.formula : ''

interface MediaFileRef {
  id?: number | string
  title?: string
  slug?: string
  url?: string
  mime?: string
  size?: number
  width?: number
  height?: number
  alt?: string
  altFa?: string
  altEn?: string
}
const fileData = (settings.file ||
  settings.download ||
  null) as MediaFileRef | null
const fileUrl = fileData?.url || ''
const fileTitle =
  (typeof settings.label === 'string' ? settings.label : null) ||
  fileData?.title ||
  'Download'
const fileSize = formatFileSize(fileData?.size)
const fileMime = fileData?.mime || ''

interface ReferenceItem {
  label: string
  url?: string
}
const refItems: ReferenceItem[] = Array.isArray(settings.items)
  ? (settings.items as ReferenceItem[])
  : []

const relatedRecords: StoryRelatedRecord[] = Array.isArray(settings.records)
  ? settings.records.flatMap((ref) => {
      const record = ref && resolvedRecords.get(`${ref.family}:${ref.id}`)
      return record ? [record] : []
    })
  : []

const quoteText =
  typeof settings.body === 'string'
    ? settings.body
    : typeof settings.text === 'string'
      ? settings.text
      : typeof settings.quote === 'string'
        ? settings.quote
        : ''
const quoteAuthor =
  typeof settings.author === 'string'
    ? settings.author
    : typeof settings.source === 'string'
      ? settings.source
      : ''
const quoteCitation =
  typeof settings.citation === 'string' ? settings.citation : ''

const figureMedia = firstStoryMedia(settings.media) as MediaFileRef | null
const mediaAlt = (media: MediaFileRef | null | undefined) =>
  (isFa ? media?.altFa : media?.altEn) || media?.alt || ''
const figureCaption =
  typeof settings.caption === 'string' ? settings.caption : ''
const figureAlt =
  (typeof settings.alt === 'string' ? settings.alt : null) ||
  mediaAlt(figureMedia) ||
  figureCaption ||
  ''

interface AccordionItem {
  title: string
  body: string
}
const accordionItems: AccordionItem[] = Array.isArray(settings.items)
  ? (settings.items as AccordionItem[])
  : []

const ctaUrl = typeof settings.url === 'string' ? settings.url : '#'
const ctaLabel =
  typeof settings.label === 'string'
    ? settings.label
    : typeof settings.text === 'string'
      ? settings.text
      : 'Learn more'
const ctaStyle = settings.style === 'secondary' ? 'secondary' : 'primary'
const ctaExternal = Boolean(settings.external)

const galleryCaption =
  typeof settings.caption === 'string' ? settings.caption : ''
const galleryItems = normalizeStoryMedia(settings.media).map((item) => ({
  url: typeof item.url === 'string' ? item.url : '',
  alt: mediaAlt(item) || item.caption || '',
  caption: typeof item.caption === 'string' ? item.caption : '',
  width: typeof item.width === 'number' ? item.width : undefined,
  height: typeof item.height === 'number' ? item.height : undefined,
}))

const mediaUrl = figureMedia?.url || ''
const mediaCaption =
  typeof settings.caption === 'string' ? settings.caption : ''
const videoPoster =
  typeof settings.poster === 'string' ? settings.poster : undefined

const timelineItems = Array.isArray(settings.items)
  ? (settings.items as Array<Record<string, unknown>>).map((item) => ({
      date: item.date ? String(item.date) : '',
      title: item.title ? String(item.title) : '',
      body: item.body ? String(item.body) : '',
    }))
  : []

const counterItems = Array.isArray(settings.items)
  ? (settings.items as Array<Record<string, unknown>>).map((item) => ({
      value: item.value !== undefined ? String(item.value) : '',
      label: item.label ? String(item.label) : '',
    }))
  : []

const beforeMedia = settings.beforeMedia as MediaFileRef | undefined
const afterMedia = settings.afterMedia as MediaFileRef | undefined
const beforeUrl = beforeMedia?.url || ''
const beforeLabel =
  typeof settings.beforeLabel === 'string'
    ? settings.beforeLabel
    : labels.before
const afterUrl = afterMedia?.url || ''
const afterLabel =
  typeof settings.afterLabel === 'string' ? settings.afterLabel : labels.after
---

{
  blockType === 'heading' && (
    <div class="story-block story-block--heading">
      {headingLevel === 1 && (
        <h1 class="story-heading" id={headingId}>
          <span>{headingText}</span>
          {headingId && (
            <a
              href={`#${headingId}`}
              class="story-heading__anchor"
              aria-label={`Link to ${headingText}`}
            >
              #
            </a>
          )}
        </h1>
      )}
      {headingLevel === 2 && (
        <h2 class="story-heading" id={headingId}>
          <span>{headingText}</span>
          {headingId && (
            <a
              href={`#${headingId}`}
              class="story-heading__anchor"
              aria-label={`Link to ${headingText}`}
            >
              #
            </a>
          )}
        </h2>
      )}
      {headingLevel === 3 && (
        <h3 class="story-heading" id={headingId}>
          <span>{headingText}</span>
          {headingId && (
            <a
              href={`#${headingId}`}
              class="story-heading__anchor"
              aria-label={`Link to ${headingText}`}
            >
              #
            </a>
          )}
        </h3>
      )}
      {headingLevel === 4 && (
        <h4 class="story-heading" id={headingId}>
          <span>{headingText}</span>
          {headingId && (
            <a
              href={`#${headingId}`}
              class="story-heading__anchor"
              aria-label={`Link to ${headingText}`}
            >
              #
            </a>
          )}
        </h4>
      )}
      {headingLevel === 5 && (
        <h5 class="story-heading" id={headingId}>
          <span>{headingText}</span>
          {headingId && (
            <a
              href={`#${headingId}`}
              class="story-heading__anchor"
              aria-label={`Link to ${headingText}`}
            >
              #
            </a>
          )}
        </h5>
      )}
      {headingLevel === 6 && (
        <h6 class="story-heading" id={headingId}>
          <span>{headingText}</span>
          {headingId && (
            <a
              href={`#${headingId}`}
              class="story-heading__anchor"
              aria-label={`Link to ${headingText}`}
            >
              #
            </a>
          )}
        </h6>
      )}
    </div>
  )
}

{
  (blockType === 'text' ||
    blockType === 'paragraph' ||
    blockType === 'rich_text') && (
    <div class="story-block story-block--text story-text">
      {textBody ? (
        <div set:html={textBody} />
      ) : textContent ? (
        <p>{textContent}</p>
      ) : null}
    </div>
  )
}

{
  blockType === 'code' && (
    <div class="story-block story-block--code story-code">
      {codeLanguage && (
        <div class="story-code__header">
          <span class="story-code__lang">{codeLanguage}</span>
        </div>
      )}
      <pre class="story-code__pre">
        <code>{codeContent}</code>
      </pre>
      {codeCaption && <div class="story-code__caption">{codeCaption}</div>}
    </div>
  )
}

{
  blockType === 'table' && (
    <div class="story-block story-block--table story-table-wrapper">
      <table class="story-table">
        {tableCaption && (
          <caption class="story-table__caption">{tableCaption}</caption>
        )}
        {tableColumns.length > 0 && (
          <thead>
            <tr>
              {tableColumns.map((col) => (
                <th scope="col">{col.label || col.key}</th>
              ))}
            </tr>
          </thead>
        )}
        <tbody>
          {tableRows.map((row) => (
            <tr>
              {tableColumns.length > 0
                ? tableColumns.map((col) => (
                    <td>{String(row[col.key] ?? '')}</td>
                  ))
                : Object.values(row).map((val) => <td>{String(val ?? '')}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

{
  blockType === 'math' && (
    <div
      class="story-block story-block--math story-math"
      role="region"
      aria-label="Mathematical formula"
    >
      {mathHtml ? <div set:html={mathHtml} /> : <code>{mathFormula}</code>}
    </div>
  )
}

{
  blockType === 'file' && (
    <div class="story-block story-block--file">
      {fileUrl ? (
        <a href={fileUrl} class="story-file" download={Boolean(fileUrl)}>
          <div class="story-file__info">
            <span class="story-file__title">{fileTitle}</span>
            {(fileSize || fileMime) && (
              <span class="story-file__meta">
                {[fileMime, fileSize].filter(Boolean).join(' • ')}
              </span>
            )}
          </div>
          <span class="story-file__action">{labels.download}</span>
        </a>
      ) : (
        <div class="story-file story-file--unavailable">
          <div class="story-file__info">
            <span class="story-file__title">{fileTitle}</span>
            {(fileSize || fileMime) && (
              <span class="story-file__meta">
                {[fileMime, fileSize].filter(Boolean).join(' • ')}
              </span>
            )}
          </div>
          <span class="story-file__action story-file__action--disabled">
            {labels.unavailable}
          </span>
        </div>
      )}
    </div>
  )
}

{
  blockType === 'references' && refItems.length > 0 && (
    <div class="story-block story-block--references story-references">
      <h3 class="story-references__title">{labels.references}</h3>
      <ol class="story-references__list">
        {refItems.map((item) => (
          <li class="story-references__item">
            {item.url ? (
              <a
                href={item.url}
                class="story-references__link"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.label}
              </a>
            ) : (
              <span>{item.label}</span>
            )}
          </li>
        ))}
      </ol>
    </div>
  )
}

{
  blockType === 'related' && relatedRecords.length > 0 && (
    <div class="story-block story-block--related story-related">
      <h3 class="story-related__title">{labels.related}</h3>
      <ul class="story-related__list">
        {relatedRecords.map((record) => {
          const { family, title, href } = record

          return (
            <li class="story-related__item">
              {href ? (
                <a href={href} class="story-related__card">
                  <span class="story-related__family">{family}</span>
                  <span class="story-related__record-title">{title}</span>
                </a>
              ) : (
                <div class="story-related__card story-related__card--static">
                  <span class="story-related__family">{family}</span>
                  <span class="story-related__record-title">{title}</span>
                </div>
              )}
            </li>
          )
        })}
      </ul>
    </div>
  )
}

{
  blockType === 'quote' && (
    <div class="story-block story-block--quote">
      <blockquote class="story-quote">
        <p>{quoteText}</p>
        {(quoteAuthor || quoteCitation) && (
          <cite>{[quoteAuthor, quoteCitation].filter(Boolean).join(', ')}</cite>
        )}
      </blockquote>
    </div>
  )
}

{
  (blockType === 'figure' ||
    blockType === 'image' ||
    blockType === 'media') && (
    <figure class="story-block story-block--figure story-figure">
      {figureMedia?.url && (
        <img
          src={figureMedia.url}
          alt={figureAlt}
          width={figureMedia.width || undefined}
          height={figureMedia.height || undefined}
          loading="lazy"
        />
      )}
      {figureCaption && <figcaption>{figureCaption}</figcaption>}
    </figure>
  )
}

{
  (blockType === 'accordion' || blockType === 'tabs') &&
    accordionItems.length > 0 && (
      <div class="story-block story-block--accordion story-accordion">
        {accordionItems.map((item) => (
          <details class="story-accordion__item">
            <summary class="story-accordion__summary">{item.title}</summary>
            <div class="story-accordion__content" set:html={item.body} />
          </details>
        ))}
      </div>
    )
}

{blockType === 'divider' && <hr class="story-divider" />}

{
  blockType === 'cta' && (
    <div class="story-block story-block--cta">
      <a
        href={ctaUrl}
        class={`story-cta story-cta--${ctaStyle}`}
        target={ctaExternal ? '_blank' : undefined}
        rel={ctaExternal ? 'noopener noreferrer' : undefined}
      >
        {ctaLabel}
      </a>
    </div>
  )
}

{
  blockType === 'gallery' && galleryItems.length > 0 && (
    <div class="story-block story-block--gallery story-gallery">
      {galleryCaption && (
        <h4 class="story-gallery__caption">{galleryCaption}</h4>
      )}
      <div class="story-gallery__grid">
        {galleryItems.map((item) => (
          <figure class="story-gallery__item">
            {item.url && (
              <img
                src={item.url}
                alt={item.alt}
                loading="lazy"
                width={item.width}
                height={item.height}
              />
            )}
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  )
}

{
  blockType === 'video' && (
    <div class="story-block story-block--video story-media">
      {mediaUrl && (
        <video
          src={mediaUrl}
          controls
          poster={videoPoster}
          class="story-video"
          preload="metadata"
        >
          {labels.videoNotSupported}
        </video>
      )}
      {mediaCaption && <div class="story-media__caption">{mediaCaption}</div>}
    </div>
  )
}

{
  blockType === 'audio' && (
    <div class="story-block story-block--audio story-media">
      {mediaUrl && (
        <audio src={mediaUrl} controls class="story-audio" preload="metadata">
          {labels.audioNotSupported}
        </audio>
      )}
      {mediaCaption && <div class="story-media__caption">{mediaCaption}</div>}
    </div>
  )
}

{
  blockType === 'timeline' && timelineItems.length > 0 && (
    <div class="story-block story-block--timeline story-timeline">
      <ul class="story-timeline__list">
        {timelineItems.map((item) => (
          <li class="story-timeline__item">
            <div class="story-timeline__marker">
              {item.date && (
                <span class="story-timeline__date">{item.date}</span>
              )}
            </div>
            <div class="story-timeline__content">
              {item.title && (
                <h4 class="story-timeline__title">{item.title}</h4>
              )}
              {item.body && (
                <div class="story-timeline__body" set:html={item.body} />
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  blockType === 'counters' && counterItems.length > 0 && (
    <div class="story-block story-block--counters story-counters">
      <div class="story-counters__grid">
        {counterItems.map((item) => (
          <div class="story-counter__item">
            <span class="story-counter__value">{item.value}</span>
            {item.label && (
              <span class="story-counter__label">{item.label}</span>
            )}
          </div>
        ))}
      </div>
    </div>
  )
}

{
  blockType === 'before_after' && (
    <div class="story-block story-block--before-after story-before-after">
      <div class="story-before-after__frame">
        {beforeUrl && (
          <figure class="story-before-after__side">
            <img
              src={beforeUrl}
              alt={mediaAlt(beforeMedia) || beforeLabel}
              loading="lazy"
            />
            <figcaption>{beforeLabel}</figcaption>
          </figure>
        )}
        {afterUrl && (
          <figure class="story-before-after__side">
            <img
              src={afterUrl}
              alt={mediaAlt(afterMedia) || afterLabel}
              loading="lazy"
            />
            <figcaption>{afterLabel}</figcaption>
          </figure>
        )}
      </div>
    </div>
  )
}

{
  blockType === 'slider' && galleryItems.length > 0 && (
    <div class="story-block story-block--slider story-slider">
      <div class="story-slider__track">
        {galleryItems.map((item) => (
          <figure class="story-slider__item">
            {item.url && <img src={item.url} alt={item.alt} loading="lazy" />}
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  )
}
