---
import CollectionIndexTemplate from '../templates/CollectionIndexTemplate.astro'
import PageFamilyIndexHero from '../page-family/PageFamilyIndexHero.astro'
import PageFamilySubNavShell from '../page-family/PageFamilySubNavShell.astro'
import PageFamilyPublicationsSidebarShell from '../page-family/PageFamilyPublicationsSidebarShell.astro'
import PageFamilySelectedPublicationsShell from '../page-family/PageFamilySelectedPublicationsShell.astro'
import PageFamilyCollaborateBandShell from '../page-family/PageFamilyCollaborateBandShell.astro'
import ContentState from '../state/ContentState.astro'
import {
  getPublicationsUnavailableCopy,
  publicationsRouteTitle,
  type PublicationsIndexModel,
} from '../../lib/publications-content'
import { getResearchSubNavLabels } from '../../lib/page-family-empty-chrome'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: PublicationsIndexModel
}

const { locale, model } = Astro.props
const emptyCopy = getPublicationsUnavailableCopy(locale)
const subNavLabels = getResearchSubNavLabels(locale)
const tabRegion = locale === 'en' ? 'Research sections' : 'بخش‌های پژوهش'
const filterLabels =
  locale === 'en'
    ? {
        region: 'Publication filters',
        allOutputs: 'All outputs',
        journal: 'Journal',
        conference: 'Conference',
        chapter: 'Book chapter',
        report: 'Report',
        search: 'Search publications…',
      }
    : {
        region: 'پالایش خروجی‌ها',
        allOutputs: 'همه خروجی‌ها',
        journal: 'مجله',
        conference: 'کنفرانس',
        chapter: 'فصل کتاب',
        report: 'گزارش',
        search: 'جستجوی انتشارات…',
      }
---

{
  model.status === 'unavailable' ? (
    <CollectionIndexTemplate class="publications-page publications-page--empty">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="publications"
        eyebrow={locale === 'en' ? 'Bibliography' : 'فهرست خروجی‌ها'}
        title={publicationsRouteTitle[locale]}
        atmosphere
      />

      <div slot="filters" class="publications-page__nav-stack">
        <PageFamilySubNavShell
          locale={locale}
          labels={subNavLabels}
          regionLabel={tabRegion}
          activeIndex={2}
          class="publications-page__tabs"
        />
        <div
          class="publications-page__filters pf-index-empty__filters"
          role="group"
          aria-label={filterLabels.region}
          aria-disabled="true"
        >
          <p class="publications-page__filters-active">
            {filterLabels.allOutputs}
          </p>
          <div class="publications-page__filters-controls">
            <button type="button" class="pf-index-empty__filter-chip" disabled>
              {filterLabels.journal}
            </button>
            <button type="button" class="pf-index-empty__filter-chip" disabled>
              {filterLabels.conference}
            </button>
            <button type="button" class="pf-index-empty__filter-chip" disabled>
              {filterLabels.chapter}
            </button>
            <button type="button" class="pf-index-empty__filter-chip" disabled>
              {filterLabels.report}
            </button>
          </div>
          <input
            type="search"
            class="publications-page__search pf-index-empty__search"
            placeholder={filterLabels.search}
            disabled
            aria-hidden="true"
            tabindex="-1"
          />
        </div>
      </div>

      <div
        slot="records"
        class="publications-page__layout pf-index-empty__shell"
      >
        <PageFamilyPublicationsSidebarShell locale={locale} />

        <div class="publications-page__main">
          <PageFamilySelectedPublicationsShell locale={locale} count={4} />
          <PageFamilyCollaborateBandShell
            locale={locale}
            variant="collaborate-only"
            context="publications"
          />
          <ContentState
            variant="empty"
            locale={locale}
            headingLevel="h2"
            title={emptyCopy.title}
            message={emptyCopy.message}
          />
        </div>
      </div>
    </CollectionIndexTemplate>
  ) : (
    <CollectionIndexTemplate class="publications-page">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="publications"
        eyebrow={locale === 'en' ? 'Bibliography' : 'فهرست خروجی‌ها'}
        title={publicationsRouteTitle[locale]}
        atmosphere
      />

      <ul slot="records" class="publications-page__list">
        {model.publications.map((publication) => (
          <li>
            <article class="publications-page__card">
              <h2 class="publications-page__card-title">
                <a
                  href={localePath(locale, `publications/${publication.slug}`)}
                  class="publications-page__card-link"
                >
                  {publication.title}
                </a>
              </h2>
              <p class="publications-page__card-meta">
                {[publication.authors, publication.venue, publication.date]
                  .filter(Boolean)
                  .join(' · ')}
              </p>
              {publication.publication_type ? (
                <p class="publications-page__card-type">
                  {publication.publication_type}
                </p>
              ) : null}
            </article>
          </li>
        ))}
      </ul>
    </CollectionIndexTemplate>
  )
}
