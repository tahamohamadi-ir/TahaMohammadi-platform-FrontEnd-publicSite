---
import Button from '../ui/Button.astro'
import {
  getAboutSkillsCategories,
  getCmsPlaceholderCopy,
} from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  class?: string
}

const { locale, class: className = '' } = Astro.props
const categories = getAboutSkillsCategories(locale)
const placeholder = getCmsPlaceholderCopy(locale)
const sectionLabel = locale === 'en' ? 'Skills & expertise' : 'مهارت‌ها و تخصص'
const viewAll = locale === 'en' ? 'View all skills →' : 'مشاهده همه مهارت‌ها →'
const skillRows = [0, 1, 2, 3] as const
const iconByColumn = ['research', 'engineering', 'data', 'design'] as const
---

<section
  class={['pf-index-skills-grid', className].filter(Boolean).join(' ')}
  data-visual-id="PageFamilySkillsGridShell"
  aria-labelledby="pf-skills-grid-title"
>
  <h2 id="pf-skills-grid-title" class="pf-index-skills-grid__title">
    {sectionLabel}
  </h2>

  <div class="pf-index-skills-grid__columns">
    {
      categories.map((category, columnIndex) => (
        <article class="pf-index-skills-grid__column">
          <span
            class={[
              'pf-index-skills-grid__icon',
              `pf-index-skills-grid__icon--${columnIndex}`,
            ].join(' ')}
            aria-hidden="true"
          >
            {iconByColumn[columnIndex] === 'research' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle
                  cx="11"
                  cy="11"
                  r="5.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M16 16l4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            ) : null}
            {iconByColumn[columnIndex] === 'engineering' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M9 8 5 12l4 4M15 8l4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            ) : null}
            {iconByColumn[columnIndex] === 'data' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <ellipse
                  cx="12"
                  cy="7"
                  rx="6.5"
                  ry="2.4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M5.5 7v5c0 1.3 2.9 2.4 6.5 2.4s6.5-1.1 6.5-2.4V7M5.5 12v5c0 1.3 2.9 2.4 6.5 2.4s6.5-1.1 6.5-2.4v-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
              </svg>
            ) : null}
            {iconByColumn[columnIndex] === 'design' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M4 18.5 14.5 8a2.5 2.5 0 1 1 3.5 3.5L7.5 22H4v-3.5Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
            ) : null}
          </span>
          <h3 class="pf-index-skills-grid__column-title">{category}</h3>
          <ul class="pf-index-skills-grid__items">
            {skillRows.map((row) => (
              <li class="pf-index-skills-grid__item">
                {row === 0 ? (
                  placeholder
                ) : (
                  <span class="pf-index-empty__line pf-index-empty__line--medium" />
                )}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <p class="pf-index-skills-grid__cta">
    <Button label={viewAll} variant="secondary" disabled />
  </p>
</section>
