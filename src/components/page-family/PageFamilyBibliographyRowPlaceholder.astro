---
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  count?: number
  class?: string
}

const { locale, count = 3, class: className = '' } = Astro.props
const typeLabels =
  locale === 'en'
    ? ['Journal article', 'Conference paper', 'Book chapter']
    : ['مقاله مجله', 'مقاله کنفرانس', 'فصل کتاب']
const rows = Array.from({ length: count }, (_, index) => index)
---

<div
  class={['pf-index-bibliography', className].filter(Boolean).join(' ')}
  data-visual-id="PageFamilyBibliographyRowPlaceholder"
  aria-hidden="true"
>
  {
    rows.map((index) => (
      <div class="pf-index-bibliography__row">
        <span class="pf-index-bibliography__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M8 4h8a2 2 0 0 1 2 2v14l-4-2-4 2-4-2-4 2V6a2 2 0 0 1 2-2Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
            <path
              d="M10 8h4M10 12h4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </span>
        <div class="pf-index-bibliography__body">
          <span class="pf-index-bibliography__type">
            {typeLabels[index % typeLabels.length]}
          </span>
          <span class="pf-index-empty__line pf-index-empty__line--medium" />
          <span class="pf-index-empty__line pf-index-empty__line--short" />
        </div>
        <div class="pf-index-bibliography__actions">
          <button type="button" class="pf-index-bibliography__action" disabled>
            {locale === 'en' ? 'Details' : 'جزئیات'}
          </button>
          <button type="button" class="pf-index-bibliography__action" disabled>
            {locale === 'en' ? 'Available files' : 'فایل‌های موجود'}
          </button>
        </div>
      </div>
    ))
  }
</div>
