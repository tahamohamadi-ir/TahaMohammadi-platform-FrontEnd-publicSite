---
import SectionLead from '../ui/SectionLead.astro'
import Button from '../ui/Button.astro'
import PromotedPicture from '../media/PromotedPicture.astro'
import ThemePicture from '../media/ThemePicture.astro'
import PageFamilyWireframeOverlay from './PageFamilyWireframeOverlay.astro'
import {
  getPageFamilyHeroMedia,
  getPageFamilyDecorativeAlt,
  type PageFamilyChromeId,
} from '../../lib/page-family-empty-chrome'
import { HOME_HERO_ATMOSPHERE_ASSETS } from '../../lib/media/promoted-media'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  family: PageFamilyChromeId
  eyebrow?: string
  title: string
  summary?: string
  roleLine?: string
  atmosphere?: boolean
  portal?: boolean
  browseCtaLabel?: string
  class?: string
}

const {
  locale,
  family,
  eyebrow,
  title,
  summary,
  roleLine,
  atmosphere = false,
  portal = false,
  browseCtaLabel,
  class: className = '',
} = Astro.props
const heroMedia = getPageFamilyHeroMedia(family)
const decorativeAlt = getPageFamilyDecorativeAlt(locale, family)
---

<section
  class={[
    'pf-index-hero',
    portal ? 'pf-index-hero--portal' : '',
    atmosphere ? 'pf-index-hero--atmosphere' : '',
    `pf-index-hero--${family}`,
    className,
  ]
    .filter(Boolean)
    .join(' ')}
  data-visual-id="PageFamilyIndexHero"
  data-page-family={family}
>
  {
    atmosphere ? (
      <div class="pf-index-hero__atmosphere" aria-hidden="true">
        <ThemePicture
          lightAssetId={HOME_HERO_ATMOSPHERE_ASSETS.light}
          darkAssetId={HOME_HERO_ATMOSPHERE_ASSETS.dark}
          mediaSlot="home.hero.atmosphere"
          imgClass="pf-index-hero__atmosphere-img"
        />
        <div class="pf-index-hero__scrim" />
      </div>
    ) : null
  }

  {
    portal && heroMedia.kind === 'theme' ? (
      <div class="pf-index-hero__media" aria-hidden="true">
        <ThemePicture
          lightAssetId={heroMedia.lightAssetId}
          darkAssetId={heroMedia.darkAssetId}
          mediaSlot={heroMedia.mediaSlot}
          imgClass="pf-index-hero__image"
        />
        {family === 'creative' ? <PageFamilyWireframeOverlay /> : null}
      </div>
    ) : null
  }

  <div class="pf-index-hero__copy">
    <SectionLead
      eyebrow={eyebrow}
      eyebrowTone={family === 'writing' ? 'coral' : 'brand'}
      title={title}
      summary={summary}
      titleScale="display"
      class="pf-index-hero__lead"
    />
    {roleLine ? <p class="pf-index-hero__role">{roleLine}</p> : null}
    {
      browseCtaLabel ? (
        <Button
          label={browseCtaLabel}
          variant="secondary"
          disabled
          class="pf-index-hero__browse-cta"
        />
      ) : null
    }
  </div>

  {
    !portal ? (
      heroMedia.kind === 'theme' ? (
        <div class="pf-index-hero__media" aria-hidden="true">
          <ThemePicture
            lightAssetId={heroMedia.lightAssetId}
            darkAssetId={heroMedia.darkAssetId}
            mediaSlot={heroMedia.mediaSlot}
            imgClass="pf-index-hero__image"
          />
        </div>
      ) : (
        <div class="pf-index-hero__media" aria-hidden="true">
          <PromotedPicture
            assetId={heroMedia.assetId}
            mediaSlot={heroMedia.mediaSlot}
            locale={locale}
            alt={decorativeAlt}
            imgClass="pf-index-hero__image"
          />
        </div>
      )
    ) : null
  }
</section>
