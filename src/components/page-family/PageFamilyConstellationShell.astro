---
import ThemePicture from '../media/ThemePicture.astro'
import PromotedPicture from '../media/PromotedPicture.astro'
import {
  HOME_GRAPH_BACKPLATE_ASSETS,
  BRAND_MARK_ASSET_ID,
} from '../../lib/media/promoted-media'
---

<div
  class="pf-index-constellation"
  data-visual-id="PageFamilyConstellationShell"
  aria-hidden="true"
>
  <div class="pf-index-constellation__canvas">
    <div class="pf-index-constellation__backplate">
      <ThemePicture
        lightAssetId={HOME_GRAPH_BACKPLATE_ASSETS.light}
        darkAssetId={HOME_GRAPH_BACKPLATE_ASSETS.dark}
        mediaSlot="home.graph.backplate"
        imgClass="pf-index-constellation__backplate-img"
      />
    </div>
    <div class="pf-index-constellation__center-mark">
      <PromotedPicture
        assetId={BRAND_MARK_ASSET_ID}
        mediaSlot="brand.mark"
        locale="en"
        alt=""
        imgClass="pf-index-constellation__mark"
      />
    </div>
    <div class="pf-index-constellation__nodes">
      <span class="pf-index-constellation__node pf-index-constellation__node--a"
      ></span>
      <span class="pf-index-constellation__node pf-index-constellation__node--b"
      ></span>
      <span
        class="pf-index-constellation__node pf-index-constellation__node--center"
      ></span>
      <span class="pf-index-constellation__node pf-index-constellation__node--c"
      ></span>
      <span class="pf-index-constellation__node pf-index-constellation__node--d"
      ></span>
    </div>
  </div>
</div>
