---
import { getTeachingPathProcessSteps } from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  class?: string
}

const { locale, class: className = '' } = Astro.props
const sectionLabel =
  locale === 'en' ? 'How a path works' : 'مسیر یادگیری چگونه کار می‌کند'
const steps =
  locale === 'en'
    ? [
        {
          label: 'Overview',
          description: 'What the path covers and who it is for.',
        },
        {
          label: 'Lessons',
          description: 'Ordered modules with checkpoints and practice.',
        },
        {
          label: 'Resources',
          description: 'Downloads, references, and supporting material.',
        },
        {
          label: 'References',
          description: 'Further reading and related research links.',
        },
      ]
    : [
        {
          label: 'نمای کلی',
          description: 'پوشش مسیر و مخاطب هدف.',
        },
        {
          label: 'درس‌ها',
          description: 'ماژول‌های مرتب‌شده با تمرین و ارزیابی.',
        },
        {
          label: 'منابع',
          description: 'دانلودها، مراجع و مطالب تکمیلی.',
        },
        {
          label: 'مراجع',
          description: 'مطالعه بیشتر و پیوندهای پژوهشی مرتبط.',
        },
      ]

if (steps.length !== getTeachingPathProcessSteps(locale).length) {
  throw new Error('Teaching path process step count mismatch')
}
---

<section
  class={['pf-index-path-process', className].filter(Boolean).join(' ')}
  data-visual-id="PageFamilyPathProcessShell"
  aria-labelledby="pf-path-process-title"
>
  <h2 id="pf-path-process-title" class="pf-index-path-process__title">
    {sectionLabel}
  </h2>

  <ol class="pf-index-path-process__track" aria-hidden="true">
    {
      steps.map((step) => (
        <li class="pf-index-path-process__step">
          <span class="pf-index-path-process__icon" />
          <div class="pf-index-path-process__copy">
            <span class="pf-index-path-process__label">{step.label}</span>
            <span class="pf-index-path-process__desc">{step.description}</span>
          </div>
        </li>
      ))
    }
  </ol>
</section>
