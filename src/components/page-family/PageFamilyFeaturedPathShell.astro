---
import PromotedPicture from '../media/PromotedPicture.astro'
import {
  getPageFamilyPathSectionLabel,
  getPageFamilyPreviewAsset,
  getPageFamilyDecorativeAlt,
  getTeachingFeaturedPathSteps,
  getTeachingViewPathLabel,
  type PageFamilyChromeId,
} from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  family: PageFamilyChromeId
  class?: string
}

const { locale, family, class: className = '' } = Astro.props
const sectionLabel = getPageFamilyPathSectionLabel(locale, family)
const preview = sectionLabel ? getPageFamilyPreviewAsset(family) : null
const decorativeAlt = getPageFamilyDecorativeAlt(locale, family)
const pathSteps = getTeachingFeaturedPathSteps(locale)
const viewPathLabel = getTeachingViewPathLabel(locale)
const placeholderCopy =
  locale === 'en'
    ? 'Awaiting approved CMS copy'
    : 'در انتظار متن تأییدشده از سامانه محتوا'
---

{
  sectionLabel && preview ? (
    <section
      class={['pf-index-path', 'pf-index-path--featured', className]
        .filter(Boolean)
        .join(' ')}
      data-visual-id="PageFamilyFeaturedPathShell"
      aria-labelledby={`pf-path-${family}-title`}
    >
      <h2 id={`pf-path-${family}-title`} class="pf-index-path__title">
        {sectionLabel}
      </h2>

      <div class="pf-index-path__featured-card" aria-hidden="true">
        <div class="pf-index-path__thumb pf-index-path__thumb--featured">
          <PromotedPicture
            assetId={preview.assetId}
            mediaSlot={preview.mediaSlot}
            locale={locale}
            alt={decorativeAlt}
            imgClass="pf-index-path__image"
            loading="eager"
          />
        </div>
        <div class="pf-index-path__featured-copy">
          <p class="pf-index-path__featured-placeholder">{placeholderCopy}</p>
          <span class="pf-index-path__featured-action">{viewPathLabel} →</span>
          <ol class="pf-index-path__step-row">
            {pathSteps.map((step) => (
              <li class="pf-index-path__step-pill">{step}</li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  ) : null
}
