---
import { getProjectsEvidenceCards } from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  class?: string
}

const { locale, class: className = '' } = Astro.props
const cards = getProjectsEvidenceCards(locale)
const sectionLabel = locale === 'en' ? 'Evidence available' : 'شواهد در دسترس'
const actionLabel = locale === 'en' ? 'To be defined' : 'تعریف نشده'
---

<section
  class={['pf-index-evidence', className].filter(Boolean).join(' ')}
  data-visual-id="PageFamilyEvidenceGridShell"
  aria-labelledby="pf-evidence-grid-title"
>
  <h2 id="pf-evidence-grid-title" class="pf-index-evidence__title">
    {sectionLabel}
  </h2>

  <div class="pf-index-evidence__grid">
    {
      cards.map((card) => (
        <article class="pf-index-evidence__card">
          <span
            class={[
              'pf-index-evidence__icon',
              `pf-index-evidence__icon--${card.tone}`,
            ].join(' ')}
            aria-hidden="true"
          >
            {card.tone === 'methods' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle
                  cx="12"
                  cy="12"
                  r="8"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M12 8v4l2.5 2.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            ) : null}
            {card.tone === 'artifacts' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect
                  x="4"
                  y="6"
                  width="16"
                  height="12"
                  rx="2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M8 10h8M8 14h5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            ) : null}
            {card.tone === 'code' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M9 8 5 12l4 4M15 8l4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            ) : null}
            {card.tone === 'docs' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M7 4h7l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
                <path
                  d="M14 4v5h5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
            ) : null}
          </span>
          <h3 class="pf-index-evidence__card-title">{card.title}</h3>
          <p class="pf-index-evidence__card-copy">{card.description}</p>
          <span class="pf-index-evidence__action">{actionLabel}</span>
        </article>
      ))
    }
  </div>
</section>
