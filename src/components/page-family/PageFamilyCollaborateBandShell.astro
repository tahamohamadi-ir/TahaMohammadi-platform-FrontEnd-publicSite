---
import Button from '../ui/Button.astro'
import { getWritingCollaborateChrome } from '../../lib/page-family-empty-chrome'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  variant?: 'dual' | 'collaborate-only'
  context?: 'about' | 'publications' | 'teaching' | 'writing'
  class?: string
}

const {
  locale,
  variant = 'dual',
  context = 'teaching',
  class: className = '',
} = Astro.props

const teachingPrimaryTitle =
  locale === 'en' ? 'Optional updates' : 'به‌روزرسانی اختیاری'
const teachingPrimaryCopy =
  locale === 'en'
    ? 'Follow when new teaching paths or resources are published.'
    : 'وقتی مسیرها یا منابع جدید منتشر شد، مطلع شوید.'
const teachingPrimaryAction =
  locale === 'en' ? 'Follow updates' : 'دنبال کردن به‌روزرسانی‌ها'

const aboutPrimaryTitle = locale === 'en' ? 'Curriculum Vitae' : 'رزومه آکادمیک'
const aboutPrimaryCopy =
  locale === 'en'
    ? 'Download the latest approved academic CV files.'
    : 'دانلود آخرین فایل‌های رزومه آکادمیک تأییدشده.'
const aboutPrimaryAction = locale === 'en' ? 'Download CV' : 'دانلود رزومه'

const teachingCollaborateTitle =
  locale === 'en' ? "Let's collaborate on teaching" : 'همکاری در تدریس'
const teachingCollaborateCopy =
  locale === 'en'
    ? 'Course design, workshops, and structured learning paths.'
    : 'طراحی دوره، کارگاه و مسیرهای یادگیری ساختاریافته.'
const aboutCollaborateTitle =
  locale === 'en' ? "Let's collaborate" : 'همکاری کنیم'
const aboutCollaborateCopy =
  locale === 'en'
    ? 'Research fit, technical work, and selected creative projects.'
    : 'تناسب پژوهشی، کار فنی و پروژه‌های خلاقه منتخب.'
const publicationsCollaborateTitle =
  locale === 'en' ? "Let's collaborate on research" : 'همکاری پژوهشی'
const publicationsCollaborateCopy =
  locale === 'en'
    ? 'Co-authored outputs, datasets, and evidence-led project work.'
    : 'خروجی‌های مشترک، مجموعه‌داده‌ها و پروژه‌های مبتنی بر شواهد.'
const collaborateAction = locale === 'en' ? 'Get in touch' : 'ارتباط بگیرید'

const writingChrome = getWritingCollaborateChrome(locale)

const primaryTitle =
  context === 'about' ? aboutPrimaryTitle : teachingPrimaryTitle
const primaryCopy = context === 'about' ? aboutPrimaryCopy : teachingPrimaryCopy
const primaryAction =
  context === 'about' ? aboutPrimaryAction : teachingPrimaryAction
const collaborateTitle =
  context === 'about'
    ? aboutCollaborateTitle
    : context === 'publications'
      ? publicationsCollaborateTitle
      : context === 'writing'
        ? writingChrome.title
        : teachingCollaborateTitle
const collaborateCopy =
  context === 'about'
    ? aboutCollaborateCopy
    : context === 'publications'
      ? publicationsCollaborateCopy
      : context === 'writing'
        ? writingChrome.copy
        : teachingCollaborateCopy
---

<section
  class={[
    'pf-index-collaborate-band',
    context === 'writing' ? 'pf-index-collaborate-band--writing' : '',
    className,
  ]
    .filter(Boolean)
    .join(' ')}
  data-visual-id="PageFamilyCollaborateBandShell"
  aria-label={locale === 'en' ? 'Collaboration options' : 'گزینه‌های همکاری'}
>
  {
    variant === 'dual' && context !== 'writing' ? (
      <article class="pf-index-collaborate-band__card">
        <span
          class={[
            'pf-index-collaborate-band__icon',
            context === 'about'
              ? 'pf-index-collaborate-band__icon--cv'
              : 'pf-index-collaborate-band__icon--mail',
          ].join(' ')}
          aria-hidden="true"
        />
        <h2 class="pf-index-collaborate-band__title">{primaryTitle}</h2>
        <p class="pf-index-collaborate-band__copy">{primaryCopy}</p>
        {context === 'about' ? (
          <Button
            label={primaryAction}
            href={localePath(locale, 'cv')}
            variant="secondary"
          />
        ) : (
          <Button label={primaryAction} variant="secondary" disabled />
        )}
      </article>
    ) : null
  }

  <article class="pf-index-collaborate-band__card">
    <span
      class="pf-index-collaborate-band__icon pf-index-collaborate-band__icon--group"
      aria-hidden="true"></span>
    <h2 class="pf-index-collaborate-band__title">{collaborateTitle}</h2>
    <p class="pf-index-collaborate-band__copy">{collaborateCopy}</p>
    {
      context === 'writing' ? (
        <div class="pf-index-collaborate-band__actions">
          <Button
            label={writingChrome.connectAction}
            href={localePath(locale, 'contact')}
            variant="primary"
          />
          <Button
            label={writingChrome.cvAction}
            href={localePath(locale, 'cv')}
            variant="secondary"
          />
        </div>
      ) : (
        <Button
          label={collaborateAction}
          href={localePath(locale, 'contact')}
          variant="primary"
        />
      )
    }
  </article>
</section>
