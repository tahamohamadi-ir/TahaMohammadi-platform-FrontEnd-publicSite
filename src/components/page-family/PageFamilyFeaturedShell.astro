---
import PromotedPicture from '../media/PromotedPicture.astro'
import {
  getPageFamilyFeaturedActionLabel,
  getPageFamilyFeaturedCardLabel,
  getPageFamilyFeaturedSectionLabel,
  getPageFamilyPreviewAsset,
  getPageFamilyDecorativeAlt,
  type PageFamilyChromeId,
} from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  family: PageFamilyChromeId
  class?: string
}

const { locale, family, class: className = '' } = Astro.props
const sectionLabel = getPageFamilyFeaturedSectionLabel(locale, family)
const cardLabel = getPageFamilyFeaturedCardLabel(locale, family)
const actionLabel = getPageFamilyFeaturedActionLabel(locale, family)
const preview = sectionLabel ? getPageFamilyPreviewAsset(family) : null
const decorativeAlt = getPageFamilyDecorativeAlt(locale, family)
const copyFirst = family === 'writing' || family === 'projects'
---

{
  sectionLabel && preview && cardLabel ? (
    <section
      class={[
        'pf-index-featured',
        family === 'writing' ? 'pf-index-featured--writing' : '',
        family === 'creative' ? 'pf-index-featured--creative' : '',
        family === 'projects' ? 'pf-index-featured--project' : '',
        copyFirst ? 'pf-index-featured--copy-first' : '',
        className,
      ]
        .filter(Boolean)
        .join(' ')}
      data-visual-id="PageFamilyFeaturedShell"
      aria-labelledby={`pf-featured-${family}-title`}
    >
      <h2 id={`pf-featured-${family}-title`} class="pf-index-featured__title">
        {sectionLabel}
      </h2>

      <div class="pf-index-featured__card" aria-hidden="true">
        {copyFirst ? (
          <>
            <div class="pf-index-featured__copy">
              <p class="pf-index-featured__card-label">{cardLabel}</p>
              <span class="pf-index-empty__line pf-index-empty__line--short" />
              <span class="pf-index-empty__line pf-index-empty__line--medium" />
              <span class="pf-index-empty__line" />
              {family === 'projects' ? (
                <div class="pf-index-featured__tags">
                  <span class="pf-index-empty__tag" />
                  <span class="pf-index-empty__tag" />
                  <span class="pf-index-empty__tag" />
                  <span class="pf-index-empty__tag pf-index-empty__tag--accent" />
                </div>
              ) : null}
              {actionLabel ? (
                <span class="pf-index-featured__action">{actionLabel}</span>
              ) : null}
            </div>
            <div class="pf-index-featured__media">
              <PromotedPicture
                assetId={preview.assetId}
                mediaSlot={preview.mediaSlot}
                locale={locale}
                alt={decorativeAlt}
                imgClass="pf-index-featured__image"
              />
            </div>
          </>
        ) : (
          <>
            <div class="pf-index-featured__media">
              <PromotedPicture
                assetId={preview.assetId}
                mediaSlot={preview.mediaSlot}
                locale={locale}
                alt={decorativeAlt}
                imgClass="pf-index-featured__image"
              />
            </div>
            <div class="pf-index-featured__copy">
              <p class="pf-index-featured__card-label">{cardLabel}</p>
              <span class="pf-index-empty__line pf-index-empty__line--short" />
              <span class="pf-index-empty__line pf-index-empty__line--medium" />
              <span class="pf-index-empty__line" />
              {actionLabel ? (
                <span class="pf-index-featured__action">{actionLabel}</span>
              ) : null}
            </div>
          </>
        )}
        {family === 'projects' ? (
          <div class="pf-index-featured__dots" aria-hidden="true">
            <span class="pf-index-featured__dot pf-index-featured__dot--active" />
            <span class="pf-index-featured__dot" />
            <span class="pf-index-featured__dot" />
          </div>
        ) : null}
      </div>
    </section>
  ) : null
}
