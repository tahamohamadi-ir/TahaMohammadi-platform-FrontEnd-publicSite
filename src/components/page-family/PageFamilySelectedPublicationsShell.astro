---
import PageFamilyBibliographyRowPlaceholder from './PageFamilyBibliographyRowPlaceholder.astro'
import { localePath, type Locale } from '../../lib/navigation'

import type { PublicationListOut } from '../../lib/research-content'

interface Props {
  locale: Locale
  count?: number
  class?: string
  publications?: PublicationListOut[]
}

const { locale, count = 4, class: className = '', publications } = Astro.props
const sectionLabel =
  locale === 'en' ? 'Selected publications' : 'انتشارات منتخب'
const viewAllLabel = locale === 'en' ? 'View all publications' : 'همهٔ انتشارات'
const notice =
  locale === 'en'
    ? 'Some items may be in draft or under review. Publication status is shown from the approved CMS record.'
    : 'برخی موارد ممکن است پیش‌نویس یا در حال داوری باشند. وضعیت انتشار از رکورد تأییدشده CMS نمایش داده می‌شود.'
---

<section
  class={['pf-index-selected-pubs', className].filter(Boolean).join(' ')}
  data-visual-id="PageFamilySelectedPublicationsShell"
  aria-labelledby="pf-selected-pubs-title"
>
  <div class="pf-index-selected-pubs__header">
    <h2 id="pf-selected-pubs-title" class="pf-index-selected-pubs__title">
      {sectionLabel}
    </h2>
    <a
      class="pf-index-selected-pubs__view-all"
      href={localePath(locale, 'publications')}
    >
      {viewAllLabel}
      <span aria-hidden="true"> →</span>
    </a>
  </div>

  {
    publications && publications.length > 0 ? (
      <ul class="pf-pub-list" data-visual-id="PageFamilyBibliographyList">
        {publications.slice(0, count).map((pub) => {
          const detailHref = localePath(locale, `publications/${pub.slug}`)
          return (
            <li class="pf-pub-row">
              <h3 class="pf-pub-row__title">
                <a href={detailHref}>{pub.title}</a>
              </h3>
              <div class="pf-pub-row__meta">
                {pub.published_at && (
                  <span class="pf-pub-row__badge">
                    {new Date(pub.published_at).getFullYear()}
                  </span>
                )}
                {pub.summary && <span>{pub.summary}</span>}
              </div>
            </li>
          )
        })}
      </ul>
    ) : (
      <PageFamilyBibliographyRowPlaceholder locale={locale} count={count} />
    )
  }

  <p class="pf-index-selected-pubs__notice">
    <span class="pf-index-selected-pubs__notice-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <circle
          cx="12"
          cy="12"
          r="8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"></circle>
        <path
          d="M12 10.5V16M12 7.8v.2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </span>
    <span>{notice}</span>
  </p>
</section>
