---
import PromotedPicture from '../media/PromotedPicture.astro'
import {
  getPageFamilyRowPreviewAssets,
  getPageFamilyDecorativeAlt,
  type PageFamilyChromeId,
} from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  family: PageFamilyChromeId
  class?: string
}

const { locale, family, class: className = '' } = Astro.props
const previewAssets = getPageFamilyRowPreviewAssets(family)
const decorativeAlt = getPageFamilyDecorativeAlt(locale, family)

type GridCell = {
  modifier?: 'tall' | 'wide' | 'portrait'
  filled: boolean
  eager?: boolean
}

/** Masonry rhythm aligned with PF-01 concept — decorative authority assets only. */
const cells: GridCell[] = [
  { modifier: 'tall', filled: true, eager: true },
  { filled: true },
  { filled: true },
  { modifier: 'wide', filled: true },
  { filled: true },
  { modifier: 'tall', filled: true },
  { filled: false },
  { filled: true },
  { modifier: 'wide', filled: true },
  { filled: false },
  { modifier: 'portrait', filled: true },
  { filled: true },
]
---

<div
  class={['pf-index-grid-placeholder', className].filter(Boolean).join(' ')}
  data-visual-id="PageFamilyMediaGridPlaceholder"
  aria-hidden="true"
>
  {
    cells.map((cell, index) => {
      const preview = previewAssets[index % previewAssets.length]!
      return (
        <div
          class:list={[
            'pf-index-grid-placeholder__cell',
            cell.modifier &&
              `pf-index-grid-placeholder__cell--${cell.modifier}`,
          ]}
        >
          {cell.filled ? (
            <PromotedPicture
              assetId={preview.assetId}
              mediaSlot={preview.mediaSlot}
              locale={locale}
              alt={decorativeAlt}
              imgClass={[
                'pf-index-grid-placeholder__image',
                `pf-index-grid-placeholder__image--shift-${index % 3}`,
              ].join(' ')}
              loading={cell.eager ? 'eager' : 'lazy'}
            />
          ) : (
            <span class="pf-index-grid-placeholder__shell" />
          )}
        </div>
      )
    })
  }
</div>
