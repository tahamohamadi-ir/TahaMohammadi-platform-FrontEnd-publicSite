---
interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<svg
  class={['pf-index-hero__wireframe', className].filter(Boolean).join(' ')}
  viewBox="0 0 400 320"
  aria-hidden="true"
  focusable="false"
>
  <circle
    cx="200"
    cy="160"
    r="118"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    opacity="0.35"></circle>
  <circle
    cx="200"
    cy="160"
    r="78"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    opacity="0.45"></circle>
  <circle
    cx="200"
    cy="160"
    r="38"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    opacity="0.55"></circle>
  <line
    x1="200"
    y1="42"
    x2="200"
    y2="278"
    stroke="currentColor"
    stroke-width="1"
    opacity="0.25"></line>
  <line
    x1="82"
    y1="160"
    x2="318"
    y2="160"
    stroke="currentColor"
    stroke-width="1"
    opacity="0.25"></line>
  <circle cx="200" cy="42" r="5" fill="currentColor" opacity="0.7"></circle>
  <circle cx="318" cy="132" r="5" fill="currentColor" opacity="0.7"></circle>
  <circle cx="318" cy="188" r="5" fill="currentColor" opacity="0.7"></circle>
  <circle cx="82" cy="188" r="5" fill="currentColor" opacity="0.7"></circle>
  <circle cx="200" cy="278" r="5" fill="currentColor" opacity="0.7"></circle>
  <polyline
    points="200,42 318,132 318,188 200,278 82,188 200,42"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    opacity="0.4"></polyline>
</svg>
