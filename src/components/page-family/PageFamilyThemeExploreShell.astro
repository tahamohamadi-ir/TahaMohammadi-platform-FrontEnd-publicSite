---
import {
  getPageFamilyThemeExploreItems,
  getPageFamilyThemeExploreSectionLabel,
  type PageFamilyChromeId,
} from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  family: PageFamilyChromeId
  class?: string
}

const { locale, family, class: className = '' } = Astro.props
const sectionLabel = getPageFamilyThemeExploreSectionLabel(locale, family)
const themeItems = getPageFamilyThemeExploreItems(locale, family)
---

{
  sectionLabel && themeItems ? (
    <section
      class={['pf-index-theme-explore', className].filter(Boolean).join(' ')}
      data-visual-id="PageFamilyThemeExploreShell"
      aria-labelledby={`pf-theme-explore-${family}-title`}
    >
      <h2
        id={`pf-theme-explore-${family}-title`}
        class="pf-index-theme-explore__title"
      >
        {sectionLabel}
      </h2>
      <ul class="pf-index-theme-explore__cards" aria-hidden="true">
        {themeItems.map((item) => (
          <li>
            <div class="pf-index-theme-explore__card">
              <span
                class={[
                  'pf-index-theme-explore__icon',
                  `pf-index-theme-explore__icon--${item.tone}`,
                ].join(' ')}
              />
              <span class="pf-index-theme-explore__label">{item.label}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ) : null
}
