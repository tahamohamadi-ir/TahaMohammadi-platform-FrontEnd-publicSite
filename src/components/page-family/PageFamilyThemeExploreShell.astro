---
import {
  getPageFamilyThemeExploreItems,
  getPageFamilyThemeExploreSectionLabel,
  type PageFamilyChromeId,
} from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  family: PageFamilyChromeId
  class?: string
}

const { locale, family, class: className = '' } = Astro.props
const sectionLabel = getPageFamilyThemeExploreSectionLabel(locale, family)
const themeItems = getPageFamilyThemeExploreItems(locale, family)
---

{
  sectionLabel && themeItems ? (
    <section
      class={['pf-index-theme-explore', className].filter(Boolean).join(' ')}
      data-visual-id="PageFamilyThemeExploreShell"
      aria-labelledby={`pf-theme-explore-${family}-title`}
    >
      <h2
        id={`pf-theme-explore-${family}-title`}
        class="pf-index-theme-explore__title"
      >
        {sectionLabel}
      </h2>
      <ul class="pf-index-theme-explore__cards" aria-hidden="true">
        {themeItems.map((item) => (
          <li>
            <div class="pf-index-theme-explore__card">
              <span
                class={[
                  'pf-index-theme-explore__icon',
                  `pf-index-theme-explore__icon--${item.tone}`,
                ].join(' ')}
              >
                {item.tone === 'essay' ? (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path
                      d="M7 19.5c1.8-1 3.4-2.7 4.5-5.1.3-.7 1.2-1 1.9-.6l1.8 1.1c.6.3.7 1.1.3 1.7-1.5 2.1-3.6 3.7-6 4.6-.6.2-1.3-.2-1.3-.9v-.8Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M14.8 8.2 16.6 9.3c.5.3.7.9.3 1.4l-.8 1.3c-.3.5-.9.7-1.4.3L13 11.2c-.5-.3-.7-.9-.3-1.4l.8-1.3c.3-.5.9-.7 1.4-.3Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M6.5 4.8h4.8c.4 0 .7.2.9.5l1.2 1.9c.2.4.1.8-.2 1.1L10.8 10"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                ) : null}
                {item.tone === 'note' ? (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path
                      d="M7 4.5h7.2L17.5 8v11.5H7V4.5Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M14.1 4.7V8h3.2M9.2 11.2h5.6M9.2 14.2h5.6M9.2 17.2h3.8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                ) : null}
                {item.tone === 'memory' ? (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path
                      d="M8 4.5h8v12.2l-4-2.2-4 2.2V4.5Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M10.2 9.2h3.6M10.2 12h3.6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                ) : null}
                {item.tone === 'society' ? (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <circle
                      cx="9"
                      cy="8.2"
                      r="2.6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <circle
                      cx="15.6"
                      cy="8.6"
                      r="2.2"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <path
                      d="M4.6 18.5c.9-2.5 2.6-3.8 4.4-3.8s3.5 1.3 4.4 3.8M13.4 15c1-.3 2.1-.2 3.1.4 1.2.8 2 2.2 2.3 3.1"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                ) : null}
                {item.tone === 'archive' ? (
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path
                      d="M5 7.2h14v2.4H5V7.2Zm1.3 3.6h11.4V18H6.3v-7.2Zm3.4 2.4h4.6v1.7h-4.6v-1.7Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                    />
                  </svg>
                ) : null}
              </span>
              <span class="pf-index-theme-explore__label">{item.label}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ) : null
}
