---
import {
  getAboutHowIWorkPillars,
  getCmsPlaceholderCopy,
} from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  class?: string
}

const { locale, class: className = '' } = Astro.props
const pillars = getAboutHowIWorkPillars(locale)
const placeholder = getCmsPlaceholderCopy(locale)
const sectionLabel = locale === 'en' ? 'How I work' : 'چگونه کار می‌کنم'
const headline =
  locale === 'en'
    ? 'Principled practice across disciplines.'
    : 'عمل حرفه‌ای اصولی در میان‌رشته‌ها.'
---

<section
  class={['pf-index-how-i-work', className].filter(Boolean).join(' ')}
  data-visual-id="PageFamilyHowIWorkShell"
  aria-labelledby="pf-how-i-work-title"
>
  <p class="pf-index-how-i-work__eyebrow">{sectionLabel}</p>
  <h2 id="pf-how-i-work-title" class="pf-index-how-i-work__headline">
    {headline}
  </h2>

  <div class="pf-index-how-i-work__grid">
    {
      pillars.map((pillar) => (
        <article class="pf-index-how-i-work__card">
          <span
            class={[
              'pf-index-how-i-work__icon',
              `pf-index-how-i-work__icon--${pillar.tone}`,
            ].join(' ')}
            aria-hidden="true"
          >
            {pillar.tone === 'human' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle
                  cx="12"
                  cy="8"
                  r="3.25"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M5.5 19.5c1.4-3.2 3.7-4.8 6.5-4.8s5.1 1.6 6.5 4.8"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            ) : null}
            {pillar.tone === 'systems' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle
                  cx="12"
                  cy="12"
                  r="3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M12 5v2.2M12 16.8V19M6.8 6.8l1.6 1.6M15.6 15.6l1.6 1.6M5 12h2.2M16.8 12H19M6.8 17.2l1.6-1.6M15.6 8.4l1.6-1.6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            ) : null}
            {pillar.tone === 'evidence' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  d="M7 4h7l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M14 4v5h5M8.5 13h7M8.5 16.5h5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            ) : null}
            {pillar.tone === 'visual' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect
                  x="4"
                  y="6"
                  width="16"
                  height="12"
                  rx="2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="2.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
              </svg>
            ) : null}
          </span>
          <h3 class="pf-index-how-i-work__card-title">{pillar.title}</h3>
          <p class="pf-index-how-i-work__card-copy">{placeholder}</p>
        </article>
      ))
    }
  </div>
</section>
