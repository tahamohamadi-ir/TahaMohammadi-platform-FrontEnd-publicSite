---
import PromotedPicture from '../media/PromotedPicture.astro'
import {
  getPageFamilyRowPreviewAssets,
  getPageFamilyDecorativeAlt,
  type PageFamilyChromeId,
} from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  family: PageFamilyChromeId
  count?: number
  variant?: 'default' | 'project' | 'direction'
  class?: string
}

const {
  locale,
  family,
  count = 4,
  variant = 'default',
  class: className = '',
} = Astro.props
const previewAssets = getPageFamilyRowPreviewAssets(family)
const decorativeAlt = getPageFamilyDecorativeAlt(locale, family)
const rows = Array.from({ length: count }, (_, index) => index)
const resolvedVariant =
  variant === 'default' && family === 'projects' ? 'project' : variant
const rowModifier =
  family === 'writing' ? 'pf-index-row-placeholder--writing' : ''
---

<div
  class={[
    'pf-index-row-placeholder',
    rowModifier,
    resolvedVariant === 'project' ? 'pf-index-row-placeholder--project' : '',
    resolvedVariant === 'direction'
      ? 'pf-index-row-placeholder--direction'
      : '',
    className,
  ]
    .filter(Boolean)
    .join(' ')}
  data-visual-id="PageFamilyContentRowPlaceholder"
  aria-hidden="true"
>
  {
    rows.map((index) => {
      const preview = previewAssets[index % previewAssets.length]!
      return (
        <div class="pf-index-row-placeholder__row">
          {resolvedVariant === 'project' ? (
            <span class="pf-index-row-placeholder__index">
              {String(index + 1).padStart(2, '0')}
            </span>
          ) : null}
          <div
            class={[
              'pf-index-row-placeholder__thumb',
              resolvedVariant === 'direction'
                ? 'pf-index-row-placeholder__thumb--round'
                : '',
            ]
              .filter(Boolean)
              .join(' ')}
          >
            <PromotedPicture
              assetId={preview.assetId}
              mediaSlot={preview.mediaSlot}
              locale={locale}
              alt={decorativeAlt}
              imgClass="pf-index-row-placeholder__image"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </div>
          <div class="pf-index-row-placeholder__lines">
            {resolvedVariant !== 'direction' ? (
              <span class="pf-index-row-placeholder__category" />
            ) : null}
            <span class="pf-index-empty__line pf-index-empty__line--short" />
            <span class="pf-index-empty__line pf-index-empty__line--medium" />
            <span class="pf-index-empty__line" />
          </div>
          {resolvedVariant === 'project' ? (
            <div class="pf-index-row-placeholder__tags">
              <span class="pf-index-empty__tag" />
              <span class="pf-index-empty__tag" />
              <span class="pf-index-empty__tag" />
            </div>
          ) : null}
          {resolvedVariant === 'default' ? (
            <span class="pf-index-row-placeholder__arrow" aria-hidden="true">
              →
            </span>
          ) : null}
        </div>
      )
    })
  }
</div>
