---
import { getPublicationsInterestItems } from '../../lib/page-family-empty-chrome'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  class?: string
}

const { locale, class: className = '' } = Astro.props
const interests = getPublicationsInterestItems(locale)
const sectionLabel =
  locale === 'en' ? 'Research interests' : 'علاقه‌مندی‌های پژوهشی'
---

<aside
  class={['pf-index-pub-sidebar', className].filter(Boolean).join(' ')}
  data-visual-id="PageFamilyPublicationsSidebarShell"
  aria-label={sectionLabel}
>
  <h2 class="pf-index-pub-sidebar__title">{sectionLabel}</h2>
  <ul class="pf-index-pub-sidebar__list">
    {
      interests.map((item) => (
        <li>
          <button
            type="button"
            class="pf-index-pub-sidebar__interest"
            disabled
            aria-hidden="true"
          >
            <span
              class={[
                'pf-index-pub-sidebar__icon',
                `pf-index-pub-sidebar__icon--${item.tone}`,
              ].join(' ')}
            />
            <span class="pf-index-pub-sidebar__label">{item.label}</span>
          </button>
        </li>
      ))
    }
  </ul>
</aside>
