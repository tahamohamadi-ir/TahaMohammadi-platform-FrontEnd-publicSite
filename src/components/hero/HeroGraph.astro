---
/**
 * CA-03 — Semantic hero graph. Static HTML first: heading, scene slot with
 * a quiet decorative orbit, native node list, relationship index, and a
 * reserved detail area. CA-06 wires the locked scene contract progressively:
 * the canvas stays hidden until the enhancement succeeds; labels remain
 * HTML in every state.
 *
 * RU-05 — The same region now hosts the Home presentation of the shared
 * Research Universe (guided, scroll-driven). The CA-03 semantic contract above
 * is untouched: the graph facts, the native node list, the relationship index
 * and the honest states are all still rendered as static HTML. The universe
 * adds presentation kinds/levels, a guided subset, and the edges-as-controls
 * relationship model; it never adds or renames a research fact.
 */
import type { HeroGraphModel } from '../../lib/hero-graph-content'
import { getHomeResearchContent } from '../../lib/home-content'
import type { Locale } from '../../lib/navigation'
import { adaptResearchUniverse } from '../../lib/research-universe/adapter'
import { selectHomeUniverse } from '../../lib/research-universe/home-preset'
import {
  UNIVERSE_MODEL_VERSION,
  toUniverseRendererPayload,
} from '../../lib/research-universe/model'
import {
  SCENE_CONTRACT_VERSION,
  toScenePayload,
} from '../../lib/visual/scene-contract'
import ContentState from '../state/ContentState.astro'
import GraphNodeList from './GraphNodeList.astro'
import '../../styles/hero-graph.css'
import '../../styles/research-universe.css'

interface Props {
  locale: Locale
  graph: HeroGraphModel
  selectedId?: string | null
}

const { locale, graph, selectedId = null } = Astro.props
const research = await getHomeResearchContent(locale)

const copy = {
  nodesListLabel: {
    en: 'Research graph nodes',
    fa: 'گره‌های گراف پژوهشی',
  },
  edgesHeading: { en: 'Relationships', fa: 'رابطه‌ها' },
  detailHeading: { en: 'Selected node', fa: 'گرهٔ انتخاب‌شده' },
  edgeHeading: { en: 'Selected relationship', fa: 'رابطهٔ انتخاب‌شده' },
  edgePrompt: {
    en: 'Select a relationship to read its type and endpoints.',
    fa: 'یک رابطه را انتخاب کنید تا نوع و دو سر آن نمایش داده شود.',
  },
  detailPrompt: {
    en: 'Select a node to read its summary and related records.',
    fa: 'یک گره را انتخاب کنید تا خلاصه و رکوردهای مرتبط آن نمایش داده شود.',
  },
  emptyTitle: {
    en: 'No graph nodes yet',
    fa: 'هنوز گرهی در گراف منتشر نشده است',
  },
  emptyMessage: {
    en: 'Published graph nodes will appear here when they are available.',
    fa: 'گره‌های منتشرشدهٔ گراف پس از آماده‌شدن در اینجا نمایش داده می‌شوند.',
  },
  errorTitle: {
    en: 'Graph data could not be shown',
    fa: 'دادهٔ گراف قابل‌نمایش نیست',
  },
  errorMessage: {
    en: 'The published graph failed validation. No invented data is shown.',
    fa: 'گراف منتشرشده اعتبارسنجی نشد؛ هیچ دادهٔ ساختگی نمایش داده نمی‌شود.',
  },
  unavailableTitle: {
    en: 'Research graph unavailable',
    fa: 'گراف پژوهشی در دسترس نیست',
  },
  unavailableMessage: {
    en: 'The published research graph is not available yet.',
    fa: 'گراف پژوهشی منتشرشده هنوز در دسترس نیست.',
  },
} as const

const text = (entry: { en: string; fa: string }) => entry[locale]

const selectedNode =
  graph.status === 'ready'
    ? (graph.nodes.find((node) => node.id === selectedId) ?? null)
    : null
// CA-06 — Serialized renderer input derived from the same semantic model.
// Facts are preserved: the enhancement reads this JSON and validates it
// against the locked contract; it never invents nodes, edges, or links.
const scenePayload =
  graph.status === 'ready' ? toScenePayload(graph, selectedId) : null
const scenePayloadJson = scenePayload
  ? JSON.stringify(scenePayload).replace(/</g, '\\u003c')
  : null

// RU-05 — Home presentation of the shared universe: the published facts adapted
// to presentation kinds/levels, then reduced to the guided subset (the identity
// anchor plus the main research domains, and only the relationships among them).
// The anchor resolves from the published identity node, so its label and its
// About link are published data rather than authored copy.
const universeModel = adaptResearchUniverse(graph)
const homeUniverse = selectHomeUniverse(universeModel)
const universePayloadJson =
  homeUniverse != null
    ? // The renderer payload is the same projected shape the server rendered, so
      // the scene can never draw a node from a different value than its label.
      JSON.stringify(toUniverseRendererPayload(homeUniverse)).replace(
        /</g,
        '\\u003c',
      )
    : null
const universeNodes = homeUniverse?.nodes ?? []
const universeEdges = homeUniverse?.edges ?? []
const nodeLabelById = new Map(
  universeNodes.map((node) => [node.id, node.label]),
)

const labelById =
  graph.status === 'ready'
    ? new Map(graph.nodes.map((node) => [node.id, node.label]))
    : new Map<string, string>()
const relatedLinkLabel =
  locale === 'fa'
    ? (family: string, id: string) => `مشاهدهٔ رکورد ${family} (${id})`
    : (family: string, id: string) => `Open ${family} record ${id}`
const relationHeading = (relationType: string) =>
  relationType.replace(/-/g, ' ')
---

<section
  class="hg ru"
  data-graph-region
  data-graph-status={graph.status}
  data-graph-locale={locale}
  data-scene-contract={SCENE_CONTRACT_VERSION}
  data-hero-enhancement="idle"
  data-universe-region
  data-universe-mode="home"
  data-universe-status={graph.status}
  data-universe-contract={UNIVERSE_MODEL_VERSION}
  data-universe-locale={locale}
  aria-labelledby="home-graph-heading"
>
  <h2 id="home-graph-heading" class="hg__heading">{research.title}</h2>

  {
    graph.status === 'ready' ? (
      <>
        <div class="ru-track" data-universe-track>
          <div
            class="hg-scene ru-stage ru-scene"
            data-graph-scene
            data-universe-scene
          >
            <canvas
              class="hg-canvas ru-canvas"
              data-graph-canvas
              data-universe-canvas
              aria-hidden="true"
              hidden
            />
            <div
              class="hg-labels ru-labels"
              data-graph-labels
              data-universe-labels
              aria-hidden="true"
            />
          </div>
        </div>
        {scenePayloadJson != null ? (
          <script
            type="application/json"
            data-graph-payload
            set:html={scenePayloadJson}
          />
        ) : null}
        {universePayloadJson != null ? (
          <script
            type="application/json"
            data-universe-payload
            set:html={universePayloadJson}
          />
        ) : null}

        <GraphNodeList
          locale={locale}
          nodes={graph.nodes}
          selectedId={selectedId}
          listLabel={text(copy.nodesListLabel)}
          universe
        />

        {graph.edges.length > 0 ? (
          <div class="hg-edges ru-edges">
            <h3 class="hg-edges__heading">{text(copy.edgesHeading)}</h3>
            <ol class="hg-edges__list ru-edges__list" data-graph-edges>
              {graph.edges.map((edge) => (
                <li
                  class="hg-edges__item ru-edge"
                  data-graph-edge={edge.id}
                  data-source={edge.source}
                  data-target={edge.target}
                  data-directed={String(edge.directed)}
                  data-relation={edge.relationType}
                  data-universe-edge={edge.id}
                  data-universe-label={`${labelById.get(edge.source) ?? edge.source} → ${labelById.get(edge.target) ?? edge.target}`}
                >
                  <button
                    class="ru-edge__button"
                    type="button"
                    aria-pressed="false"
                    data-universe-edge-control
                  >
                    <span>{labelById.get(edge.source) ?? edge.source}</span>
                    <span aria-hidden="true"> → </span>
                    <span>{labelById.get(edge.target) ?? edge.target}</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        ) : null}

        <div
          class="hg-detail ru-panel"
          data-graph-detail
          data-universe-node-panel
          aria-live="polite"
        >
          <h3 class="hg-detail__heading">{text(copy.detailHeading)}</h3>
          <div data-detail-selection hidden={selectedNode == null}>
            {selectedNode != null ? (
              <>
                <p class="hg-detail__label">{selectedNode.label}</p>
                {selectedNode.summary != null ? (
                  <p class="hg-detail__summary">{selectedNode.summary}</p>
                ) : null}
                {selectedNode.related.length > 0 ? (
                  <ul class="hg-detail__links">
                    {selectedNode.related.map((link) => (
                      <li>
                        <a class="hg-detail__link" href={link.href}>
                          {relatedLinkLabel(link.family, link.id)}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </>
            ) : null}
          </div>
          <p
            class="hg-detail__prompt ru-panel__prompt"
            data-detail-prompt
            data-universe-node-prompt
            hidden={selectedNode != null}
          >
            {text(copy.detailPrompt)}
          </p>

          {/* RU-05 — One factual detail block per guided node. Blocks are
              appended after the seeded selection block so the pre-existing
              markup contract is preserved exactly; only the selected one is
              visible, and nothing here is invented: every line is published
              data already present in the graph payload. */}
          {universeNodes.map((node) => (
            <div
              class="ru-panel__detail"
              data-universe-node-detail={node.id}
              hidden={node.id !== selectedId}
            >
              <p class="ru-panel__label">{node.label}</p>
              <p class="ru-panel__meta">
                {node.kind}
                {node.classification !== 'type-map'
                  ? ` · ${node.classification}`
                  : ''}
              </p>
              {node.summary != null ? (
                <p class="ru-panel__summary">{node.summary}</p>
              ) : null}
              {node.related.length > 0 ? (
                <ul class="ru-panel__links">
                  {node.related.map((link) => (
                    <li>
                      <a class="ru-panel__link" href={link.href}>
                        {relatedLinkLabel(link.family, link.id)}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : null}
            </div>
          ))}
        </div>

        {universeEdges.length > 0 ? (
          <div class="ru-panel" data-universe-edge-panel aria-live="polite">
            <h3 class="ru-panel__heading">{text(copy.edgeHeading)}</h3>
            <p class="ru-panel__prompt" data-universe-edge-prompt>
              {text(copy.edgePrompt)}
            </p>
            {universeEdges.map((edge) => (
              <div
                class="ru-panel__detail"
                data-universe-edge-detail={edge.id}
                hidden
              >
                <p class="ru-panel__label">
                  {nodeLabelById.get(edge.source) ?? edge.source}
                  <span aria-hidden="true"> → </span>
                  {nodeLabelById.get(edge.target) ?? edge.target}
                </p>
                <p class="ru-panel__meta">
                  {relationHeading(edge.relationType)}
                  {edge.directed
                    ? ` · ${locale === 'fa' ? 'جهت‌دار' : 'directed'}`
                    : ''}
                </p>
                {edge.explanation != null ? (
                  <p class="ru-panel__summary">{edge.explanation}</p>
                ) : null}
              </div>
            ))}
          </div>
        ) : null}
      </>
    ) : graph.status === 'empty' ? (
      <ContentState
        variant="empty"
        locale={locale}
        title={text(copy.emptyTitle)}
        message={text(copy.emptyMessage)}
      />
    ) : graph.status === 'error' ? (
      <ContentState
        variant="error"
        locale={locale}
        title={text(copy.errorTitle)}
        message={text(copy.errorMessage)}
      />
    ) : (
      <ContentState
        variant="unavailable"
        locale={locale}
        title={text(copy.unavailableTitle)}
        message={text(copy.unavailableMessage)}
      />
    )
  }
</section>

<script>
  // RU-05 — Progressive Home hero enhancement. Semantic HTML renders first; the
  // Research Universe loads lazily only for a ready region on an eligible route.
  // Import failures, unavailable WebGL and context loss keep the semantic
  // fallback untouched (see research-universe/enhancement).
  import { enhanceUniverseRegion } from '../../lib/visual/research-universe/enhancement'

  function enhanceReadyHeroes() {
    const regions = document.querySelectorAll<HTMLElement>(
      '[data-graph-region][data-graph-status="ready"]',
    )
    // One active canvas per route: enhance at most the first eligible hero.
    const first = regions[0]
    if (!first) return
    const run = () => {
      void enhanceUniverseRegion(first, { mode: 'home' }).catch(() => {})
    }
    const idleWindow = window as unknown as {
      requestIdleCallback?: (
        cb: () => void,
        options?: { timeout: number },
      ) => number
    }
    if (typeof idleWindow.requestIdleCallback === 'function') {
      idleWindow.requestIdleCallback(run, { timeout: 1500 })
    } else {
      requestAnimationFrame(() => window.setTimeout(run, 0))
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', enhanceReadyHeroes, {
      once: true,
    })
  } else {
    enhanceReadyHeroes()
  }
</script>
