---
import {
  alternateLocale,
  localeDisplayCode,
  shellCopy,
  type Locale,
} from '../lib/navigation'

interface Props {
  currentLocale: Locale
  alternateHref?: string
  available: boolean
  variant?: 'compact' | 'menu'
  class?: string
}

const {
  currentLocale,
  alternateHref,
  available,
  variant = 'compact',
  class: className = '',
} = Astro.props

const otherLocale = alternateLocale(currentLocale)
const currentCode = localeDisplayCode(currentLocale)
const alternateCode = localeDisplayCode(otherLocale)
const unavailableLabel = shellCopy.localeUnavailable[currentLocale]
---

<div
  class={['language-toggle', `language-toggle--${variant}`, className]
    .filter(Boolean)
    .join(' ')}
  data-visual-id="LanguageToggle"
  role="group"
  aria-label={shellCopy.localeSwitch[currentLocale]}
>
  {
    currentLocale === 'en' ? (
      <>
        <span
          class="language-toggle__locale language-toggle__locale--current"
          aria-current="true"
        >
          {currentCode}
        </span>
        <span class="language-toggle__sep" aria-hidden="true">
          /
        </span>
        {available && alternateHref ? (
          <a
            href={alternateHref}
            class="language-toggle__locale language-toggle__locale--link"
            lang={otherLocale}
            hreflang={otherLocale}
          >
            {alternateCode}
          </a>
        ) : (
          <span
            class="language-toggle__locale language-toggle__locale--unavailable"
            aria-disabled="true"
            title={unavailableLabel}
          >
            {alternateCode}
          </span>
        )}
      </>
    ) : (
      <>
        {available && alternateHref ? (
          <a
            href={alternateHref}
            class="language-toggle__locale language-toggle__locale--link"
            lang={otherLocale}
            hreflang={otherLocale}
          >
            {alternateCode}
          </a>
        ) : (
          <span
            class="language-toggle__locale language-toggle__locale--unavailable"
            aria-disabled="true"
            title={unavailableLabel}
          >
            {alternateCode}
          </span>
        )}
        <span class="language-toggle__sep" aria-hidden="true">
          /
        </span>
        <span
          class="language-toggle__locale language-toggle__locale--current"
          aria-current="true"
        >
          {currentCode}
        </span>
      </>
    )
  }
</div>
