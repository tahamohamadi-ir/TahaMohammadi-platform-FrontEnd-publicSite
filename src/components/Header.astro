---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import {
  GATEWAY_ROLE_LINE,
  localePath,
  primaryNav,
  shellCopy,
  isNavActive,
  type Locale,
} from '../lib/navigation';

interface Props {
  locale: Locale;
  currentPath: string;
  alternateHref?: string;
  alternateAvailable?: boolean;
}

const {
  locale,
  currentPath,
  alternateHref,
  alternateAvailable = false,
} = Astro.props;
const homeHref = localePath(locale);
const brandNameDisplay =
  locale === 'en' ? shellCopy.brandName.en.toUpperCase() : shellCopy.brandName.fa;
---

<header class="site-header" data-visual-id="Header">
  <div class="site-header__inner">
    <a href={homeHref} class="site-header__brand" aria-label={shellCopy.brandName[locale]}>
      <img
        src="/media/brand/taha-mark-primary.png"
        alt=""
        width="40"
        height="40"
        class="site-header__mark"
      />
      <span class="site-header__brand-text">
        <span class="site-header__brand-name">{brandNameDisplay}</span>
        <span class="site-header__brand-role">{GATEWAY_ROLE_LINE}</span>
      </span>
    </a>

    <nav class="site-header__nav site-header__nav--desktop" aria-label={shellCopy.mainMenu[locale]}>
      <ul class="site-header__nav-list">
        {
          primaryNav.map((item) => {
            const href = localePath(locale, item.pathSegment);
            const active = isNavActive(currentPath, locale, item.pathSegment);
            return (
              <li>
                <a
                  href={href}
                  class:list={['site-header__nav-link', active && 'site-header__nav-link--active']}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label[locale]}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__utilities">
      <LanguageToggle
        currentLocale={locale}
        alternateHref={alternateHref}
        available={alternateAvailable}
      />
      <ThemeToggle locale={locale} />
      <details class="site-header__drawer">
        <summary class="site-header__menu-trigger">{shellCopy.menuToggle[locale]}</summary>
        <nav class="site-header__nav site-header__nav--mobile" aria-label={shellCopy.mainMenu[locale]}>
          <ul class="site-header__nav-list site-header__nav-list--stacked">
            {
              primaryNav.map((item) => {
                const href = localePath(locale, item.pathSegment);
                const active = isNavActive(currentPath, locale, item.pathSegment);
                return (
                  <li>
                    <a
                      href={href}
                      class:list={[
                        'site-header__nav-link',
                        active && 'site-header__nav-link--active',
                      ]}
                      aria-current={active ? 'page' : undefined}
                    >
                      {item.label[locale]}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
