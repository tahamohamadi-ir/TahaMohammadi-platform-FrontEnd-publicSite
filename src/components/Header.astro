---
import ThemeToggle from './ThemeToggle.astro'
import LanguageToggle from './LanguageToggle.astro'
import PromotedPicture from './media/PromotedPicture.astro'
import {
  localePath,
  isNavActive,
  primaryNav,
  shellCopy,
  type Locale,
} from '../lib/navigation'
import { fetchLocalizedSiteSettings } from '../lib/site-settings-content'
import { BRAND_MARK_ASSET_ID } from '../lib/media/promoted-media'

interface Props {
  locale: Locale
  currentPath: string
  alternateHref?: string
  alternateAvailable?: boolean
}

const {
  locale,
  currentPath,
  alternateHref,
  alternateAvailable = false,
} = Astro.props
const homeHref = localePath(locale)
const siteSettings = await fetchLocalizedSiteSettings(locale)

const brandNameDisplay = siteSettings?.brandName ?? ''
const roleLine = siteSettings?.tagline ?? ''
const managedNavItems = (siteSettings?.navLinks ?? []).map((link) => ({
  ...link,
  active:
    currentPath === link.href ||
    (link.href !== '/' &&
      link.href !== `/${locale}/` &&
      currentPath.startsWith(link.href)),
}))
// The route registry is an approved structural fallback when the published
// settings snapshot is missing or incomplete. Brand, biography and other
// owner copy remain fail-closed; only structural routes and chrome labels
// fall back so approved pages stay reachable without CMS.
const navItems = managedNavItems.length
  ? managedNavItems
  : primaryNav.map((item) => ({
      label: item.label[locale],
      href: localePath(locale, item.pathSegment),
      active: isNavActive(currentPath, locale, item.pathSegment),
    }))
const copy = siteSettings?.contentCopy ?? {}
const mainMenuLabel = copy['menu.main'] ?? shellCopy.mainMenu[locale]
const menuToggleLabel = copy['menu.toggle'] ?? shellCopy.menuToggle[locale]
const searchLabel = Object.hasOwn(copy, 'nav.search')
  ? copy['nav.search']
  : shellCopy.search[locale]
---

<header class="site-header" data-visual-id="Header">
  <div class="site-header__inner">
    {
      (
        // The home link/logo is chrome and must stay reachable even without
        // CMS settings — but the owner's name and role are biography, not
        // chrome, so (per managed-shell.test.ts) they never resurrect here
        // without a published settings snapshot. The link still renders with
        // the structural "Home" label; only the name/role text is withheld.
        <a
          href={homeHref}
          class="site-header__brand"
          aria-label={brandNameDisplay || shellCopy.homeLink[locale]}
        >
          <PromotedPicture
            assetId={BRAND_MARK_ASSET_ID}
            mediaSlot="brand.mark"
            locale={locale}
            alt=""
            imgClass="site-header__mark"
            loading="eager"
          />
          {brandNameDisplay && (
            <span class="site-header__brand-text">
              <span class="site-header__brand-name">{brandNameDisplay}</span>
              {roleLine ? (
                <span class="site-header__brand-role">{roleLine}</span>
              ) : null}
            </span>
          )}
        </a>
      )
    }

    {
      navItems.length > 0 && (
        <nav
          class="site-header__nav site-header__nav--desktop"
          aria-label={mainMenuLabel || undefined}
        >
          <ul class="site-header__nav-list">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'site-header__nav-link',
                    item.active && 'site-header__nav-link--active',
                  ]}
                  aria-current={item.active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="site-header__utilities">
      {
        searchLabel && (
          <a
            href={localePath(locale, 'search')}
            class="site-header__search-link"
            aria-current={
              isNavActive(currentPath, locale, 'search') ? 'page' : undefined
            }
          >
            {searchLabel}
          </a>
        )
      }
      <LanguageToggle
        currentLocale={locale}
        alternateHref={alternateHref}
        available={alternateAvailable}
      />
      <ThemeToggle locale={locale} />
      {
        navItems.length > 0 && menuToggleLabel && (
          <details class="site-header__drawer">
            <summary class="site-header__menu-trigger">
              {menuToggleLabel}
            </summary>
            {/* Native <details>/<summary> is the no-JS fallback: it opens
              and closes the sheet with no script. header-drawer.ts only
              layers on Escape-to-close, outside-click-to-close and a focus
              trap when JS runs; none of that is required to use the menu. */}
            <div class="site-header__drawer-scrim" tabindex="-1" />
            <nav
              class="site-header__nav site-header__nav--mobile"
              aria-label={mainMenuLabel || undefined}
            >
              <ul class="site-header__nav-list site-header__nav-list--stacked">
                {navItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        'site-header__nav-link',
                        item.active && 'site-header__nav-link--active',
                      ]}
                      aria-current={item.active ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )
      }
    </div>
  </div>
</header>

<script>
  import { enhanceHeaderDrawer } from '../lib/header-drawer'
  enhanceHeaderDrawer()
</script>
