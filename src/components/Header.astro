---
import ThemeToggle from './ThemeToggle.astro'
import LanguageToggle from './LanguageToggle.astro'
import PromotedPicture from './media/PromotedPicture.astro'
import {
  GATEWAY_ROLE_LINE,
  localePath,
  primaryNav,
  shellCopy,
  isNavActive,
  type Locale,
} from '../lib/navigation'
import { BRAND_MARK_ASSET_ID } from '../lib/media/promoted-media'

interface Props {
  locale: Locale
  currentPath: string
  alternateHref?: string
  alternateAvailable?: boolean
}

const {
  locale,
  currentPath,
  alternateHref,
  alternateAvailable = false,
} = Astro.props
const homeHref = localePath(locale)
const brandNameDisplay =
  locale === 'en'
    ? shellCopy.brandName.en.toUpperCase()
    : shellCopy.brandName.fa
---

<header class="site-header" data-visual-id="Header">
  <div class="site-header__inner">
    <a href={homeHref} class="site-header__brand">
      <PromotedPicture
        assetId={BRAND_MARK_ASSET_ID}
        mediaSlot="brand.mark"
        locale={locale}
        alt=""
        imgClass="site-header__mark"
        loading="eager"
      />
      <span class="site-header__brand-text">
        <span class="site-header__brand-name">{brandNameDisplay}</span>
        <span class="site-header__brand-role">{GATEWAY_ROLE_LINE}</span>
      </span>
    </a>

    <nav
      class="site-header__nav site-header__nav--desktop"
      aria-label={shellCopy.mainMenu[locale]}
    >
      <ul class="site-header__nav-list">
        {
          primaryNav.map((item) => {
            const href = localePath(locale, item.pathSegment)
            const active = isNavActive(currentPath, locale, item.pathSegment)
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    'site-header__nav-link',
                    active && 'site-header__nav-link--active',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label[locale]}
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>

    <div class="site-header__utilities">
      <a
        href={localePath(locale, 'search')}
        class="site-header__search-link"
        aria-current={isNavActive(currentPath, locale, 'search')
          ? 'page'
          : undefined}
      >
        {locale === 'en' ? 'Search' : 'جستجو'}
      </a>
      <LanguageToggle
        currentLocale={locale}
        alternateHref={alternateHref}
        available={alternateAvailable}
      />
      <ThemeToggle locale={locale} />
      <details class="site-header__drawer">
        <summary class="site-header__menu-trigger"
          >{shellCopy.menuToggle[locale]}</summary
        >
        <nav
          class="site-header__nav site-header__nav--mobile"
          aria-label={shellCopy.mainMenu[locale]}
        >
          <ul class="site-header__nav-list site-header__nav-list--stacked">
            {
              primaryNav.map((item) => {
                const href = localePath(locale, item.pathSegment)
                const active = isNavActive(
                  currentPath,
                  locale,
                  item.pathSegment,
                )
                return (
                  <li>
                    <a
                      href={href}
                      class:list={[
                        'site-header__nav-link',
                        active && 'site-header__nav-link--active',
                      ]}
                      aria-current={active ? 'page' : undefined}
                    >
                      {item.label[locale]}
                    </a>
                  </li>
                )
              })
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
