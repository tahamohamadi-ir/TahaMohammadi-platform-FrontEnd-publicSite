---
import CollectionIndexTemplate from '../templates/CollectionIndexTemplate.astro'
import SectionLead from '../ui/SectionLead.astro'
import ContentState from '../state/ContentState.astro'
import Link from '../ui/Link.astro'
import {
  formatCreativeCardMeta,
  getCreativeEmptyCopy,
  getCreativeRouteTitle,
  type CreativeIndexModel,
} from '../../lib/creative-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: CreativeIndexModel
}

const { locale, model } = Astro.props
const emptyCopy = getCreativeEmptyCopy(locale)
const filterLabels =
  locale === 'en'
    ? {
        region: 'Gallery filters',
        allWork: 'All work',
        medium: 'Medium',
        year: 'Year',
        role: 'Role',
        contact: 'Contact',
      }
    : {
        region: 'پالایش‌های گالری',
        allWork: 'همه آثار',
        medium: 'رسانه',
        year: 'سال',
        role: 'نقش',
        contact: 'تماس',
      }
---

{
  model.status === 'empty' ? (
    <CollectionIndexTemplate class="creative-page creative-page--empty">
      <SectionLead
        slot="lead"
        eyebrow={
          locale === 'en' ? 'Visual & creative work' : 'آثار بصری و خلاقه'
        }
        title={getCreativeRouteTitle(locale)}
      />

      <div
        slot="filters"
        class="creative-page__filters"
        role="group"
        aria-label={filterLabels.region}
        aria-disabled="true"
      >
        <p class="creative-page__filters-active">{filterLabels.allWork}</p>
        <div class="creative-page__filters-controls">
          <button type="button" class="creative-page__filter-control" disabled>
            {filterLabels.medium}
          </button>
          <button type="button" class="creative-page__filter-control" disabled>
            {filterLabels.year}
          </button>
          <button type="button" class="creative-page__filter-control" disabled>
            {filterLabels.role}
          </button>
        </div>
        <Link
          href={localePath(locale, 'contact')}
          label={filterLabels.contact}
          variant="standalone"
        />
      </div>

      <div slot="records" class="creative-page__grid-shell">
        <div class="creative-page__grid-placeholder" aria-hidden="true">
          <span class="creative-page__grid-cell creative-page__grid-cell--tall" />
          <span class="creative-page__grid-cell" />
          <span class="creative-page__grid-cell creative-page__grid-cell--wide" />
          <span class="creative-page__grid-cell" />
          <span class="creative-page__grid-cell creative-page__grid-cell--tall" />
          <span class="creative-page__grid-cell" />
        </div>
        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title={emptyCopy.title}
          message={emptyCopy.message}
        />
      </div>
    </CollectionIndexTemplate>
  ) : (
    <CollectionIndexTemplate class="creative-page">
      <SectionLead
        slot="lead"
        eyebrow={
          locale === 'en' ? 'Visual & creative work' : 'آثار بصری و خلاقه'
        }
        title={getCreativeRouteTitle(locale)}
      />

      <ul slot="records" class="creative-page__list">
        {model.works.map((work) => (
          <li>
            <article class="creative-page__card">
              <h2 class="creative-page__card-title">
                <a
                  href={localePath(locale, `creative/${work.slug}`)}
                  class="creative-page__card-link"
                >
                  {work.title}
                </a>
              </h2>
              {work.description ? (
                <p class="creative-page__card-summary">{work.description}</p>
              ) : null}
              <p class="creative-page__card-meta">
                {formatCreativeCardMeta(work)}
              </p>
            </article>
          </li>
        ))}
      </ul>
    </CollectionIndexTemplate>
  )
}
