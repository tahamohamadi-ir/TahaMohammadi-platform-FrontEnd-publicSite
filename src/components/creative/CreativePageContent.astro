---
import CollectionIndexTemplate from '../templates/CollectionIndexTemplate.astro'
import PageFamilyIndexHero from '../page-family/PageFamilyIndexHero.astro'
import ContentState from '../state/ContentState.astro'
import {
  formatCreativeCardMeta,
  getCreativeEmptyCopy,
  getCreativeRouteTitle,
  type CreativeIndexModel,
} from '../../lib/creative-content'
import { getPageFamilyHeroSummary } from '../../lib/page-family-empty-chrome'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: CreativeIndexModel
}

const { locale, model } = Astro.props
const emptyCopy = getCreativeEmptyCopy(locale)
---

{
  model.status === 'empty' ? (
    <div class="creative-page creative-page--empty">
      <ContentState
        variant="empty"
        locale={locale}
        headingLevel="h1"
        title={emptyCopy.title}
        message={emptyCopy.message}
        actionLabel={locale === 'en' ? 'Back to home' : 'بازگشت به خانه'}
        actionHref={localePath(locale, 'home')}
      />
    </div>
  ) : (
    <CollectionIndexTemplate class="creative-page">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="creative"
        portal
        eyebrow={
          locale === 'en' ? 'Visual & creative work' : 'آثار بصری و خلاقه'
        }
        title={getCreativeRouteTitle(locale)}
        summary={getPageFamilyHeroSummary(locale, 'creative')}
      />

      <ul slot="records" class="creative-page__list">
        {model.works.map((work) => (
          <li>
            <article class="creative-page__card">
              <h2 class="creative-page__card-title">
                <a
                  href={localePath(locale, `creative/${work.slug}`)}
                  class="creative-page__card-link"
                >
                  {work.title}
                </a>
              </h2>
              {work.description ? (
                <p class="creative-page__card-summary">{work.description}</p>
              ) : null}
              <p class="creative-page__card-meta">
                {formatCreativeCardMeta(work, locale)}
              </p>
            </article>
          </li>
        ))}
      </ul>
    </CollectionIndexTemplate>
  )
}
