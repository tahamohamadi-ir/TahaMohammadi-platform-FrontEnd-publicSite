---
import { AlertTriangle, Inbox, Languages, SearchX, Clock } from 'lucide-astro'
import Button from '../ui/Button.astro'
import type { ContentStateLocale, ContentStateVariant } from './types'

interface Props {
  variant: ContentStateVariant
  locale: ContentStateLocale
  title: string
  message?: string
  actionLabel?: string
  actionHref?: string
  alternateLabel?: string
  alternateHref?: string
  /** Page-level states use one H1; inline states use H2. */
  headingLevel?: 'h1' | 'h2'
  class?: string
}

const {
  variant,
  locale,
  title,
  message,
  actionLabel,
  actionHref,
  alternateLabel,
  alternateHref,
  headingLevel = 'h2',
  class: className = '',
} = Astro.props

const HeadingTag = headingLevel

const role = variant === 'error' ? 'alert' : 'status'
const live = variant === 'loading' ? 'polite' : undefined
const hasAction = Boolean(actionLabel && actionHref)
const hasAlternate =
  variant === 'untranslated' && Boolean(alternateLabel && alternateHref)

if (variant === 'untranslated' && !hasAlternate) {
  throw new Error(
    'ContentState untranslated requires alternateLabel and alternateHref',
  )
}

const stateIcons = {
  empty: Inbox,
  unavailable: Clock,
  error: AlertTriangle,
  untranslated: Languages,
  'no-results': SearchX,
} as const

const Icon = variant === 'loading' ? null : stateIcons[variant]
---

<section
  class={['ui-content-state', `ui-content-state--${variant}`, className]
    .filter(Boolean)
    .join(' ')}
  role={role}
  aria-live={live}
  aria-labelledby={`content-state-title-${variant}`}
  data-visual-id="ContentState"
  data-state-variant={variant}
  lang={locale}
>
  <div class="ui-content-state__body">
    {
      variant === 'loading' ? (
        <span class="ui-content-state__icon" aria-hidden="true">
          <span class="ui-content-state__spinner" />
        </span>
      ) : (
        <span class="ui-content-state__icon" aria-hidden="true">
          {Icon ? <Icon size={24} strokeWidth={1.75} /> : null}
        </span>
      )
    }
    <HeadingTag
      id={`content-state-title-${variant}`}
      class="ui-content-state__title"
    >
      {title}
    </HeadingTag>
    {message ? <p class="ui-content-state__message">{message}</p> : null}
  </div>

  {
    hasAction || hasAlternate ? (
      <div class="ui-content-state__actions">
        {hasAction ? (
          <Button href={actionHref!} label={actionLabel!} variant="primary" />
        ) : null}
        {hasAlternate ? (
          <Button
            href={alternateHref!}
            label={alternateLabel!}
            variant="secondary"
          />
        ) : null}
      </div>
    ) : null
  }
</section>

<style>
  .ui-content-state {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    padding: var(--space-10) var(--space-8);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xl);
    background: var(--card-background, var(--color-surface));
    box-shadow: var(--shadow-atlas-glow);
    color: var(--color-ink);
    text-align: center;
  }

  .ui-content-state__body {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    max-width: 36rem;
  }

  .ui-content-state__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 3rem;
    block-size: 3rem;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    color: var(--color-brand);
    margin-block-end: var(--space-2);
  }

  .ui-content-state--error .ui-content-state__icon {
    background: color-mix(
      in srgb,
      var(--color-status-error, var(--color-accent-coral)) 16%,
      transparent
    );
    color: var(--color-status-error, var(--color-accent-coral));
  }

  .ui-content-state__spinner {
    inline-size: 1.375rem;
    block-size: 1.375rem;
    border: 2px solid color-mix(in srgb, var(--color-brand) 25%, transparent);
    border-top-color: var(--color-brand);
    border-radius: 50%;
    animation: ui-content-state-spin var(--motion-base) linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-content-state__spinner {
      animation-duration: var(--motion-reduced-duration, 0.01ms) !important;
      animation-iteration-count: 1 !important;
    }
  }

  .ui-content-state__title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: 700;
    line-height: var(--line-height-snug, 1.3);
  }

  .ui-content-state__message {
    margin: 0;
    font-size: var(--font-size-md, var(--font-size-sm));
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }

  .ui-content-state__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  @keyframes ui-content-state-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
