---
import { localePath, type Locale } from '../../lib/navigation';
import { getHomeConstellationContent } from '../../lib/home-content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getHomeConstellationContent(locale);
const researchHref = localePath(locale, 'research');
---

<section class="home-constellation" aria-labelledby="home-constellation-heading">
  <div class="home-constellation__inner">
    <div class="home-constellation__copy">
      <p class="home-section__eyebrow">{content.sectionLabel}</p>
      <h2 id="home-constellation-heading" class="home-constellation__heading">
        {content.heading}
      </h2>
      <p class="home-constellation__lead home-prose-justify">{content.research.lead}</p>

      <ul class="home-constellation__legend" aria-label={content.sectionLabel}>
        {
          content.nodes.map((node) => (
            <li>
              <span
                class="home-constellation__legend-dot"
                data-accent={node.accent}
                aria-hidden="true"
              />
              <span class="home-constellation__legend-label">{node.label}</span>
            </li>
          ))
        }
      </ul>

      <a href={researchHref} class="home-constellation__cta">
        {content.research.cta} →
      </a>
    </div>

    <div class="home-constellation__diagram">
      <div class="home-constellation__orbit" role="img" aria-label={content.sectionLabel}>
        <span class="home-constellation__ring home-constellation__ring--inner" aria-hidden="true" />
        <span class="home-constellation__ring home-constellation__ring--outer" aria-hidden="true" />

        {
          content.nodes.map((node) => (
            <a
              href={researchHref}
              class={`home-constellation__node home-constellation__node--${node.position}`}
            >
              <span class="home-constellation__node-dot" data-accent={node.accent} aria-hidden="true" />
              <span class="home-constellation__node-label">{node.label}</span>
            </a>
          ))
        }

        <a href={researchHref} class="home-constellation__core">
          <img
            src="/media/brand/taha-mark-primary.png"
            alt=""
            width="40"
            height="40"
            class="home-constellation__mark"
          />
          <span class="home-constellation__core-label">{content.centerLabel}</span>
        </a>
      </div>
    </div>
  </div>
</section>
