---
import { localePath, type Locale } from '../../lib/navigation';
import { getHomeConstellationContent } from '../../lib/home-content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getHomeConstellationContent(locale);
const researchHref = localePath(locale, 'research');
---

<section class="home-constellation" aria-labelledby="home-constellation-heading">
  <div class="home-constellation__inner">
    <header class="home-constellation__header">
      <h2 id="home-constellation-heading" class="home-constellation__heading">
        {content.heading}
      </h2>
      <p class="home-constellation__lead">{content.research.lead}</p>
      <a href={researchHref} class="home-constellation__cta">
        {content.research.cta}
      </a>
    </header>

    <div class="home-constellation__diagram" aria-hidden="true">
      <div class="home-constellation__orbit">
        <span class="home-constellation__core">
          <img
            src="/media/brand/taha-mark-primary.png"
            alt=""
            width="40"
            height="40"
            class="home-constellation__mark"
          />
        </span>
        <span class="home-constellation__node home-constellation__node--a"></span>
        <span class="home-constellation__node home-constellation__node--b"></span>
        <span class="home-constellation__node home-constellation__node--c"></span>
        <span class="home-constellation__node home-constellation__node--d"></span>
        <span class="home-constellation__node home-constellation__node--e"></span>
        <span class="home-constellation__ring"></span>
      </div>
    </div>
  </div>
</section>
