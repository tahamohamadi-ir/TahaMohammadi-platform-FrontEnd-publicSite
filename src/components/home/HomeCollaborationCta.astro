---
import Button from '../ui/Button.astro'
import { getHomeCollaborationContent } from '../../lib/home-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const content = await getHomeCollaborationContent(locale)
---

{
  (content.title || content.message) && (
    <section class="hm-collab">
      <div class="hm-collab__inner">
        <div class="hm-collab__copy">
          <p class="hm-eyebrow">{content.title}</p>
          <h2 id="hm-collab-title" class="hm-collab__title">
            {content.message}
          </h2>
          <div class="hm-collab__actions">
            {content.connectLabel && (
              <Button
                label={content.connectLabel}
                variant="primary"
                href={localePath(locale, 'contact')}
                class="hm-collab__btn"
              />
            )}
            {content.cvLabel && (
              <Button
                label={content.cvLabel}
                variant="secondary"
                href={localePath(locale, 'cv')}
                class="hm-collab__btn"
              />
            )}
          </div>
        </div>
      </div>
    </section>
  )
}
