---
import { localePath, type Locale } from '../../lib/navigation';
import { getHomeExploreContent } from '../../lib/home-content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getHomeExploreContent(locale);
---

<section class="home-explore" aria-labelledby="home-explore-title">
  <div class="home-explore__inner">
    <h2 id="home-explore-title" class="home-section__eyebrow">{content.title}</h2>
    <ul class="home-explore__grid">
      {
        content.rails.map((rail) => {
          const railHref = localePath(locale, rail.pathSegment);
          return (
            <li>
              <a href={railHref} class="home-explore__card home-card-interactive">
                <h3 class="home-explore__card-title">{rail.title}</h3>
                <p class="home-explore__card-excerpt home-prose-justify">{rail.excerpt}</p>
                <div class="home-explore__card-footer">
                  <span class="home-explore__card-link">{rail.viewLabel}</span>
                  <span class="home-explore__card-go" aria-hidden="true">→</span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
