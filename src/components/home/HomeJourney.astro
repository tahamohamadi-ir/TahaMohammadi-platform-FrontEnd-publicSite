---
import TimelineNode from '../ui/TimelineNode.astro'
import { Waypoints } from 'lucide-astro'
import { getHomeJourneyContent } from '../../lib/home-content'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const content = await getHomeJourneyContent(locale)
---

{
  content.milestones.length > 0 && (
    <section class="hm-journey">
      <div class="hm-journey__inner">
        {(content.title || content.headline) && (
          <header class="hm-journey__header">
            {content.title && (
              <p class="hm-eyebrow hm-journey__eyebrow">
                <span class="hm-journey__icon" aria-hidden="true">
                  <Waypoints size={14} />
                </span>
                {content.title}
              </p>
            )}
            {content.headline && (
              <h2 id="hm-journey-title" class="hm-journey__headline">
                {content.headline}
              </h2>
            )}
          </header>
        )}

        <ol class="hm-journey__timeline">
          {content.milestones.map((milestone) => (
            <TimelineNode
              label={milestone.title}
              summary={milestone.subtitle || undefined}
              period={milestone.period || undefined}
              icon={
                milestone.kind === 'experience'
                  ? 'experience'
                  : milestone.kind === 'education'
                    ? 'education'
                    : 'milestone'
              }
              class="hm-journey__step"
            />
          ))}
        </ol>
      </div>
    </section>
  )
}
