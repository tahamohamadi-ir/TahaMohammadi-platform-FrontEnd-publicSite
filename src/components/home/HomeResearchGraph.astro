---
import { getHomeConstellationContent } from '../../lib/home-content'
import type { Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const content = getHomeConstellationContent(locale)
const diagramNodes = content.nodes.slice(0, 3)
---

<section class="hm-graph">
  <div class="hm-graph__copy">
    <p class="hm-eyebrow">{content.sectionLabel}</p>
    <h2 id="hm-graph-heading" class="hm-graph__heading">
      {content.heading}
    </h2>
    <p class="hm-graph__lead">{content.research.lead}</p>
  </div>

  <div class="hm-graph__diagram">
    <div class="hm-graph__canvas">
      <svg
        class="hm-graph__simple"
        viewBox="0 0 320 320"
        aria-hidden="true"
        focusable="false"
      >
        <circle
          cx="160"
          cy="160"
          r="118"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-dasharray="4 6"
          opacity="0.28"
        />
        <circle
          cx="160"
          cy="160"
          r="78"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-dasharray="4 6"
          opacity="0.38"
        />
        <circle
          cx="160"
          cy="160"
          r="38"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-dasharray="4 6"
          opacity="0.48"
        />
        <text
          x="160"
          y="168"
          text-anchor="middle"
          class="hm-graph__brand-mark"
        >
          tb
        </text>
      </svg>

      <ul
        class="hm-graph__nodes hm-graph__nodes--simple"
        aria-label={content.sectionLabel}
        data-graph-state="unavailable-route"
      >
        {
          diagramNodes.map((node, index) => (
            <li
              class:list={[
                'hm-graph__node',
                `hm-graph__node--simple-${index + 1}`,
              ]}
              data-graph-node-state="unavailable"
            >
              <span
                class="hm-graph__node-dot"
                data-accent={node.accent}
                aria-hidden="true"
              />
              <span class="hm-graph__node-label">{node.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
