---
import Button from '../ui/Button.astro'
import Chip from '../ui/Chip.astro'
import ThemePicture from '../media/ThemePicture.astro'
import { ArrowRight, FileText, Mail } from 'lucide-astro'
import { getHomeHeroContent } from '../../lib/home-content'
import { getProfileHeroCtaLabels } from '../../lib/page-family-empty-chrome'
import { HOME_HERO_ATMOSPHERE_ASSETS } from '../../lib/media/promoted-media'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const content = getHomeHeroContent(locale)
const ctaLabels = getProfileHeroCtaLabels(locale)
---

<section class="hm-hero" data-hero-layout="split">
  <div class="hm-hero__copy">
    <header class="hm-hero__lead">
      <p class="hm-hero__role">{content.role}</p>
      <h1 class="hm-hero__name">{content.name}</h1>
      <p class="hm-hero__intro">{content.intro}</p>
    </header>

    <div class="hm-hero__actions">
      <Button
        label={ctaLabels.research}
        href={localePath(locale, 'research')}
        variant="primary"
        class="hm-hero__cta"
      >
        <ArrowRight class="hm-hero__cta-icon" aria-hidden="true" />
      </Button>
      <Button
        label={ctaLabels.cv}
        href={localePath(locale, 'cv')}
        variant="secondary"
        class="hm-hero__cta"
      >
        <FileText class="hm-hero__cta-icon" aria-hidden="true" />
      </Button>
      <Button
        label={ctaLabels.contact}
        href={localePath(locale, 'contact')}
        variant="secondary"
        class="hm-hero__cta"
      >
        <Mail class="hm-hero__cta-icon" aria-hidden="true" />
      </Button>
    </div>

    {
      content.focusChips.length > 0 && (
        <div class="hm-hero__focus">
          <p class="hm-hero__focus-label">{content.focusAreasLabel}</p>
          <ul class="hm-hero__focus-list">
            {content.focusChips.map((chip) => (
              <li>
                <Chip label={chip} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="hm-hero__media" aria-hidden="true">
    <ThemePicture
      lightAssetId={HOME_HERO_ATMOSPHERE_ASSETS.light}
      darkAssetId={HOME_HERO_ATMOSPHERE_ASSETS.dark}
      mediaSlot="home.hero.atmosphere"
      imgClass="hm-hero__media-img"
    />
    <svg class="hm-hero__ornament" viewBox="0 0 240 240" focusable="false">
      <circle
        cx="120"
        cy="120"
        r="98"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        opacity="0.28"></circle>
      <circle
        cx="120"
        cy="120"
        r="68"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        opacity="0.36"></circle>
      <circle
        cx="120"
        cy="120"
        r="38"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        opacity="0.44"></circle>
      <line
        x1="120"
        y1="18"
        x2="120"
        y2="222"
        stroke="currentColor"
        stroke-width="1"
        opacity="0.22"></line>
      <line
        x1="18"
        y1="120"
        x2="222"
        y2="120"
        stroke="currentColor"
        stroke-width="1"
        opacity="0.22"></line>
    </svg>
  </div>
</section>
