---
import SectionLead from '../ui/SectionLead.astro'
import Button from '../ui/Button.astro'
import Chip from '../ui/Chip.astro'
import ThemePicture from '../media/ThemePicture.astro'
import { ArrowRight, FileText, Mail } from 'lucide-astro'
import { getHomeHeroContent } from '../../lib/home-content'
import { getProfileHeroCtaLabels } from '../../lib/page-family-empty-chrome'
import { HOME_HERO_ATMOSPHERE_ASSETS } from '../../lib/media/promoted-media'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const content = getHomeHeroContent(locale)
const ctaLabels = getProfileHeroCtaLabels(locale)
---

<section class="hm-hero">
  <div class="hm-hero__atmosphere" aria-hidden="true">
    <ThemePicture
      lightAssetId={HOME_HERO_ATMOSPHERE_ASSETS.light}
      darkAssetId={HOME_HERO_ATMOSPHERE_ASSETS.dark}
      mediaSlot="home.hero.atmosphere"
      imgClass="hm-hero__atmosphere-img"
    />
    <div class="hm-hero__scrim"></div>
  </div>

  <div class="hm-hero__inner">
    <SectionLead
      eyebrow={content.role}
      title={content.name}
      summary={content.intro}
      class="hm-hero__lead"
    />

    <div class="hm-hero__actions">
      <Button
        label={ctaLabels.research}
        href={localePath(locale, 'research')}
        variant="primary"
        class="hm-hero__cta"
      >
        <ArrowRight class="hm-hero__cta-icon" aria-hidden="true" />
      </Button>
      <Button
        label={ctaLabels.cv}
        href={localePath(locale, 'cv')}
        variant="secondary"
        class="hm-hero__cta"
      >
        <FileText class="hm-hero__cta-icon" aria-hidden="true" />
      </Button>
      <Button
        label={ctaLabels.contact}
        href={localePath(locale, 'contact')}
        variant="secondary"
        class="hm-hero__cta"
      >
        <Mail class="hm-hero__cta-icon" aria-hidden="true" />
      </Button>
    </div>

    {
      content.focusChips.length > 0 && (
        <div class="hm-hero__focus">
          <p class="hm-hero__focus-label">{content.focusAreasLabel}</p>
          <ul class="hm-hero__focus-list">
            {content.focusChips.map((chip) => (
              <li>
                <Chip label={chip} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
