---
/**
 * CA-03 — Integrated identity/graph hero. The semantic graph (HeroGraph)
 * lives inside this hero; Home pages no longer render a separate
 * relationship-graph section. No portal imagery on Home: the gateway alone
 * owns the portal (ADR-0008). Research-statement text is preserved as a
 * readable paragraph in the copy column.
 */
import Button from '../ui/Button.astro'
import Chip from '../ui/Chip.astro'
import HeroGraph from '../hero/HeroGraph.astro'
import { ArrowRight, FileText, Mail } from 'lucide-astro'
import type { HeroGraphModel } from '../../lib/hero-graph-content'
import {
  getHomeHeroContent,
  getHomeResearchContent,
} from '../../lib/home-content'
import { getProfileHeroCtaLabels } from '../../lib/page-family-empty-chrome'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  graph?: HeroGraphModel
  selectedId?: string | null
}

const { locale, selectedId = null } = Astro.props
const graph: HeroGraphModel = Astro.props.graph ?? {
  status: 'unavailable',
  locale,
}
const content = getHomeHeroContent(locale)
const research = getHomeResearchContent(locale)
const ctaLabels = getProfileHeroCtaLabels(locale)
---

<section
  class="hm-hero hm-hero--integrated"
  data-hero-layout="integrated"
  data-graph-status={graph.status}
>
  <div class="hm-hero__copy">
    <header class="hm-hero__lead">
      <p class="hm-hero__role">{content.role}</p>
      {
        locale === 'en' ? (
          <h1 class="hm-hero__name">
            <span class="hm-hero__name-primary">{content.namePrimary}</span>
            <span class="hm-hero__name-accent">{content.nameAccent}</span>
          </h1>
        ) : (
          <h1 class="hm-hero__name">{content.name}</h1>
        )
      }
      <p class="hm-hero__intro">{content.intro}</p>
    </header>

    <div class="hm-hero__actions">
      <Button
        label={ctaLabels.research}
        href={localePath(locale, 'research')}
        variant="primary"
        class="hm-hero__cta"
      >
        <ArrowRight class="hm-hero__cta-icon" aria-hidden="true" />
      </Button>
      <Button
        label={ctaLabels.cv}
        href={localePath(locale, 'cv')}
        variant="secondary"
        class="hm-hero__cta"
      >
        <FileText class="hm-hero__cta-icon" aria-hidden="true" />
      </Button>
      <Button
        label={ctaLabels.contact}
        href={localePath(locale, 'contact')}
        variant="secondary"
        class="hm-hero__cta"
      >
        <Mail class="hm-hero__cta-icon" aria-hidden="true" />
      </Button>
    </div>

    <p class="hm-hero__research">{research.lead}</p>

    {
      content.focusChips.length > 0 && (
        <div class="hm-hero__focus">
          <p class="hm-hero__focus-label">{content.focusAreasLabel}</p>
          <ul class="hm-hero__focus-list">
            {content.focusChips.map((chip) => (
              <li>
                <Chip label={chip} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="hm-hero__graph">
    <HeroGraph locale={locale} graph={graph} selectedId={selectedId} />
  </div>
</section>
