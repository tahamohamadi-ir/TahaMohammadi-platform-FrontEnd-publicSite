---
import { GATEWAY_ROLE_LINE, localePath, type Locale } from '../../lib/navigation';
import { getHomeHeroContent } from '../../lib/home-content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getHomeHeroContent(locale);

const researchHref = localePath(locale, 'research');
const cvHref = localePath(locale, 'cv');
const contactHref = localePath(locale, 'contact');
---

<section class="home-hero" aria-labelledby="home-hero-name">
  <div class="home-hero__inner">
    <header class="home-hero__header">
      <h1 id="home-hero-name" class="home-hero__name">
        {
          locale === 'en' ? (
            <>
              <span class="home-hero__name-primary">{content.namePrimary}</span>
              <span class="home-hero__name-accent">{content.nameAccent}</span>
            </>
          ) : (
            content.name
          )
        }
      </h1>
      <p class="home-hero__role">{GATEWAY_ROLE_LINE}</p>
      <p class="home-hero__intro">{content.intro}</p>
    </header>

    <div class="home-hero__actions">
      <a href={researchHref} class="home-hero__cta home-hero__cta--primary">
        {content.ctas.research}
      </a>
      <a href={cvHref} class="home-hero__cta home-hero__cta--secondary">
        {content.ctas.cv}
      </a>
      <a href={contactHref} class="home-hero__cta home-hero__cta--quiet">
        {content.ctas.contact}
      </a>
    </div>

    {
      content.focusChips.length > 0 && (
        <div class="home-hero__focus">
          <p class="home-hero__focus-label">{content.focusAreasLabel}</p>
          <ul class="home-hero__focus-list">
            {content.focusChips.map((chip) => (
              <li>
                <span class="home-hero__chip">{chip}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
