---
import PublicationRow from '../ui/PublicationRow.astro'
import Link from '../ui/Link.astro'
import { getHomePublicationsContent } from '../../lib/home-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const content = getHomePublicationsContent(locale)
const writingHref = localePath(locale, 'writing')
---

{
  content.items.length === 0 ? null : (
    <section class="hm-publications">
      <div class="hm-publications__inner">
        <header class="hm-publications__header">
          <div class="hm-section-heading">
            <h2
              id="hm-publications-title"
              class="hm-eyebrow hm-publications__title"
            >
              {content.title}
            </h2>
            <Link
              href={writingHref}
              label={content.viewAll}
              variant="standalone"
              showIcon
            />
          </div>
          <p class="hm-publications__note">{content.draftNote}</p>
        </header>

        <ul class="hm-publications__list">
          {content.items.map((item) => (
            <li>
              <PublicationRow
                typeLabel={content.manuscriptLabel}
                statusLabel={item.statusLabel}
                title={item.title}
                href={localePath(locale, `writing/${item.slug}`)}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
