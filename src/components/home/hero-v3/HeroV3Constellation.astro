---
import { projectConstellation } from '../../../lib/home-hero-v3'
import type {
  HeroGraphNode,
  HeroGraphEdge,
} from '../../../lib/hero-graph-content'
import { toScenePayload } from '../../../lib/visual/scene-contract'
import type { Locale } from '../../../lib/navigation'
import HeroV3LiveScript from './HeroV3LiveScript.astro'

interface Props {
  locale: Locale
  nodes: HeroGraphNode[]
  edges: HeroGraphEdge[]
  live?: boolean
}

const { locale, nodes, edges, live = false } = Astro.props
const FRAME = { width: 600, height: 520, padding: 96 }
const view = projectConstellation({ nodes, edges }, FRAME)
const label = locale === 'fa' ? 'منظومهٔ پژوهشی' : 'Research constellation'
const payload = live
  ? JSON.stringify(toScenePayload({ nodes, edges, locale }))
  : undefined
---

<figure
  class="hv3-const"
  aria-label={label}
  data-hv3-constellation
  data-hv3-live={live ? '' : undefined}
  data-hv3-payload={payload}
>
  <div class="hv3-const__stage">
    <svg
      class="hv3-const__poster"
      viewBox={`0 0 ${FRAME.width} ${FRAME.height}`}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <radialGradient id="hv3-core-glow">
          <stop
            offset="0%"
            stop-color="var(--hv3-role-brand)"
            stop-opacity="0.32"></stop>
          <stop
            offset="100%"
            stop-color="var(--hv3-role-brand)"
            stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <g class="hv3-const__rings">
        {
          view.rings.map((ring, index) => (
            <circle
              cx={FRAME.width / 2}
              cy={FRAME.height / 2}
              r={ring.r}
              class={
                index === view.rings.length - 1
                  ? 'hv3-const__ring hv3-const__ring--outer'
                  : 'hv3-const__ring'
              }
            />
          ))
        }
      </g>
      <g class="hv3-const__edges">
        {
          view.edges.map((edge, index) => {
            const target = view.nodes.find((node) => node.id === edge.target)
            return (
              <path
                d={edge.d}
                pathLength="1"
                class="hv3-const__edge"
                data-role={target?.colorRole}
                style={`--hv3-i:${index}`}
              />
            )
          })
        }
      </g>
      <g class="hv3-const__nodes">
        {
          view.nodes.map((node, index) =>
            node.core ? (
              <g class="hv3-const__core">
                <circle
                  cx={node.x}
                  cy={node.y}
                  r={node.r * 2.6}
                  fill="url(#hv3-core-glow)"
                />
                <circle
                  cx={node.x}
                  cy={node.y}
                  r={node.r}
                  class="hv3-const__core-ring"
                />
                <circle
                  cx={node.x}
                  cy={node.y}
                  r={node.r * 0.62}
                  class="hv3-const__core-inner"
                />
                <circle
                  cx={node.x}
                  cy={node.y}
                  r={node.r * 0.2}
                  class="hv3-const__core-dot"
                />
              </g>
            ) : (
              <g
                class="hv3-const__node"
                data-role={node.colorRole}
                style={`--hv3-i:${index}`}
              >
                <circle
                  cx={node.x}
                  cy={node.y}
                  r={node.r * 2}
                  class="hv3-const__halo"
                />
                <circle
                  cx={node.x}
                  cy={node.y}
                  r={node.r}
                  class="hv3-const__disc"
                />
                <circle
                  cx={node.x}
                  cy={node.y}
                  r={node.r * 0.42}
                  class="hv3-const__pip"
                />
              </g>
            ),
          )
        }
      </g>
    </svg>
    {live && <canvas class="hv3-const__canvas" aria-hidden="true" />}
    <ul class="hv3-const__labels">
      {
        view.nodes
          .filter((node) => !node.core)
          .map((node) => (
            <li
              class="hv3-const__label"
              data-node-id={node.id}
              data-side={node.side}
              data-role={node.colorRole}
              style={`left:${node.left}%;top:${node.top}%`}
            >
              {node.href ? (
                <a class="hv3-const__link" href={node.href}>
                  {node.label}
                </a>
              ) : (
                <span class="hv3-const__text">{node.label}</span>
              )}
            </li>
          ))
      }
    </ul>
  </div>
</figure>
{live && <HeroV3LiveScript />}
