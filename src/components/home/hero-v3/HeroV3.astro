---
import HeroV3Copy from './HeroV3Copy.astro'
import HeroV3Constellation from './HeroV3Constellation.astro'
import { loadHeroGraph } from '../../../lib/hero-graph-content'
import type { Locale } from '../../../lib/navigation'
import '../../../styles/hero-v3.css'

interface Props {
  locale: Locale
  showIdentity?: boolean
  showGraph?: boolean
}

const { locale, showIdentity = true, showGraph = true } = Astro.props
const graph = showGraph ? await loadHeroGraph(locale) : null
const ready = graph?.status === 'ready' && graph.nodes.length > 1 ? graph : null
---

<section
  class:list={['hv3', !ready && 'hv3--copy-only']}
  data-hero-v3
  data-hero-visual={ready ? 'constellation' : 'none'}
>
  <div class="hv3__atmosphere" aria-hidden="true"></div>
  {showIdentity && <HeroV3Copy locale={locale} showFocus={!ready} />}
  {
    ready && (
      <div class="hv3__visual">
        <HeroV3Constellation
          locale={locale}
          nodes={ready.nodes}
          edges={ready.edges}
          live
        />
      </div>
    )
  }
</section>
