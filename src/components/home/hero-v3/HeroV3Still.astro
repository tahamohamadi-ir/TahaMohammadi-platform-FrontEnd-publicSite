---
import { getImage } from 'astro:assets'
import { getPromotedMedia } from '../../../lib/media/promoted-media'
import type { HeroGraphNode } from '../../../lib/hero-graph-content'
import type { Locale } from '../../../lib/navigation'

interface Props {
  locale: Locale
  nodes: HeroGraphNode[]
}

const { locale, nodes } = Astro.props
const topics = nodes.filter((node) => node.type !== 'identity')
const DARK = '(prefers-color-scheme: dark)'

async function srcset(
  id: Parameters<typeof getPromotedMedia>[0],
  slot: Parameters<typeof getPromotedMedia>[1],
  widths: number[],
  format: 'avif' | 'webp',
) {
  const source = getPromotedMedia(id, slot).source
  const urls = await Promise.all(
    widths.map(async (width) => {
      const image = await getImage({
        src: source,
        width,
        format,
        quality: format === 'avif' ? 66 : 74,
      })
      return `${image.src} ${width}w`
    }),
  )
  return urls.join(', ')
}

const desktop = 'home.hero.sequence.desktop' as const
const mobile = 'home.hero.sequence.mobile' as const
const sources = [
  {
    media: `(min-width: 768px) and ${DARK}`,
    srcset: await srcset(
      'hero-v2-desktop-dark-04',
      desktop,
      [800, 1200],
      'avif',
    ),
    sizes: '(min-width: 1200px) 560px, 46vw',
  },
  {
    media: '(min-width: 768px)',
    srcset: await srcset(
      'hero-v2-desktop-light-04',
      desktop,
      [800, 1200],
      'avif',
    ),
    sizes: '(min-width: 1200px) 560px, 46vw',
  },
  {
    media: DARK,
    srcset: await srcset('hero-v2-mobile-dark-04', mobile, [400, 800], 'avif'),
    sizes: '92vw',
  },
  {
    media: undefined,
    srcset: await srcset('hero-v2-mobile-light-04', mobile, [400, 800], 'avif'),
    sizes: '92vw',
  },
]
const fallback = (
  await getImage({
    src: getPromotedMedia('hero-v2-desktop-light-04', desktop).source,
    width: 800,
    format: 'webp',
    quality: 74,
  })
).src
const legendLabel = locale === 'fa' ? 'حوزه‌های پژوهشی' : 'Research topics'
---

<figure class="hv3-still" data-hv3-still>
  <div class="hv3-still__art">
    <picture>
      {
        sources.map((source) => (
          <source
            type="image/avif"
            media={source.media}
            data-media={source.media}
            srcset={source.srcset}
            sizes={source.sizes}
          />
        ))
      }
      <img
        src={fallback}
        alt=""
        width="1600"
        height="1400"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hv3-still__image"
      />
    </picture>
  </div>
  {
    topics.length > 0 && (
      <ul class="hv3-still__legend" aria-label={legendLabel}>
        {topics.map((topic) => (
          <li class="hv3-still__item" data-role={topic.colorRole}>
            {topic.related[0] ? (
              <a href={topic.related[0].href} class="hv3-still__link">
                {topic.label}
              </a>
            ) : (
              <span>{topic.label}</span>
            )}
          </li>
        ))}
      </ul>
    )
  }
</figure>

<script>
  const DARK = '(prefers-color-scheme: dark)'

  function apply() {
    const theme = document.documentElement.dataset.theme
    for (const source of document.querySelectorAll<HTMLSourceElement>(
      '[data-hv3-still] source[data-media]',
    )) {
      const original = source.dataset.media ?? ''
      if (!original.includes(DARK)) continue
      if (theme === 'dark')
        source.media = original.replace(DARK, '(min-width: 0px)')
      else if (theme === 'light') source.media = 'not all'
      else source.media = original
    }
  }

  apply()
  window.addEventListener('tm-themechange', apply)
</script>
