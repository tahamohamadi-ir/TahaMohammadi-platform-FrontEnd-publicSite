---
import Link from './ui/Link.astro'
import { localePath, type Locale } from '../lib/navigation'
import {
  fetchLocalizedSiteSettings,
  fetchPublicSiteSettings,
} from '../lib/site-settings-content'
interface Props {
  locale: Locale
  hidePromo?: boolean
}
const { locale, hidePromo = true } = Astro.props
const [settings, operational] = await Promise.all([
  fetchLocalizedSiteSettings(locale),
  fetchPublicSiteSettings(),
])
const copy = settings?.contentCopy ?? {}
const contact = operational?.contact
const navItems = settings?.navLinks ?? []
const resources = settings?.audienceLinks ?? []
---

<footer class="site-footer" data-visual-id="Footer">
  {
    !hidePromo && copy['footer.cta'] && (
      <p class="site-footer__promo">{copy['footer.cta']}</p>
    )
  }
  <div class="site-footer__grid">
    <div class="site-footer__brand-block">
      {
        settings?.brandName && (
          <a href={localePath(locale)} class="site-footer__brand-link">
            <span class="site-footer__brand-name">{settings.brandName}</span>
          </a>
        )
      }
      {
        settings?.tagline && (
          <p class="site-footer__brand-role">{settings.tagline}</p>
        )
      }
      {
        settings?.footerText && (
          <p class="site-footer__brand-bio">{settings.footerText}</p>
        )
      }
    </div>
    {
      navItems.length > 0 && (
        <nav class="site-footer__nav" aria-label={copy['footer.explore']}>
          {copy['footer.explore'] && (
            <p class="site-footer__nav-title">{copy['footer.explore']}</p>
          )}
          <ul class="site-footer__nav-list">
            {navItems.map((item) => (
              <li>
                <Link href={item.href} label={item.label} variant="inline" />
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {
      resources.length > 0 && (
        <nav class="site-footer__nav" aria-label={copy['footer.resources']}>
          {copy['footer.resources'] && (
            <p class="site-footer__nav-title">{copy['footer.resources']}</p>
          )}
          <ul class="site-footer__nav-list">
            {resources.map((item) => (
              <li>
                <Link href={item.href} label={item.label} variant="inline" />
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {
      (contact?.email ||
        contact?.linkedin ||
        contact?.orcid ||
        contact?.location) && (
        <div class="site-footer__nav">
          {copy['footer.connect'] && (
            <p class="site-footer__nav-title">{copy['footer.connect']}</p>
          )}
          <ul class="site-footer__nav-list">
            {contact.email && (
              <li>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </li>
            )}
            {contact.linkedin && copy['footer.linkedin'] && (
              <li>
                <Link
                  href={contact.linkedin}
                  label={copy['footer.linkedin']}
                  variant="inline"
                />
              </li>
            )}
            {contact.orcid && copy['footer.orcid'] && (
              <li>
                <Link
                  href={contact.orcid}
                  label={copy['footer.orcid']}
                  variant="inline"
                />
              </li>
            )}
          </ul>
          {contact.location && (
            <p class="site-footer__contact-meta">{contact.location}</p>
          )}
        </div>
      )
    }
  </div>
  {
    copy['footer.legal'] && (
      <div class="site-footer__legal-row">
        <p class="site-footer__legal">{copy['footer.legal']}</p>
      </div>
    )
  }
</footer>
