---
import ContactCTA from './ui/ContactCTA.astro'
import Link from './ui/Link.astro'
import PromotedPicture from './media/PromotedPicture.astro'
import { Github, Linkedin, Mail } from 'lucide-astro'
import {
  GATEWAY_ROLE_LINE,
  localePath,
  footerResourceNav,
  primaryNav,
  shellCopy,
  type Locale,
} from '../lib/navigation'
import { getHomeHeroContent } from '../lib/home-content'
import { BRAND_MARK_ASSET_ID } from '../lib/media/promoted-media'

interface Props {
  locale: Locale
  /** Show optional footer promo band; default compact footer only (Phase 0). */
  hidePromo?: boolean
}

const { locale, hidePromo = true } = Astro.props
const homeHref = localePath(locale)
const contactHref = localePath(locale, 'contact')
const cvHref = localePath(locale, 'cv')
const heroContent = getHomeHeroContent(locale)
const brandNameDisplay =
  locale === 'en'
    ? shellCopy.brandName.en.toUpperCase()
    : shellCopy.brandName.fa
---

<footer class="site-footer" data-visual-id="Footer">
  {
    !hidePromo ? (
      <ContactCTA
        class="site-footer__promo"
        statement={shellCopy.footerCta[locale]}
        primaryHref={contactHref}
        primaryLabel={shellCopy.contact[locale]}
        cvHref={cvHref}
        cvLabel={shellCopy.cv[locale]}
      />
    ) : null
  }

  <div class="site-footer__grid">
    <div class="site-footer__brand-block">
      <a href={homeHref} class="site-footer__brand-link">
        <PromotedPicture
          assetId={BRAND_MARK_ASSET_ID}
          mediaSlot="brand.mark"
          locale={locale}
          alt=""
          imgClass="site-footer__mark"
        />
        <span class="site-footer__brand-name">{brandNameDisplay}</span>
      </a>
      <p class="site-footer__brand-role">{GATEWAY_ROLE_LINE}</p>
      <p class="site-footer__brand-bio">{heroContent.intro}</p>
      <ul
        class="site-footer__social"
        aria-label={shellCopy.footerConnect[locale]}
      >
        <li>
          <button
            type="button"
            class="site-footer__social-btn site-footer__social-btn--placeholder"
            disabled
            aria-disabled="true"
            aria-label={`${shellCopy.footerSocialGithub[locale]} — ${shellCopy.footerSocialPendingNote[locale]}`}
          >
            <Github size={18} aria-hidden="true" />
          </button>
        </li>
        <li>
          <button
            type="button"
            class="site-footer__social-btn site-footer__social-btn--placeholder"
            disabled
            aria-disabled="true"
            aria-label={`${shellCopy.footerSocialLinkedin[locale]} — ${shellCopy.footerSocialPendingNote[locale]}`}
          >
            <Linkedin size={18} aria-hidden="true" />
          </button>
        </li>
        <li>
          <a
            href={contactHref}
            class="site-footer__social-btn"
            aria-label={shellCopy.footerSocialEmail[locale]}
          >
            <Mail size={18} aria-hidden="true" />
          </a>
        </li>
      </ul>
    </div>

    <nav class="site-footer__nav" aria-label={shellCopy.footerExplore[locale]}>
      <p class="site-footer__nav-title">{shellCopy.footerExplore[locale]}</p>
      <ul class="site-footer__nav-list">
        {
          primaryNav.map((item) => (
            <li>
              <Link
                href={localePath(locale, item.pathSegment)}
                label={item.label[locale]}
                variant="inline"
              />
            </li>
          ))
        }
      </ul>
    </nav>

    <nav
      class="site-footer__nav"
      aria-label={shellCopy.footerResources[locale]}
    >
      <p class="site-footer__nav-title">{shellCopy.footerResources[locale]}</p>
      <ul class="site-footer__nav-list">
        {
          footerResourceNav.map((item) => (
            <li>
              <Link
                href={localePath(locale, item.pathSegment)}
                label={item.label[locale]}
                variant="inline"
              />
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="site-footer__nav" aria-label={shellCopy.footerConnect[locale]}>
      <p class="site-footer__nav-title">{shellCopy.footerConnect[locale]}</p>
      <ul class="site-footer__nav-list">
        <li>
          <Link
            href={contactHref}
            label={shellCopy.contact[locale]}
            variant="inline"
          />
        </li>
        <li>
          <Link href={cvHref} label={shellCopy.cv[locale]} variant="inline" />
        </li>
      </ul>
      <dl class="site-footer__contact-meta">
        <div class="site-footer__contact-meta-row">
          <dt>{shellCopy.footerSocialEmail[locale]}</dt>
          <dd>{shellCopy.footerContactEmailPlaceholder[locale]}</dd>
        </div>
        <div class="site-footer__contact-meta-row">
          <dt>{shellCopy.footerLocation[locale]}</dt>
          <dd>{shellCopy.footerContactLocationPlaceholder[locale]}</dd>
        </div>
      </dl>
    </nav>
  </div>

  <div class="site-footer__legal-row">
    <p class="site-footer__legal">
      {
        locale === 'fa'
          ? `© ${new Date().getFullYear()} ${shellCopy.brandName.fa}. All rights reserved.`
          : `© ${new Date().getFullYear()} ${shellCopy.brandName.en}. All rights reserved.`
      }
    </p>
    <PromotedPicture
      assetId={BRAND_MARK_ASSET_ID}
      mediaSlot="brand.mark"
      locale={locale}
      alt=""
      imgClass="site-footer__legal-mark"
      aria-hidden="true"
    />
  </div>
</footer>
