---
import GenericCollectionIndex, {
  type GenericCollectionItem,
} from '../generic-collection/GenericCollectionIndex.astro'
import {
  getTalksRouteTitle,
  getTalksUnavailableCopy,
  type TalksIndexModel,
} from '../../lib/talks-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: TalksIndexModel
}

const { locale, model } = Astro.props
const items: GenericCollectionItem[] =
  model.status === 'ready'
    ? model.talks.map((talk) => ({
        slug: talk.slug,
        title: talk.title,
        meta:
          [talk.speakers, talk.event_name, talk.event_date]
            .filter(Boolean)
            .join(' · ') || undefined,
      }))
    : []
---

<GenericCollectionIndex
  locale={locale}
  status={model.status}
  routeTitle={getTalksRouteTitle(locale)}
  summary={locale === 'en'
    ? 'Keynotes, invited lectures, conference sessions, and seminar presentations.'
    : 'سخنرانی‌های کلیدی، ارائه‌های همایشی و سمینارهای علمی.'}
  unavailableTitle={getTalksUnavailableCopy(locale).title}
  unavailableMessage={getTalksUnavailableCopy(locale).message}
  hrefBase={localePath(locale, 'talks')}
  items={items}
/>
