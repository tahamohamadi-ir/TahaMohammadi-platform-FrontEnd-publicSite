---
import { shellCopy, type Locale } from '../lib/navigation';
import { Monitor, Moon, Sun } from 'lucide-astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const themeLabel = shellCopy.themeToggle[locale];
---

<button
  type="button"
  class="theme-toggle theme-toggle--shell"
  data-theme-toggle
  data-theme-mode="system"
  aria-label={themeLabel}
  aria-pressed="false"
  title={themeLabel}
>
  <span class="theme-toggle__icon theme-toggle__icon--system" aria-hidden="true"><Monitor size={18} /></span>
  <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true"><Sun size={18} /></span>
  <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true"><Moon size={18} /></span>
</button>
