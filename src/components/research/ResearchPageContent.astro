---
import CollectionIndexTemplate from '../templates/CollectionIndexTemplate.astro'
import PageFamilyIndexHero from '../page-family/PageFamilyIndexHero.astro'
import PageFamilySubNavShell from '../page-family/PageFamilySubNavShell.astro'
import PageFamilyConstellationShell from '../page-family/PageFamilyConstellationShell.astro'
import PageFamilyResearchFitShell from '../page-family/PageFamilyResearchFitShell.astro'
import PageFamilyResearchDirectionsShell from '../page-family/PageFamilyResearchDirectionsShell.astro'
import PageFamilySelectedPublicationsShell from '../page-family/PageFamilySelectedPublicationsShell.astro'
import PageFamilyCollaborateBandShell from '../page-family/PageFamilyCollaborateBandShell.astro'
import ContentState from '../state/ContentState.astro'
import Link from '../ui/Link.astro'
import {
  getGatewayRoleLine,
  getCmsPlaceholderCopy,
  getResearchSubNavLabels,
} from '../../lib/page-family-empty-chrome'
import {
  getResearchEmptyTopicsCopy,
  getResearchRouteTitle,
  getResearchUnavailableCopy,
  splitBodyParagraphs,
  type ResearchIndexModel,
} from '../../lib/research-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: ResearchIndexModel
}

const { locale, model } = Astro.props
const routeTitle = getResearchRouteTitle(locale)
const emptyCopy = getResearchUnavailableCopy(locale)
const roleLine = getGatewayRoleLine(locale)
const cmsPlaceholder = getCmsPlaceholderCopy(locale)
const subNavLabels = getResearchSubNavLabels(locale)
const tabRegion = locale === 'en' ? 'Research sections' : 'بخش‌های پژوهش'
---

{
  model.status === 'unavailable' ? (
    <CollectionIndexTemplate class="research-page research-page--empty">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="research"
        eyebrow={locale === 'en' ? 'Research profile' : 'پروفایل پژوهشی'}
        title={routeTitle}
        summary={cmsPlaceholder}
        roleLine={roleLine}
        atmosphere
      />

      <PageFamilySubNavShell
        slot="filters"
        locale={locale}
        labels={subNavLabels}
        regionLabel={tabRegion}
        activeIndex={0}
        class="research-page__tabs"
      />

      <div slot="records" class="research-page__sections pf-index-empty__shell">
        <section class="research-page__band research-page__band--constellation">
          <PageFamilyConstellationShell locale={locale} />
        </section>

        <section class="research-page__band research-page__band--fit">
          <PageFamilyResearchFitShell locale={locale} />
        </section>

        <section class="research-page__band research-page__band--directions">
          <PageFamilyResearchDirectionsShell locale={locale} />
        </section>

        <section class="research-page__band research-page__band--publications">
          <PageFamilySelectedPublicationsShell locale={locale} count={4} />
        </section>

        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title={emptyCopy.title}
          message={emptyCopy.message}
        />
      </div>

      <PageFamilyCollaborateBandShell
        slot="footer"
        locale={locale}
        context="research"
        variant="collaborate-only"
      />
    </CollectionIndexTemplate>
  ) : (
    <CollectionIndexTemplate class="research-page">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="research"
        eyebrow={locale === 'en' ? 'Research profile' : 'پروفایل پژوهشی'}
        title={routeTitle}
        summary={model.statement?.title ?? undefined}
        roleLine={roleLine}
        atmosphere
      />

      {model.statement ? (
        <section
          slot="records"
          class="research-page__statement research-page__band"
          aria-labelledby="research-statement-title"
        >
          <h2
            id="research-statement-title"
            class="research-page__section-title"
          >
            {model.statement.title}
          </h2>
          <div class="research-page__prose">
            {splitBodyParagraphs(model.statement.body).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      ) : null}

      {model.topics.length ? (
        <section
          slot="records"
          class="research-page__topics research-page__band"
          aria-labelledby="research-topics-title"
        >
          <h2 id="research-topics-title" class="research-page__section-title">
            {locale === 'en' ? 'Focus areas' : 'حوزه‌های تمرکز'}
          </h2>
          <ul class="research-page__list">
            {model.topics.map((topic) => (
              <li>
                <article class="research-page__card">
                  <h3 class="research-page__card-title">
                    <a
                      href={localePath(locale, `research/${topic.slug}`)}
                      class="research-page__card-link"
                    >
                      {topic.title}
                    </a>
                  </h3>
                  {topic.summary ? (
                    <p class="research-page__card-summary">{topic.summary}</p>
                  ) : null}
                </article>
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <ContentState
          slot="records"
          variant="empty"
          locale={locale}
          title={getResearchEmptyTopicsCopy(locale).title}
          message={getResearchEmptyTopicsCopy(locale).message}
        />
      )}

      {model.projects.length ? (
        <section
          slot="records"
          class="research-page__systems research-page__band"
          aria-labelledby="research-systems-title"
        >
          <h2 id="research-systems-title" class="research-page__section-title">
            {locale === 'en' ? 'Research systems' : 'سامانه‌های پژوهشی'}
          </h2>
          <ul class="research-page__list">
            {model.projects.map((project) => (
              <li>
                <article class="research-page__card">
                  <h3 class="research-page__card-title">
                    <Link
                      href={localePath(locale, `projects/${project.slug}`)}
                      label={project.title}
                      variant="standalone"
                    />
                  </h3>
                  {project.objective ? (
                    <p class="research-page__card-summary">
                      {project.objective}
                    </p>
                  ) : null}
                </article>
              </li>
            ))}
          </ul>
        </section>
      ) : null}
    </CollectionIndexTemplate>
  )
}
