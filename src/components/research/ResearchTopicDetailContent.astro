---
import LongFormDetailTemplate from '../templates/LongFormDetailTemplate.astro'
import SectionLead from '../ui/SectionLead.astro'
import ContentState from '../state/ContentState.astro'
import Link from '../ui/Link.astro'
import DetailToc from '../ui/DetailToc.astro'
import { ArrowRight } from 'lucide-astro'
import type { DetailTocItem } from '../../lib/article-outline'
import StoryDocument from '../story/StoryDocument.astro'
import { hasStoryContent } from '../../lib/story-content'
import { canonicalPath, type RouteFamily } from '../../lib/routes'
import {
  getResearchRouteTitle,
  getResearchUnavailableCopy,
  splitBodyParagraphs,
  type ResearchDetailModel,
} from '../../lib/research-content'
import { localePath, type Locale } from '../../lib/navigation'
import '../../styles/detail-layout.css'

interface Props {
  locale: Locale
  model: ResearchDetailModel
}

const { locale, model } = Astro.props
const researchHref = localePath(locale, 'research')

const topic =
  model.status === 'ready' && model.kind !== 'statement' ? model.record : null
const topicHasStory = Boolean(
  topic && 'story' in topic && topic.story && hasStoryContent(topic.story),
)
const topicSections = topic
  ? [
      {
        id: 'motivation',
        label: locale === 'en' ? 'Motivation' : 'انگیزه',
        value: topic.motivation,
      },
      {
        id: 'problems',
        label: locale === 'en' ? 'Problems' : 'مسائل',
        value: topic.problems,
      },
      {
        id: 'research-questions',
        label: locale === 'en' ? 'Research questions' : 'پرسش‌های پژوهشی',
        value: topic.research_questions,
      },
      {
        id: 'methods',
        label: locale === 'en' ? 'Methods' : 'روش‌ها',
        value: topic.methods,
      },
      {
        id: 'future-directions',
        label: locale === 'en' ? 'Future directions' : 'جهت‌های آینده',
        value: topic.future_directions,
      },
    ].filter((section) => section.value?.trim())
  : []
const toc: DetailTocItem[] = topicHasStory
  ? []
  : topicSections.map((section) => ({ id: section.id, text: section.label }))
---

{
  model.status === 'unavailable' ? (
    <div class="research-page research-page--unavailable">
      <ContentState
        variant="unavailable"
        locale={locale}
        headingLevel="h1"
        title={getResearchUnavailableCopy(locale).title}
        message={getResearchUnavailableCopy(locale).message}
        actionLabel={locale === 'en' ? 'Back to research' : 'بازگشت به پژوهش'}
        actionHref={researchHref}
      />
    </div>
  ) : model.kind === 'statement' ? (
    <LongFormDetailTemplate class="research-page research-page--detail">
      <SectionLead
        slot="lead"
        eyebrow={getResearchRouteTitle(locale)}
        title={model.record.title}
      />

      <div slot="body" class="research-page__prose detail-prose">
        {splitBodyParagraphs(model.record.body).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <p slot="related" class="research-page__back">
        <Link
          href={researchHref}
          label={locale === 'en' ? '← Back to research' : '← بازگشت به پژوهش'}
          variant="standalone"
        />
      </p>
    </LongFormDetailTemplate>
  ) : (
    <LongFormDetailTemplate class="research-page research-page--detail">
      <SectionLead
        slot="lead"
        eyebrow={getResearchRouteTitle(locale)}
        title={model.record.title}
        summary={model.record.summary}
      />

      <div slot="body">
        {'story' in model.record &&
        model.record.story &&
        hasStoryContent(model.record.story) ? (
          <StoryDocument story={model.record.story} locale={locale} />
        ) : (
          <div class="research-page__detail-sections">
            {topicSections.map((section) =>
              section.value?.trim() ? (
                <section
                  id={section.id}
                  class="research-page__section detail-section"
                  aria-labelledby={`${section.id}-title`}
                >
                  <h2
                    id={`${section.id}-title`}
                    class="research-page__section-title"
                  >
                    {section.label}
                  </h2>
                  <div class="research-page__prose detail-prose">
                    {splitBodyParagraphs(section.value).map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </section>
              ) : null,
            )}
          </div>
        )}
      </div>

      {toc.length >= 2 && <DetailToc slot="toc" locale={locale} items={toc} />}

      {model.record.projects?.length ||
      model.record.publications?.length ||
      ('relatedRecords' in model.record &&
        model.record.relatedRecords?.length) ? (
        <div slot="related" class="research-page__related detail-related">
          {model.record.projects?.length ? (
            <section aria-labelledby="related-projects-title">
              <h2
                id="related-projects-title"
                class="research-page__section-title"
              >
                {locale === 'en' ? 'Related projects' : 'پروژه‌های مرتبط'}
              </h2>
              <ul class="detail-cards">
                {model.record.projects.map((item) => (
                  <li>
                    <a
                      class="detail-card"
                      href={localePath(locale, `projects/${item.slug}`)}
                    >
                      <span>{item.title}</span>
                      <ArrowRight
                        class="detail-card__icon"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ) : null}
          {model.record.publications?.length ? (
            <section aria-labelledby="related-publications-title">
              <h2
                id="related-publications-title"
                class="research-page__section-title"
              >
                {locale === 'en' ? 'Related outputs' : 'خروجی‌های مرتبط'}
              </h2>
              <ul class="detail-cards">
                {model.record.publications.map((item) => (
                  <li>
                    <a
                      class="detail-card"
                      href={localePath(locale, `publications/${item.slug}`)}
                    >
                      <span>{item.title}</span>
                      <ArrowRight
                        class="detail-card__icon"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ) : null}
          {'relatedRecords' in model.record &&
          model.record.relatedRecords?.length ? (
            <section aria-labelledby="related-records-title">
              <h2
                id="related-records-title"
                class="research-page__section-title"
              >
                {locale === 'en' ? 'Related records' : 'رکوردهای مرتبط'}
              </h2>
              <ul class="detail-cards">
                {model.record.relatedRecords.map((ref) => {
                  const fam = ref.family || ref.routeFamily || ''
                  const familyKey = (
                    fam === 'projects'
                      ? 'project'
                      : fam === 'publications'
                        ? 'publication'
                        : fam === 'books'
                          ? 'book'
                          : fam === 'talks'
                            ? 'talk'
                            : fam === 'resources'
                              ? 'resource'
                              : fam === 'collections'
                                ? 'collection'
                                : fam
                  ) as RouteFamily
                  const href = canonicalPath(
                    familyKey,
                    locale,
                    ref.slug,
                    ref.courseSlug,
                  )
                  return (
                    <li>
                      <a class="detail-card" href={href}>
                        <span>{ref.title || `${ref.family} #${ref.id}`}</span>
                        <ArrowRight
                          class="detail-card__icon"
                          aria-hidden="true"
                        />
                      </a>
                    </li>
                  )
                })}
              </ul>
            </section>
          ) : null}
          <p class="research-page__back">
            <Link
              href={researchHref}
              label={
                locale === 'en' ? '← Back to research' : '← بازگشت به پژوهش'
              }
              variant="standalone"
            />
          </p>
        </div>
      ) : (
        <p slot="related" class="research-page__back">
          <Link
            href={researchHref}
            label={locale === 'en' ? '← Back to research' : '← بازگشت به پژوهش'}
            variant="standalone"
          />
        </p>
      )}
    </LongFormDetailTemplate>
  )
}
