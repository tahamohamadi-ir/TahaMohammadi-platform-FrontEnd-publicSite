---
import GenericCollectionIndex, {
  type GenericCollectionItem,
} from '../generic-collection/GenericCollectionIndex.astro'
import {
  getSeriesRouteTitle,
  getSeriesUnavailableCopy,
  type SeriesIndexModel,
} from '../../lib/series-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: SeriesIndexModel
}

const { locale, model } = Astro.props
const items: GenericCollectionItem[] =
  model.status === 'ready'
    ? model.series.map((item) => ({
        slug: item.slug,
        title: item.title,
        description: item.description,
      }))
    : []
---

<GenericCollectionIndex
  locale={locale}
  status={model.status}
  routeTitle={getSeriesRouteTitle(locale)}
  summary={locale === 'en'
    ? 'Structured article series and sequential reading paths.'
    : 'مجموعه مقالات منظم و مسیرهای مطالعه گام‌به‌گام.'}
  unavailableTitle={getSeriesUnavailableCopy(locale).title}
  unavailableMessage={getSeriesUnavailableCopy(locale).message}
  hrefBase={localePath(locale, 'blog/series')}
  items={items}
/>
