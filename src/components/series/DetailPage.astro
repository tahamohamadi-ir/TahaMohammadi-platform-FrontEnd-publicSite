---
import LongFormDetailTemplate from '../templates/LongFormDetailTemplate.astro'
import SectionLead from '../ui/SectionLead.astro'
import GenericCollectionUnavailable from '../generic-collection/GenericCollectionUnavailable.astro'
import Link from '../ui/Link.astro'
import StoryDocument from '../story/StoryDocument.astro'
import { hasStoryContent } from '../../lib/story-content'
import {
  getSeriesRouteTitle,
  getSeriesUnavailableCopy,
  type SeriesDetailModel,
} from '../../lib/series-content'
import { localePath, type Locale } from '../../lib/navigation'
import { canonicalPath, type RouteFamily } from '../../lib/routes'

interface Props {
  locale: Locale
  model: SeriesDetailModel
}

const { locale, model } = Astro.props
const blogHref = localePath(locale, 'blog')

function resolveArticleHref(item: {
  contentType?: string
  slug: string
  href?: string
}): string {
  if (item.href) return item.href
  try {
    return canonicalPath(
      (item.contentType || 'article') as RouteFamily,
      locale,
      item.slug,
    )
  } catch {
    return `${blogHref.replace(/\/$/, '')}/${item.slug}`
  }
}
---

{
  model.status === 'unavailable' ? (
    <GenericCollectionUnavailable
      locale={locale}
      title={getSeriesUnavailableCopy(locale).title}
      message={getSeriesUnavailableCopy(locale).message}
      backHref={blogHref}
      backLabel={locale === 'en' ? 'Back to blog' : 'بازگشت به وبلاگ'}
    />
  ) : (
    <LongFormDetailTemplate class="generic-collection generic-collection--detail">
      <SectionLead
        slot="lead"
        eyebrow={getSeriesRouteTitle(locale)}
        title={model.series.title}
        summary={model.series.description}
      />

      <div slot="body" class="generic-collection__detail">
        {hasStoryContent(model.series.story) ? (
          <div class="generic-collection__story">
            <StoryDocument story={model.series.story} locale={locale} />
          </div>
        ) : null}

        {model.series.items && model.series.items.length > 0 ? (
          <section
            class="generic-collection__items"
            aria-labelledby="series-parts-heading"
          >
            <h2
              id="series-parts-heading"
              class="generic-collection__items-heading"
            >
              {locale === 'en' ? 'Series Articles' : 'مقالات این مجموعه'}
            </h2>
            <ol class="generic-collection__items-list">
              {model.series.items.map((item, index) => {
                const articleHref = resolveArticleHref(item)
                return (
                  <li class="generic-collection__item-card">
                    <span class="generic-collection__item-number">
                      {locale === 'en'
                        ? `Part ${index + 1}`
                        : `بخش ${index + 1}`}
                    </span>
                    <h3 class="generic-collection__item-title">
                      <Link
                        href={articleHref}
                        label={item.title}
                        variant="standalone"
                      />
                    </h3>
                    {item.summary ? (
                      <p class="generic-collection__item-summary">
                        {item.summary}
                      </p>
                    ) : null}
                  </li>
                )
              })}
            </ol>
          </section>
        ) : null}
      </div>
    </LongFormDetailTemplate>
  )
}
