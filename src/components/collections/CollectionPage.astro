---
import GenericCollectionIndex, {
  type GenericCollectionItem,
} from '../generic-collection/GenericCollectionIndex.astro'
import {
  getCollectionsRouteTitle,
  getCollectionsUnavailableCopy,
  type CollectionsIndexModel,
} from '../../lib/collections-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: CollectionsIndexModel
}

const { locale, model } = Astro.props
const items: GenericCollectionItem[] =
  model.status === 'ready'
    ? model.collections.map((col) => ({
        slug: col.slug,
        title: col.title,
        meta:
          [col.curatorName, col.curatorTitle, col.curatedDate]
            .filter(Boolean)
            .join(' · ') || undefined,
        description: col.description,
      }))
    : []
---

<GenericCollectionIndex
  locale={locale}
  status={model.status}
  routeTitle={getCollectionsRouteTitle(locale)}
  summary={locale === 'en'
    ? 'Curated dossiers, thematic selections, and synthesized research packages.'
    : 'پرونده‌های پژوهشی گردآوری‌شده، گزیده‌های موضوعی و بسته‌های پژوهشی.'}
  unavailableTitle={getCollectionsUnavailableCopy(locale).title}
  unavailableMessage={getCollectionsUnavailableCopy(locale).message}
  hrefBase={localePath(locale, 'collections')}
  items={items}
/>
