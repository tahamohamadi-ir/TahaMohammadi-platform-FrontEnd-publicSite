---
import { getManagedCopy } from '../lib/site-settings-content'
import { type Locale } from '../lib/navigation'

interface Props {
  locale: Locale
  target?: string
}

const { locale, target = '#main-content' } = Astro.props
const copy = await getManagedCopy(locale)
---

{
  copy['skip.main'] && (
    <a href={target} class="skip-link" data-visual-id="SkipLink">
      {copy['skip.main']}
    </a>
  )
}
