---
import { getManagedCopy } from '../lib/site-settings-content'
import { shellCopy, type Locale } from '../lib/navigation'

interface Props {
  locale: Locale
  target?: string
}

const { locale, target = '#main-content' } = Astro.props
const copy = await getManagedCopy(locale)
const skipLabel = Object.hasOwn(copy, 'skip.main')
  ? copy['skip.main']
  : shellCopy.skipLink[locale]
---

{
  skipLabel && (
    <a href={target} class="skip-link" data-visual-id="SkipLink">
      {skipLabel}
    </a>
  )
}
