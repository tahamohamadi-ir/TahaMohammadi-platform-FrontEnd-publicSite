---
import { Picture } from 'astro:assets';

import type { Locale } from '../../lib/media/promoted-media';
import { getPromotedMedia, resolvePromotedMediaAlt } from '../../lib/media/promoted-media';
import type { MediaSlot } from '../../lib/media/promoted-media-registry';

interface Props {
  assetId: string;
  mediaSlot: MediaSlot;
  locale?: Locale;
  alt?: string;
  class?: string;
  imgClass?: string;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'auto' | 'high';
}

const {
  assetId,
  mediaSlot,
  locale = 'en',
  alt: consumerAlt,
  class: pictureClass,
  imgClass,
  loading,
  fetchPriority,
} = Astro.props;

const media = getPromotedMedia(assetId, mediaSlot);
const alt = resolvePromotedMediaAlt(assetId, mediaSlot, locale, consumerAlt);
const resolvedLoading = loading ?? media.transform.loading;
const resolvedFetchPriority = fetchPriority ?? media.transform.fetchPriority;
---

<Picture
  src={media.source}
  alt={alt}
  widths={[...media.transform.widths]}
  formats={[...media.transform.formats]}
  sizes={media.transform.sizes}
  fit={media.transform.fit}
  loading={resolvedLoading}
  fetchpriority={resolvedFetchPriority}
  class={imgClass}
  pictureAttributes={pictureClass ? { class: pictureClass } : undefined}
/>
