import { Picture } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';

import type { Locale } from '../../lib/media/promoted-media';
import { getPromotedMedia, getPromotedMediaAlt } from '../../lib/media/promoted-media';
import type { MediaSlot } from '../../lib/media/promoted-media-registry';

interface Props extends HTMLAttributes<'picture'> {
  assetId: string;
  slot: MediaSlot;
  locale?: Locale;
  class?: string;
  imgClass?: string;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'auto' | 'high';
}

const {
  assetId,
  slot,
  locale = 'en',
  class: pictureClass,
  imgClass,
  loading,
  fetchPriority,
  ...rest
} = Astro.props;

const media = getPromotedMedia(assetId, slot);
const alt = getPromotedMediaAlt(assetId, slot, locale);
const resolvedLoading = loading ?? media.transform.loading;
const resolvedFetchPriority = fetchPriority ?? media.transform.fetchPriority;
---

<Picture
  {...rest}
  class={pictureClass}
  src={media.source}
  alt={alt}
  widths={[...media.transform.widths]}
  formats={[...media.transform.formats]}
  sizes={media.transform.sizes}
  fit={media.transform.fit}
  loading={resolvedLoading}
  fetchpriority={resolvedFetchPriority}
  pictureAttributes={{ class: pictureClass }}
  imgAttributes={{ class: imgClass, decoding: 'async' }}
/>
