---
import type { HTMLAttributes } from 'astro/types';

import type { Locale } from '../../lib/media/promoted-media';
import { getPromotedMedia, getPromotedMediaAlt } from '../../lib/media/promoted-media';
import type { MediaSlot } from '../../lib/media/promoted-media-registry';

interface Props extends HTMLAttributes<'div'> {
  lightAssetId: string;
  darkAssetId: string;
  slot: MediaSlot;
  locale?: Locale;
  class?: string;
  imgClass?: string;
  decorative?: boolean;
}

const {
  lightAssetId,
  darkAssetId,
  slot,
  locale = 'en',
  class: wrapperClass,
  imgClass,
  decorative = true,
  ...rest
} = Astro.props;

const light = getPromotedMedia(lightAssetId, slot);
const dark = getPromotedMedia(darkAssetId, slot);
const alt = decorative ? '' : getPromotedMediaAlt(lightAssetId, slot, locale);

const lightSrc = typeof light.source.src === 'string' ? light.source.src : light.source.src.src;
const darkSrc = typeof dark.source.src === 'string' ? dark.source.src : dark.source.src.src;
---

<div
  {...rest}
  class:list={['theme-picture', wrapperClass]}
  data-theme-picture
  data-light-src={lightSrc}
  data-dark-src={darkSrc}
  data-light-width={light.intrinsic.width}
  data-light-height={light.intrinsic.height}
  data-dark-width={dark.intrinsic.width}
  data-dark-height={dark.intrinsic.height}
  data-loading={light.transform.loading}
  data-fetch-priority={light.transform.fetchPriority}
  aria-hidden={decorative ? 'true' : undefined}
>
  <img
    class:list={['theme-picture__img', imgClass]}
    data-theme-picture-target
    alt={alt}
    width={light.intrinsic.width}
    height={light.intrinsic.height}
    decoding="async"
    fetchpriority={light.transform.fetchPriority}
    loading={light.transform.loading}
  />
</div>

<script is:inline>
  (function mountThemePicture() {
    const resolveTheme = () => {
      const requested = document.documentElement.dataset.theme;
      if (requested === 'light' || requested === 'dark') return requested;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };

    const applyThemeToPicture = (root) => {
      const theme = resolveTheme();
      const src = theme === 'dark' ? root.dataset.darkSrc : root.dataset.lightSrc;
      const width = theme === 'dark' ? root.dataset.darkWidth : root.dataset.lightWidth;
      const height = theme === 'dark' ? root.dataset.darkHeight : root.dataset.lightHeight;
      const img = root.querySelector('[data-theme-picture-target]');
      if (!img || !src) return;
      if (img.getAttribute('src') !== src) {
        img.setAttribute('src', src);
        img.setAttribute('width', width);
        img.setAttribute('height', height);
      }
    };

    for (const root of document.querySelectorAll('[data-theme-picture]')) {
      applyThemeToPicture(root);
    }

    window.addEventListener('tm-themechange', () => {
      for (const root of document.querySelectorAll('[data-theme-picture]')) {
        applyThemeToPicture(root);
      }
    });
  })();
</script>

<style>
  .theme-picture {
    display: block;
    position: relative;
  }

  .theme-picture__img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
