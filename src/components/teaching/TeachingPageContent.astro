---
import EditorialIndexTemplate from '../templates/EditorialIndexTemplate.astro'
import PageFamilyIndexHero from '../page-family/PageFamilyIndexHero.astro'
import PageFamilyFeaturedPathShell from '../page-family/PageFamilyFeaturedPathShell.astro'
import PageFamilyListCardShell from '../page-family/PageFamilyListCardShell.astro'
import ContentState from '../state/ContentState.astro'
import {
  formatCourseCardMeta,
  formatTalkCardMeta,
  getTeachingRouteTitle,
  getTeachingUnavailableCopy,
  type TeachingIndexModel,
} from '../../lib/teaching-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: TeachingIndexModel
}

const { locale, model } = Astro.props
const emptyCopy = getTeachingUnavailableCopy(locale)
const filterLabels =
  locale === 'en'
    ? {
        region: 'Learning filters',
        allPaths: 'All',
        guides: 'Guides',
        tutorials: 'Tutorials',
        notes: 'Notes',
        paths: 'Reading paths',
        resources: 'Resources',
        search: 'Search learning…',
      }
    : {
        region: 'پالایش یادگیری',
        allPaths: 'همه',
        guides: 'راهنماها',
        tutorials: 'آموزش‌ها',
        notes: 'یادداشت‌ها',
        paths: 'مسیرهای مطالعه',
        resources: 'منابع',
        search: 'جستجوی یادگیری…',
      }
---

{
  model.status === 'unavailable' ? (
    <EditorialIndexTemplate class="teaching-page teaching-page--empty">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="teaching"
        eyebrow={locale === 'en' ? 'Courses & talks' : 'دوره‌ها و سخنرانی‌ها'}
        title={getTeachingRouteTitle(locale)}
      />

      <PageFamilyFeaturedPathShell
        slot="featured"
        locale={locale}
        family="teaching"
      />

      <div
        slot="filters"
        class="teaching-page__filters pf-index-empty__filters"
        role="group"
        aria-label={filterLabels.region}
        aria-disabled="true"
      >
        <p class="teaching-page__filters-active">{filterLabels.allPaths}</p>
        <div class="teaching-page__filters-controls">
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.guides}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.tutorials}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.notes}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.paths}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.resources}
          </button>
        </div>
        <input
          type="search"
          class="teaching-page__search pf-index-empty__search"
          placeholder={filterLabels.search}
          disabled
          aria-hidden="true"
          tabindex="-1"
        />
      </div>

      <div
        slot="records"
        class="teaching-page__grid-shell pf-index-empty__shell"
      >
        <PageFamilyListCardShell locale={locale} family="teaching" />
        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title={emptyCopy.title}
          message={emptyCopy.message}
        />
      </div>
    </EditorialIndexTemplate>
  ) : (
    <EditorialIndexTemplate class="teaching-page">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="teaching"
        eyebrow={locale === 'en' ? 'Courses & talks' : 'دوره‌ها و سخنرانی‌ها'}
        title={getTeachingRouteTitle(locale)}
      />

      <div slot="records" class="teaching-page__sections">
        {model.courses.length ? (
          <section
            class="teaching-page__section"
            aria-labelledby="teaching-courses-title"
          >
            <h2
              id="teaching-courses-title"
              class="teaching-page__section-title"
            >
              {locale === 'en' ? 'Courses' : 'دوره‌ها'}
            </h2>
            <ul class="teaching-page__list">
              {model.courses.map((course) => (
                <li>
                  <article class="teaching-page__card">
                    <h3 class="teaching-page__card-title">
                      <a
                        href={localePath(locale, `teaching/${course.slug}`)}
                        class="teaching-page__card-link"
                      >
                        {course.title}
                      </a>
                    </h3>
                    {course.description ? (
                      <p class="teaching-page__card-summary">
                        {course.description}
                      </p>
                    ) : null}
                    <p class="teaching-page__card-meta">
                      {formatCourseCardMeta(course)}
                    </p>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ) : null}

        {model.talks.length ? (
          <section
            class="teaching-page__section"
            aria-labelledby="teaching-talks-title"
          >
            <h2 id="teaching-talks-title" class="teaching-page__section-title">
              {locale === 'en' ? 'Talks' : 'سخنرانی‌ها'}
            </h2>
            <ul class="teaching-page__list">
              {model.talks.map((talk) => (
                <li>
                  <article class="teaching-page__card">
                    <h3 class="teaching-page__card-title">
                      <a
                        href={localePath(locale, `teaching/${talk.slug}`)}
                        class="teaching-page__card-link"
                      >
                        {talk.title}
                      </a>
                    </h3>
                    <p class="teaching-page__card-meta">
                      {formatTalkCardMeta(talk)}
                    </p>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ) : null}
      </div>
    </EditorialIndexTemplate>
  )
}
