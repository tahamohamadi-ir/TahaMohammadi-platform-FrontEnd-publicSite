---
import './template-base.css';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class={['tm-template tm-evidence-visual-detail-template', className].filter(Boolean).join(' ')}
  data-visual-id="EvidenceVisualDetailTemplate"
>
  <slot name="header" />

  <article class="tm-template__main">
    <slot name="breadcrumbs" />
    <header class="tm-evidence-visual-detail-template__h1-region">
      <slot name="lead" />
    </header>

    <div class="tm-template__detail-grid">
      <div class="tm-evidence-visual-detail-template__primary">
        <slot name="media-body" />
      </div>
      {
        Astro.slots.has('metadata') ? (
          <aside class="tm-template__section tm-template__section--optional">
            <slot name="metadata" />
          </aside>
        ) : null
      }
    </div>

    {
      Astro.slots.has('limitations') ? (
        <section class="tm-template__section tm-template__section--optional" aria-labelledby="evidence-limitations-region">
          <div id="evidence-limitations-region">
            <slot name="limitations" />
          </div>
        </section>
      ) : null
    }

    {
      Astro.slots.has('related') ? (
        <section class="tm-template__section tm-template__section--optional" aria-labelledby="evidence-related-region">
          <div id="evidence-related-region">
            <slot name="related" />
          </div>
        </section>
      ) : null
    }
  </article>

  <slot name="footer" />
</div>
