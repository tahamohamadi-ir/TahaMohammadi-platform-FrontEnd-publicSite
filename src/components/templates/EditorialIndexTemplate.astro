---
import './template-base.css'

interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<div
  class={['tm-template tm-editorial-index-template', className]
    .filter(Boolean)
    .join(' ')}
  data-visual-id="EditorialIndexTemplate"
>
  <slot name="header" />

  <div class="tm-template__main">
    <div class="tm-template__toolbar">
      <slot name="breadcrumbs" />
      <div class="tm-editorial-index-template__h1-region">
        <slot name="lead" />
      </div>
      {
        Astro.slots.has('featured') ? (
          <div class="tm-template__section tm-template__section--optional">
            <slot name="featured" />
          </div>
        ) : null
      }
      <slot name="filters" />
    </div>

    <div class="tm-template__records">
      <slot name="records" />
    </div>

    <slot name="pagination" />
  </div>

  <slot name="footer" />
</div>
