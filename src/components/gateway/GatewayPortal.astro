---
/**
 * PW-01 — Approved portal GLB shell (supersedes the CA-07 procedural arch).
 *
 * Decorative only (`aria-hidden`): brand, heading, and both language links
 * stay real HTML in `src/pages/index.astro` and navigate without waiting
 * for the scene. The approved `portal-centered-*` raster (ThemePicture)
 * remains the static fallback until the runtime canvas succeeds; with
 * JS disabled, WebGL unavailable, a failed GLB/texture fetch, context loss,
 * or a rejected import the fallback simply stays. Exactly one canvas per
 * route; the Home graph path is never imported here. Rendering stays on
 * demand (resize, theme, pointer pose, bounded entrance); offscreen slots
 * suspend it.
 */
import ThemePicture from '../media/ThemePicture.astro'
import { GATEWAY_ATMOSPHERE_ASSETS } from '../../lib/media/promoted-media'
---

<div
  class="gw__portal"
  data-gateway-portal
  data-gateway-state="idle"
  aria-hidden="true"
>
  <canvas
    class="gw__portal-canvas"
    data-gateway-canvas
    aria-hidden="true"
    hidden></canvas>
  <ThemePicture
    lightAssetId={GATEWAY_ATMOSPHERE_ASSETS.light}
    darkAssetId={GATEWAY_ATMOSPHERE_ASSETS.dark}
    mediaSlot="gateway.atmosphere"
    imgClass="gw__portal-img"
  />
</div>

<script>
  // PW-01 — Progressive portal enhancement. Semantic brand, heading, and
  // language links render first; the approved v1.3.1 GLB loads lazily and
  // yields to the raster fallback on any failure. Never imports the Home
  // graph path.
  import type { PortalSceneHandle } from '../../lib/visual/portal-scene'
  import type {
    GatewayEntryEvent,
    GatewayMotionHandle,
  } from '../../lib/visual/gateway-motion'
  import { scenePaletteFromCss } from '../../lib/visual/scene-contract'

  function readPalette() {
    const style = getComputedStyle(document.documentElement)
    return scenePaletteFromCss((name) => style.getPropertyValue(name).trim())
  }

  function motionPreference() {
    try {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'reduced'
        : 'full'
    } catch {
      return 'full'
    }
  }

  async function enhanceGatewayPortal() {
    const portal = document.querySelector<HTMLElement>('[data-gateway-portal]')
    if (!portal || portal.dataset.gatewayState === 'ready') return
    const canvas = portal.querySelector<HTMLCanvasElement>(
      'canvas[data-gateway-canvas]',
    )
    const fallback = portal.querySelector<HTMLElement>('[data-theme-picture]')
    if (!canvas) {
      portal.setAttribute('data-gateway-state', 'fallback')
      return
    }
    const setFallback = () => {
      portal.setAttribute('data-gateway-state', 'fallback')
      canvas.hidden = true
      if (fallback) fallback.style.opacity = ''
    }

    let scene: PortalSceneHandle | null = null
    let motion: GatewayMotionHandle | null = null
    const cleanups: Array<() => void> = []
    const linkCleanups: Array<() => void> = []
    let consecutiveSlowFrames = 0

    // PW-2 DOM ownership: real anchors with real hrefs, real focus order. The
    // enhancement intercepts activation only while the transition controller
    // is live; every other path (no JS, no WebGL, scene failure, modified
    // click, secondary activation) stays a native navigation.
    const page = document.querySelector<HTMLElement>('.gw')
    const nav = document.querySelector<HTMLElement>('.gw__nav')
    const languageLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.gw__nav a[href]'),
    )
    const themeToggle = document.querySelector<HTMLElement>(
      '[data-theme-toggle]',
    )
    let entryCommitted = false

    const onEntryState = (event: GatewayEntryEvent) => {
      portal.dataset.gatewayEntry = event.state
      if (page) {
        page.setAttribute('data-gateway-entry', event.state)
        page.setAttribute('data-gateway-program', event.program)
      }
      if (event.state === 'entering' || event.state === 'navigating') {
        // Observable entry evidence: 0 means the camera never flew (reduced
        // motion / instant program), otherwise it is the real travel in meters.
        portal.dataset.gatewayTravel = String(
          Math.round(scene?.entryDistance() ?? 0),
        )
      }
      if (event.state !== 'committed') return
      // Lock at commit: no second language, no mid-entry theme swap, and the
      // chosen link confirms itself before anything fades.
      entryCommitted = true
      nav?.setAttribute('aria-busy', 'true')
      if (themeToggle instanceof HTMLButtonElement) themeToggle.disabled = true
      themeToggle?.setAttribute('aria-disabled', 'true')
      for (const link of languageLinks) {
        if (link.getAttribute('href') === event.href) {
          link.setAttribute('data-gateway-selected', '')
        }
      }
    }

    const teardownScene = () => {
      try {
        motion?.dispose()
      } catch {
        /* workers already torn down */
      }
      try {
        scene?.dispose()
      } catch {
        /* workers already torn down */
      }
      motion = null
      scene = null
    }
    const teardownLinks = () => {
      for (const cleanup of linkCleanups.splice(0)) {
        try {
          cleanup()
        } catch {
          /* listeners are best-effort */
        }
      }
    }
    const enterFallback = () => {
      // A failure after commit must never strand the visitor on the gateway:
      // the controller navigates to the selected href first.
      try {
        motion?.failFast()
      } catch {
        /* navigation is best-effort here */
      }
      teardownLinks()
      teardownScene()
      setFallback()
    }

    try {
      const sceneModule = await import('../../lib/visual/portal-scene')
      scene = await sceneModule.createPortalScene({
        canvas,
        palette: readPalette(),
        motion: motionPreference(),
        onError: () => {
          enterFallback()
        },
      })
    } catch {
      setFallback()
      return
    }
    if (!scene || portal.dataset.gatewayState === 'fallback') {
      scene?.dispose()
      scene = null
      setFallback()
      return
    }

    const resize = () => {
      const width = portal.clientWidth
      const height = portal.clientHeight
      if (width <= 0 || height <= 0) return
      const started = typeof performance !== 'undefined' ? performance.now() : 0
      scene?.resize(width, height, window.devicePixelRatio || 1)
      if (started) {
        // Repeated long renders mean the 3D path is harmful on this device:
        // tear the scene down and keep the static fallback (same gate as the
        // Home hero enhancement).
        const elapsed = performance.now() - started
        consecutiveSlowFrames = elapsed > 50 ? consecutiveSlowFrames + 1 : 0
        if (consecutiveSlowFrames >= 5) enterFallback()
      }
    }

    const resizeObserver =
      typeof ResizeObserver !== 'undefined'
        ? new ResizeObserver(() => resize())
        : null
    resizeObserver?.observe(portal)
    if (resizeObserver) cleanups.push(() => resizeObserver.disconnect())

    // Offscreen/hidden: suspend on-demand rendering until the slot returns.
    const visibilityObserver =
      typeof IntersectionObserver !== 'undefined'
        ? new IntersectionObserver((entries) => {
            const visible = entries.some((entry) => entry.isIntersecting)
            if (!visible) consecutiveSlowFrames = 0
            scene?.setSuspended(!visible)
          })
        : null
    visibilityObserver?.observe(portal)
    if (visibilityObserver)
      cleanups.push(() => visibilityObserver.disconnect())

    const onThemeChange = () => {
      if (portal.dataset.gatewayState !== 'ready' || entryCommitted) return
      try {
        scene?.setPalette(readPalette())
      } catch {
        /* a failed re-tint must not clear the fallback */
      }
    }
    window.addEventListener('tm-themechange', onThemeChange)
    cleanups.push(() =>
      window.removeEventListener('tm-themechange', onThemeChange),
    )

    window.addEventListener(
      'pagehide',
      () => {
        for (const cleanup of cleanups.splice(0)) {
          try {
            cleanup()
          } catch {
            /* teardown best-effort */
          }
        }
        teardownLinks()
        delete (window as unknown as { __tmStallGatewayEntry?: () => void })
          .__tmStallGatewayEntry
        teardownScene()
      },
      { once: true },
    )

    // The first demand render happens in resize(). Keep its frame visible
    // while the motion module loads; motion must never own availability.
    // `ready` is not published here: it announces the entry enhancement, and
    // that does not exist until the controller and its listeners are wired.
    canvas.style.opacity = '1'
    canvas.hidden = false
    resize()

    try {
      const motionModule = await import('../../lib/visual/gateway-motion')
      const controller = motionModule.createGatewayMotion({
        scene,
        canvas,
        stage: portal,
        fallbackElement: fallback,
        motionPreference: motionPreference(),
        onEntryState,
      })
      motion = controller

      // Language anchors keep their real hrefs: activation is only intercepted
      // while the entry controller is live and willing to accept a commit.
      for (const link of languageLinks) {
        const preview = () => controller.previewStart()
        const leave = () => controller.previewEnd()
        const activate = (event: Event) => {
          if (!(event instanceof MouseEvent) || event.defaultPrevented) return
          if (event.button !== 0) return
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
            return
          if (portal.dataset.gatewayState !== 'ready') return
          if (entryCommitted) {
            // Only one activation can commit: the selected href wins.
            event.preventDefault()
            return
          }
          if (!controller.canIntercept()) return
          const href = link.getAttribute('href')
          if (!href) return
          event.preventDefault()
          controller.commit(href)
        }
        link.addEventListener('pointerenter', preview)
        link.addEventListener('focus', preview)
        link.addEventListener('pointerleave', leave)
        link.addEventListener('blur', leave)
        link.addEventListener('click', activate)
        linkCleanups.push(() => {
          link.removeEventListener('pointerenter', preview)
          link.removeEventListener('focus', preview)
          link.removeEventListener('pointerleave', leave)
          link.removeEventListener('blur', leave)
          link.removeEventListener('click', activate)
        })
      }

      // Explicit seam for the e2e coverage of the stalled-entry failsafe: it
      // simulates a slow renderer and never navigates on its own. It is the one
      // failsafe without a real trigger path from a page script, so it stays
      // for now — but as a non-enumerable, non-writable property (no page
      // script can swap it) that remains deletable for the pagehide teardown.
      Object.defineProperty(window, '__tmStallGatewayEntry', {
        value: () => controller.stallEntryForTest(),
        writable: false,
        enumerable: false,
        configurable: true,
      })

      // Fully wired: the entry enhancement is live from here on, so this is
      // the honest moment to advertise `ready`. An activation before it is a
      // plain native navigation, and a tripped frame budget stays `fallback`.
      if (portal.dataset.gatewayState !== 'fallback') {
        portal.setAttribute('data-gateway-state', 'ready')
      }

      await controller.playEntrance()
    } catch {
      teardownLinks()
      enterFallback()
    }
  }

  function scheduleGatewayPortal() {
    const idleWindow = window as unknown as {
      requestIdleCallback?: (
        callback: () => void,
        options?: { timeout: number },
      ) => number
    }
    if (typeof idleWindow.requestIdleCallback === 'function') {
      idleWindow.requestIdleCallback(
        () => {
          void enhanceGatewayPortal()
        },
        { timeout: 1500 },
      )
    } else {
      requestAnimationFrame(() =>
        window.setTimeout(() => {
          void enhanceGatewayPortal()
        }, 0),
      )
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleGatewayPortal, {
      once: true,
    })
  } else {
    scheduleGatewayPortal()
  }
</script>
