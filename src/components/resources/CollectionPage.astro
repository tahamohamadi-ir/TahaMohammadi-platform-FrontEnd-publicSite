---
import GenericCollectionIndex, {
  type GenericCollectionItem,
} from '../generic-collection/GenericCollectionIndex.astro'
import {
  getResourcesRouteTitle,
  getResourcesUnavailableCopy,
  type ResourcesIndexModel,
} from '../../lib/resources-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: ResourcesIndexModel
}

const { locale, model } = Astro.props
const items: GenericCollectionItem[] =
  model.status === 'ready'
    ? model.resources.map((resource) => ({
        slug: resource.slug,
        title: resource.title,
        description: resource.description,
      }))
    : []
---

<GenericCollectionIndex
  locale={locale}
  status={model.status}
  routeTitle={getResourcesRouteTitle(locale)}
  summary={locale === 'en'
    ? 'Open source tooling, datasets, research whitepapers, and archival downloads.'
    : 'ابزارهای متن‌باز، مجموعه‌داده‌ها، مقالات پژوهشی و پرونده‌های دانلودی.'}
  unavailableTitle={getResourcesUnavailableCopy(locale).title}
  unavailableMessage={getResourcesUnavailableCopy(locale).message}
  hrefBase={localePath(locale, 'resources')}
  items={items}
/>
