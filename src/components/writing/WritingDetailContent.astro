---
import LongFormDetailTemplate from '../templates/LongFormDetailTemplate.astro'
import SectionLead from '../ui/SectionLead.astro'
import ContentState from '../state/ContentState.astro'
import Link from '../ui/Link.astro'
import StoryDocument from '../story/StoryDocument.astro'
import { hasStoryContent } from '../../lib/story-content'
import {
  formatPublishedDate,
  formatReadingTime,
  getWritingRouteTitle,
  getWritingUnavailableCopy,
  type ArticleNeighbor,
  type WritingDetailModel,
} from '../../lib/writing-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: WritingDetailModel
  previous?: ArticleNeighbor | null
  next?: ArticleNeighbor | null
}

const { locale, model, previous = null, next = null } = Astro.props
const writingHref = localePath(locale, 'blog')
---

{
  model.status === 'unavailable' ? (
    <div class="writing-page writing-page--unavailable">
      <ContentState
        variant="unavailable"
        locale={locale}
        headingLevel="h1"
        title={getWritingUnavailableCopy(locale).title}
        message={getWritingUnavailableCopy(locale).message}
        actionLabel={locale === 'en' ? 'Back to blog' : 'بازگشت به وبلاگ'}
        actionHref={writingHref}
      />
    </div>
  ) : (
    <LongFormDetailTemplate class="writing-page writing-page--detail">
      <SectionLead
        slot="lead"
        eyebrow={getWritingRouteTitle(locale)}
        title={model.article.title}
        summary={model.article.excerpt}
      />

      <div slot="body" class="writing-page__detail">
        {model.article.featured_image?.url ? (
          <figure class="writing-page__figure">
            <img
              src={model.article.featured_image.url}
              alt={model.article.featured_image.alt || ''}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ) : null}

        <dl class="writing-page__meta">
          {formatPublishedDate(locale, model.article.published_at) ? (
            <>
              <dt>{locale === 'en' ? 'Published' : 'انتشار'}</dt>
              <dd>
                <time datetime={model.article.published_at ?? undefined}>
                  {formatPublishedDate(locale, model.article.published_at)}
                </time>
              </dd>
            </>
          ) : null}
          {formatReadingTime(locale, model.article.reading_time_minutes) ? (
            <>
              <dt>{locale === 'en' ? 'Reading time' : 'زمان مطالعه'}</dt>
              <dd>
                {formatReadingTime(locale, model.article.reading_time_minutes)}
              </dd>
            </>
          ) : null}
          {model.article.license ? (
            <>
              <dt>{locale === 'en' ? 'License' : 'مجوز'}</dt>
              <dd>{model.article.license}</dd>
            </>
          ) : null}
          {model.article.series?.length ? (
            <>
              <dt>{locale === 'en' ? 'Series' : 'مجموعه'}</dt>
              <dd>
                {model.article.series.map((item) => (
                  <a href={localePath(locale, `blog/series/${item.slug}`)}>
                    {item.title}
                  </a>
                ))}
              </dd>
            </>
          ) : null}
          {model.article.accessibility_notes?.trim() ? (
            <>
              <dt>{locale === 'en' ? 'Accessibility' : 'دسترسی'}</dt>
              <dd>{model.article.accessibility_notes}</dd>
            </>
          ) : null}
        </dl>

        {model.article.topic_tags?.length ? (
          <ul
            class="writing-page__tags"
            aria-label={locale === 'en' ? 'Topics' : 'موضوعات'}
          >
            {model.article.topic_tags.map((tag) => (
              <li class="writing-page__tag">{tag.name}</li>
            ))}
          </ul>
        ) : null}

        {'story' in model.article &&
        model.article.story &&
        hasStoryContent(model.article.story) ? (
          <StoryDocument story={model.article.story} locale={locale} />
        ) : model.article.body?.trim() ? (
          <div
            class="writing-page__prose writing-page__body-html"
            set:html={model.article.body}
          />
        ) : null}
      </div>

      <nav
        slot="related"
        class="writing-page__neighbors"
        aria-label={locale === 'en' ? 'More writing' : 'نوشته‌های دیگر'}
      >
        {previous ? (
          <a
            class="writing-page__neighbor"
            rel="prev"
            href={localePath(locale, `blog/${previous.slug}`)}
          >
            {locale === 'en' ? 'Previous' : 'قبلی'}: {previous.title}
          </a>
        ) : (
          <span />
        )}
        <Link
          href={writingHref}
          label={locale === 'en' ? 'Back to blog' : 'بازگشت به وبلاگ'}
          variant="standalone"
        />
        {next ? (
          <a
            class="writing-page__neighbor writing-page__neighbor--next"
            rel="next"
            href={localePath(locale, `blog/${next.slug}`)}
          >
            {locale === 'en' ? 'Next' : 'بعدی'}: {next.title}
          </a>
        ) : null}
      </nav>
    </LongFormDetailTemplate>
  )
}
