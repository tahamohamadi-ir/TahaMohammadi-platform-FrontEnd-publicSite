---
import EditorialIndexTemplate from '../templates/EditorialIndexTemplate.astro'
import PageFamilyIndexHero from '../page-family/PageFamilyIndexHero.astro'
import PageFamilyFeaturedShell from '../page-family/PageFamilyFeaturedShell.astro'
import PageFamilyContentRowPlaceholder from '../page-family/PageFamilyContentRowPlaceholder.astro'
import ContentState from '../state/ContentState.astro'
import {
  formatArticleCardMeta,
  formatBookCardMeta,
  getWritingRouteTitle,
  getWritingUnavailableCopy,
  type WritingIndexModel,
} from '../../lib/writing-content'
import { localePath, type Locale } from '../../lib/navigation'

interface Props {
  locale: Locale
  model: WritingIndexModel
}

const { locale, model } = Astro.props
const emptyCopy = getWritingUnavailableCopy(locale)
const filterLabels =
  locale === 'en'
    ? {
        region: 'Writing filters',
        allWriting: 'All',
        essays: 'Essays',
        notes: 'Notes',
        memories: 'Memories',
        society: 'Society',
        archive: 'Archive',
        search: 'Search writing…',
      }
    : {
        region: 'پالایش نوشته‌ها',
        allWriting: 'همه',
        essays: 'مقالات',
        notes: 'یادداشت‌ها',
        memories: 'خاطرات',
        society: 'جامعه',
        archive: 'آرشیو',
        search: 'جستجوی نوشته‌ها…',
      }
---

{
  model.status === 'unavailable' ? (
    <EditorialIndexTemplate class="writing-page writing-page--empty">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="writing"
        eyebrow={locale === 'en' ? 'Essays & books' : 'مقالات و کتاب‌ها'}
        title={getWritingRouteTitle(locale)}
      />

      <PageFamilyFeaturedShell
        slot="featured"
        locale={locale}
        family="writing"
      />

      <div
        slot="filters"
        class="writing-page__filters pf-index-empty__filters"
        role="group"
        aria-label={filterLabels.region}
        aria-disabled="true"
      >
        <p class="writing-page__filters-active">{filterLabels.allWriting}</p>
        <div class="writing-page__filters-controls">
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.essays}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.notes}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.memories}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.society}
          </button>
          <button type="button" class="pf-index-empty__filter-chip" disabled>
            {filterLabels.archive}
          </button>
        </div>
        <input
          type="search"
          class="writing-page__search pf-index-empty__search"
          placeholder={filterLabels.search}
          disabled
          aria-hidden="true"
          tabindex="-1"
        />
      </div>

      <div
        slot="records"
        class="writing-page__grid-shell pf-index-empty__shell"
      >
        <PageFamilyContentRowPlaceholder locale={locale} family="writing" />
        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title={emptyCopy.title}
          message={emptyCopy.message}
        />
      </div>
    </EditorialIndexTemplate>
  ) : (
    <EditorialIndexTemplate class="writing-page">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="writing"
        eyebrow={locale === 'en' ? 'Essays & books' : 'مقالات و کتاب‌ها'}
        title={getWritingRouteTitle(locale)}
      />

      <div slot="records" class="writing-page__sections">
        {model.books.length ? (
          <section
            class="writing-page__section"
            aria-labelledby="writing-books-title"
          >
            <h2 id="writing-books-title" class="writing-page__section-title">
              {locale === 'en' ? 'Books' : 'کتاب‌ها'}
            </h2>
            <ul class="writing-page__list">
              {model.books.map((book) => (
                <li>
                  <article class="writing-page__card">
                    <h3 class="writing-page__card-title">{book.title}</h3>
                    {book.isbn ? (
                      <p class="writing-page__card-isbn">ISBN {book.isbn}</p>
                    ) : null}
                    <p class="writing-page__card-meta">
                      {formatBookCardMeta(book)}
                    </p>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ) : null}

        {model.articles.length ? (
          <section
            class="writing-page__section"
            aria-labelledby="writing-articles-title"
          >
            <h2 id="writing-articles-title" class="writing-page__section-title">
              {locale === 'en' ? 'Articles' : 'مقالات'}
            </h2>
            <ul class="writing-page__list">
              {model.articles.map((article) => (
                <li>
                  <article class="writing-page__card">
                    <h3 class="writing-page__card-title">
                      <a
                        href={localePath(locale, `writing/${article.slug}`)}
                        class="writing-page__card-link"
                      >
                        {article.title}
                      </a>
                    </h3>
                    {article.excerpt ? (
                      <p class="writing-page__card-summary">
                        {article.excerpt}
                      </p>
                    ) : null}
                    <p class="writing-page__card-meta">
                      {formatArticleCardMeta(locale, article)}
                    </p>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ) : null}
      </div>
    </EditorialIndexTemplate>
  )
}
