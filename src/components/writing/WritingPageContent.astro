---
import EditorialIndexTemplate from '../templates/EditorialIndexTemplate.astro'
import PageFamilyIndexHero from '../page-family/PageFamilyIndexHero.astro'
import PageFamilyCollaborateBandShell from '../page-family/PageFamilyCollaborateBandShell.astro'
import ContentState from '../state/ContentState.astro'
import {
  formatBookCardMeta,
  formatPublishedDate,
  formatReadingTime,
  getWritingRouteTitle,
  getWritingUnavailableCopy,
  type WritingIndexModel,
} from '../../lib/writing-content'
import {
  getPageFamilyHeroSummary,
  getWritingHeroEyebrow,
} from '../../lib/page-family-empty-chrome'
import { localePath, type Locale } from '../../lib/navigation'
import { canonicalPath } from '../../lib/routes'

interface Props {
  locale: Locale
  model: WritingIndexModel
}

const { locale, model } = Astro.props
const emptyCopy = getWritingUnavailableCopy(locale)
const readyCopy =
  locale === 'en'
    ? {
        search: 'Search writing',
        searchPlaceholder: 'Search title, excerpt, or series',
        allSeries: 'All series',
        empty: 'No writing matches this search.',
        previous: 'Previous',
        next: 'Next',
        pages: 'Writing pages',
      }
    : {
        search: 'جستجوی نوشته‌ها',
        searchPlaceholder: 'جستجوی عنوان، خلاصه یا مجموعه',
        allSeries: 'همهٔ مجموعه‌ها',
        empty: 'نوشته‌ای با این جستجو پیدا نشد.',
        previous: 'قبلی',
        next: 'بعدی',
        pages: 'صفحه‌های نوشتار',
      }
const seriesFilters =
  model.status === 'ready'
    ? [
        ...new Map(
          model.articles.flatMap((article) =>
            (article.series ?? []).map(
              (item) => [item.slug, item.title] as const,
            ),
          ),
        ).entries(),
      ].map(([slug, title]) => ({ slug, title }))
    : []
---

{
  model.status === 'unavailable' ? (
    <EditorialIndexTemplate class="writing-page writing-page--empty">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="writing"
        eyebrow={getWritingHeroEyebrow(locale)}
        title={getWritingRouteTitle(locale)}
        summary={getPageFamilyHeroSummary(locale, 'writing')}
      />
      <div slot="records">
        <ContentState
          variant="empty"
          locale={locale}
          headingLevel="h2"
          title={emptyCopy.title}
          message={emptyCopy.message}
        />
      </div>
      <PageFamilyCollaborateBandShell
        slot="footer"
        locale={locale}
        context="writing"
        variant="collaborate-only"
      />
    </EditorialIndexTemplate>
  ) : (
    <EditorialIndexTemplate class="writing-page">
      <PageFamilyIndexHero
        slot="lead"
        locale={locale}
        family="writing"
        eyebrow={getWritingHeroEyebrow(locale)}
        title={getWritingRouteTitle(locale)}
        summary={getPageFamilyHeroSummary(locale, 'writing')}
      />

      <div slot="records" class="writing-page__sections" data-blog-index>
        {model.articles.length ? (
          <div class="writing-page__controls">
            <label class="writing-page__search-label">
              {readyCopy.search}
              <input
                type="search"
                class="writing-page__search"
                placeholder={readyCopy.searchPlaceholder}
                data-blog-search
              />
            </label>
            {seriesFilters.length ? (
              <div
                class="writing-page__series-filters"
                role="group"
                aria-label={readyCopy.allSeries}
              >
                <button
                  type="button"
                  class="writing-page__series-filter"
                  data-blog-series-filter=""
                  aria-pressed="true"
                >
                  {readyCopy.allSeries}
                </button>
                {seriesFilters.map((item) => (
                  <button
                    type="button"
                    class="writing-page__series-filter"
                    data-blog-series-filter={item.slug}
                    aria-pressed="false"
                  >
                    {item.title}
                  </button>
                ))}
              </div>
            ) : null}
          </div>
        ) : null}
        {model.books.length ? (
          <section
            class="writing-page__section"
            aria-labelledby="writing-books-title"
          >
            <h2 id="writing-books-title" class="writing-page__section-title">
              {locale === 'en' ? 'Books' : 'کتاب‌ها'}
            </h2>
            <ul class="writing-page__list">
              {model.books.map((book) => (
                <li>
                  <article class="writing-page__card">
                    <h3 class="writing-page__card-title">
                      <a
                        href={canonicalPath('book', locale, book.slug)}
                        class="writing-page__card-link"
                      >
                        {book.title}
                      </a>
                    </h3>
                    {book.isbn ? (
                      <p class="writing-page__card-isbn">ISBN {book.isbn}</p>
                    ) : null}
                    <p class="writing-page__card-meta">
                      {formatBookCardMeta(book)}
                    </p>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ) : null}

        {model.articles.length ? (
          <section
            class="writing-page__section"
            aria-labelledby="writing-articles-title"
          >
            <h2 id="writing-articles-title" class="writing-page__section-title">
              {locale === 'en' ? 'Articles' : 'مقالات'}
            </h2>
            <ul class="writing-page__list">
              {model.articles.map((article) => (
                <li
                  data-blog-item
                  data-blog-text={[
                    article.title,
                    article.excerpt,
                    ...(article.series ?? []).map((item) => item.title),
                    ...(article.topic_tags ?? []).map((tag) => tag.name),
                  ]
                    .join(' ')
                    .toLocaleLowerCase()}
                  data-blog-series={(article.series ?? [])
                    .map((item) => item.slug)
                    .join(' ')}
                >
                  <article class="writing-page__card">
                    {article.featured_image?.url ? (
                      <img
                        class="writing-page__card-image"
                        src={article.featured_image.url}
                        alt={article.featured_image.alt || ''}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : null}
                    <h3 class="writing-page__card-title">
                      <a
                        href={localePath(locale, `blog/${article.slug}`)}
                        class="writing-page__card-link"
                      >
                        {article.title}
                      </a>
                    </h3>
                    {article.excerpt ? (
                      <p class="writing-page__card-summary">
                        {article.excerpt}
                      </p>
                    ) : null}
                    <p class="writing-page__card-meta">
                      {[
                        formatReadingTime(locale, article.reading_time_minutes),
                        formatPublishedDate(locale, article.published_at),
                      ]
                        .filter(Boolean)
                        .join(' · ')}
                    </p>
                    {article.series?.length ? (
                      <p class="writing-page__card-series">
                        {article.series.map((item) => (
                          <a
                            href={localePath(
                              locale,
                              `blog/series/${item.slug}`,
                            )}
                            class="writing-page__series-link"
                          >
                            {item.title}
                          </a>
                        ))}
                      </p>
                    ) : null}
                  </article>
                </li>
              ))}
            </ul>
            <p class="writing-page__none" data-blog-empty hidden>
              {readyCopy.empty}
            </p>
            <nav
              class="writing-page__pages"
              data-blog-pages
              aria-label={readyCopy.pages}
              hidden
            >
              <button type="button" data-blog-prev>
                {readyCopy.previous}
              </button>
              <span data-blog-page-status />
              <button type="button" data-blog-next>
                {readyCopy.next}
              </button>
            </nav>
          </section>
        ) : null}
      </div>
      <script src="../../scripts/blog-index.ts" />
    </EditorialIndexTemplate>
  )
}
