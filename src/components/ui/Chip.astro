---
interface Props {
  label: string
  variant?: 'neutral' | 'selected' | 'taxonomy'
  removable?: boolean
  removeLabel?: string
  class?: string
}

const {
  label,
  variant = 'neutral',
  removable = false,
  removeLabel = 'Remove',
  class: className = '',
} = Astro.props
---

<span
  class={['ui-chip', `ui-chip--${variant}`, className]
    .filter(Boolean)
    .join(' ')}
  data-visual-id="Chip"
>
  <span class="ui-chip__label">{label}</span>
  {
    removable ? (
      <button type="button" class="ui-chip__remove" aria-label={removeLabel}>
        ×
      </button>
    ) : null
  }
</span>

<style>
  .ui-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--layout-touch-target-min);
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface-muted);
    color: var(--color-ink);
    font-size: var(--font-size-sm);
  }

  .ui-chip--selected {
    background: var(--color-brand-soft);
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .ui-chip--taxonomy {
    background: var(--color-research-soft);
    border-color: var(--color-research);
    color: var(--color-research);
  }

  .ui-chip__remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    line-height: 1;
  }

  .ui-chip__remove:hover {
    background: var(--color-surface);
  }
</style>
