---
interface Props {
  label: string
  variant?: 'quiet' | 'outlined'
  disabled?: boolean
  type?: 'button' | 'submit' | 'reset'
  class?: string
}

const {
  label,
  variant = 'quiet',
  disabled = false,
  type = 'button',
  class: className = '',
} = Astro.props
---

<button
  type={type}
  class={['ui-icon-button', `ui-icon-button--${variant}`, className]
    .filter(Boolean)
    .join(' ')}
  data-visual-id="IconButton"
  aria-label={label}
  disabled={disabled}
>
  <span class="ui-icon-button__icon" aria-hidden="true">
    <slot />
  </span>
</button>

<style>
  .ui-icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--layout-touch-target-min);
    block-size: var(--layout-touch-target-min);
    padding: 0;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--motion-base) var(--motion-ease-out),
      border-color var(--motion-base) var(--motion-ease-out),
      color var(--motion-base) var(--motion-ease-out);
  }

  .ui-icon-button--outlined {
    border-color: var(--control-border);
    background: var(--color-surface);
  }

  .ui-icon-button--quiet:hover:not(:disabled),
  .ui-icon-button--outlined:hover:not(:disabled) {
    background: var(--color-brand-soft);
    color: var(--color-brand);
    border-color: var(--color-brand);
  }

  .ui-icon-button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .ui-icon-button__icon {
    display: inline-flex;
  }
</style>
