---
export interface PaginationPage {
  label: string
  href: string
  current?: boolean
}

interface Props {
  previousHref?: string
  previousLabel: string
  nextHref?: string
  nextLabel: string
  pages: PaginationPage[]
  summary?: string
  class?: string
}

const {
  previousHref,
  previousLabel,
  nextHref,
  nextLabel,
  pages,
  summary,
  class: className = '',
} = Astro.props
---

<nav
  class={['ui-pagination', className].filter(Boolean).join(' ')}
  data-visual-id="Pagination"
  aria-label={summary ?? 'Pagination'}
>
  <div class="ui-pagination__controls">
    {
      previousHref ? (
        <a href={previousHref} class="ui-pagination__control">
          {previousLabel}
        </a>
      ) : (
        <span
          class="ui-pagination__control ui-pagination__control--disabled"
          aria-disabled="true"
        >
          {previousLabel}
        </span>
      )
    }
    <ol class="ui-pagination__pages">
      {
        pages.map((page) => (
          <li>
            {page.current ? (
              <span
                class="ui-pagination__page ui-pagination__page--current"
                aria-current="page"
              >
                {page.label}
              </span>
            ) : (
              <a href={page.href} class="ui-pagination__page">
                {page.label}
              </a>
            )}
          </li>
        ))
      }
    </ol>
    {
      nextHref ? (
        <a href={nextHref} class="ui-pagination__control">
          {nextLabel}
        </a>
      ) : (
        <span
          class="ui-pagination__control ui-pagination__control--disabled"
          aria-disabled="true"
        >
          {nextLabel}
        </span>
      )
    }
  </div>
  {summary ? <p class="ui-pagination__summary">{summary}</p> : null}
</nav>

<style>
  .ui-pagination {
    display: grid;
    gap: var(--space-3);
  }

  .ui-pagination__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .ui-pagination__control,
  .ui-pagination__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--layout-touch-target-min);
    min-block-size: var(--layout-touch-target-min);
    padding-inline: var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface);
    color: var(--color-brand);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .ui-pagination__control:hover,
  .ui-pagination__page:hover {
    background: var(--color-brand-soft);
  }

  .ui-pagination__control--disabled {
    opacity: 0.45;
    color: var(--color-ink-tertiary);
    cursor: not-allowed;
  }

  .ui-pagination__pages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ui-pagination__page--current {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--button-foreground);
  }

  .ui-pagination__summary {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: var(--font-size-sm);
  }
</style>
