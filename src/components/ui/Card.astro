---
interface Props {
  typeLabel?: string;
  title: string;
  summary?: string;
  href?: string;
  actionLabel?: string;
  variant?: 'default' | 'research' | 'editorial' | 'visual';
  class?: string;
}

const {
  typeLabel,
  title,
  summary,
  href,
  actionLabel,
  variant = 'default',
  class: className = '',
} = Astro.props;
---

<article
  class={['ui-card', `ui-card--${variant}`, className].filter(Boolean).join(' ')}
  data-visual-id="Card"
>
  <div class="ui-card__media">
    <slot name="media" />
  </div>
  <div class="ui-card__body">
    {typeLabel ? <p class="ui-card__type">{typeLabel}</p> : null}
    <h2 class="ui-card__title">
      {href ? <a href={href}>{title}</a> : title}
    </h2>
    {summary ? <p class="ui-card__summary">{summary}</p> : null}
    <div class="ui-card__meta">
      <slot name="metadata" />
    </div>
    {
      href && actionLabel ? (
        <a href={href} class="ui-card__action">
          {actionLabel}
        </a>
      ) : null
    }
  </div>
</article>

<style>
  .ui-card {
    display: grid;
    gap: var(--space-4);
    padding: var(--layout-card-padding-min);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--card-background);
    color: var(--color-ink);
  }

  .ui-card--research {
    border-color: var(--color-research);
    background: linear-gradient(180deg, var(--color-research-soft), var(--card-background));
  }

  .ui-card--editorial {
    border-color: var(--color-signature);
  }

  .ui-card--visual {
    padding: 0;
    overflow: hidden;
  }

  .ui-card--visual .ui-card__body {
    padding: var(--space-4);
  }

  .ui-card__type {
    margin: 0;
    color: var(--color-brand);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ui-card__title {
    margin: 0;
    font-size: var(--font-size-xl);
    line-height: 1.3;
  }

  .ui-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .ui-card__title a:hover {
    color: var(--color-brand);
  }

  .ui-card__summary {
    margin: 0;
    color: var(--color-ink-secondary);
    line-height: 1.6;
  }

  .ui-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-ink-tertiary);
    font-size: var(--font-size-sm);
  }

  .ui-card__action {
    display: inline-flex;
    align-items: center;
    min-height: var(--layout-touch-target-min);
    color: var(--color-brand);
    font-weight: 600;
    text-decoration: none;
  }
</style>
