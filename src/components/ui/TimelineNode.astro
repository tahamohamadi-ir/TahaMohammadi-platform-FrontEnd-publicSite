---
import { Briefcase, GraduationCap, Waypoints } from 'lucide-astro'

interface Props {
  typeLabel?: string
  label: string
  period?: string
  summary?: string
  href?: string
  detailLabel?: string
  icon?: 'experience' | 'education' | 'milestone'
  class?: string
}

const {
  typeLabel,
  label,
  period,
  summary,
  href,
  detailLabel,
  icon = 'milestone',
  class: className = '',
} = Astro.props
---

<li
  class={['ui-timeline-node', className].filter(Boolean).join(' ')}
  data-visual-id="TimelineNode"
  data-kind={icon}
>
  <div class="ui-timeline-node__marker" aria-hidden="true">
    {
      icon === 'experience' ? (
        <Briefcase size={16} />
      ) : icon === 'education' ? (
        <GraduationCap size={16} />
      ) : (
        <Waypoints size={16} />
      )
    }
  </div>
  <div class="ui-timeline-node__content">
    {typeLabel ? <p class="ui-timeline-node__type">{typeLabel}</p> : null}
    <h3 class="ui-timeline-node__label">{label}</h3>
    {period ? <p class="ui-timeline-node__period">{period}</p> : null}
    {summary ? <p class="ui-timeline-node__summary">{summary}</p> : null}
    {
      href && detailLabel ? (
        <a href={href} class="ui-timeline-node__link">
          {detailLabel}
        </a>
      ) : null
    }
  </div>
</li>

<style>
  .ui-timeline-node {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    position: relative;
    padding-block-end: var(--space-6);
  }

  .ui-timeline-node::before {
    content: '';
    position: absolute;
    inset-block-start: 2.5rem;
    inset-block-end: 0.5rem;
    inset-inline-start: calc(1.125rem - 0.5px);
    inline-size: 1px;
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-brand) 45%, transparent) 0 4px,
      transparent 4px 9px
    );
  }

  .ui-timeline-node:last-child::before {
    display: none;
  }

  .ui-timeline-node__marker {
    inline-size: 2.25rem;
    block-size: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    color: var(--color-brand);
    border: 1px solid color-mix(in srgb, var(--color-brand) 22%, transparent);
  }

  .ui-timeline-node__type {
    margin: 0;
    color: var(--color-brand);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ui-timeline-node__label {
    margin: 0;
    font-size: var(--font-size-lg);
    line-height: 1.35;
  }

  .ui-timeline-node__period {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .ui-timeline-node__summary {
    margin: 0;
    color: var(--color-ink-secondary);
    line-height: 1.6;
  }

  .ui-timeline-node__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--layout-touch-target-min);
    color: var(--color-brand);
    font-weight: 600;
    text-decoration: none;
  }
</style>
