---
export interface MetadataEntry {
  label: string;
  value?: string;
  dir?: 'ltr' | 'rtl' | 'auto';
}

interface Props {
  items: MetadataEntry[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
const visibleItems = items.filter((item) => item.value);
---

<dl class={['ui-metadata-group', className].filter(Boolean).join(' ')} data-visual-id="MetadataGroup">
  {
    visibleItems.map((item) => (
      <div class="ui-metadata-group__row">
        <dt class="ui-metadata-group__label">{item.label}</dt>
        <dd class="ui-metadata-group__value">
          <bdi dir={item.dir}>{item.value}</bdi>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .ui-metadata-group {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .ui-metadata-group__row {
    display: grid;
    gap: var(--space-1);
  }

  @media (min-width: 768px) {
    .ui-metadata-group__row {
      grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr);
      gap: var(--space-4);
      align-items: start;
    }
  }

  .ui-metadata-group__label {
    margin: 0;
    color: var(--color-ink-tertiary);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ui-metadata-group__value {
    margin: 0;
    color: var(--color-ink);
    line-height: 1.6;
  }
</style>
